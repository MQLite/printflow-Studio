<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Pinned feed: nuget.org only. The production workstation is deliberately
       controlled; restore once, then build offline (Epic 11100 plan risk R14). -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
