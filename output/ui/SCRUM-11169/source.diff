+        {
+            Button confirm = Find<Button>(tree, "Session.PrintDimensions.ConfirmSize");
+            confirm.Visibility.ShouldBe(Visibility.Collapsed);
+            Button entry = Find<Button>(tree, "Session.PrintDimensions.CustomSize");
