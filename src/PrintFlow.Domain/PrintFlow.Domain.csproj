<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure domain types.

    HARD RULES (Epic 11100 plan §4.2, enforced by architecture tests):
      * No Windows UI dependency.
      * No file-system access, no SQL, no automation.
      * NO PackageReference and no ProjectReference of any kind.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PrintFlow.Domain</RootNamespace>
    <!--
      The whole shipped graph declares the RID the installer publishes for, not just the entry
      project. Restoring only PrintFlow.App for win-x64 left this project's lock file gaining and
      losing its win-x64 target section depending on whether the last build was the solution or
      the packaging one. RuntimeIdentifiers (plural) is a restore target list, so it changes no
      build output path here.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
