<Window x:Class="PrintFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PrintFlow.App.Views"
        xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--
            The whole navigation mechanism: a view model becomes its screen here, so no view
            model ever references a View type and no screen constructs another (Part 3C2 §16).
        -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WorkflowSelectionViewModel}">
            <views:WorkflowSelectionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
            <views:SessionScreenView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding Current}" />
</Window>
