<Window x:Class="PrintFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PrintFlow.App.Views"
        xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="PrintFlow.MainWindow"
        AutomationProperties.Name="{Binding Title}">

    <Window.Resources>
        <!--
            The whole navigation mechanism: a view model becomes its screen here, so no view
            model ever references a View type and no screen constructs another (Part 3C2 §16).
        -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WorkflowSelectionViewModel}">
            <views:WorkflowSelectionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
            <views:SessionScreenView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EnvironmentReadinessViewModel}">
            <views:EnvironmentReadinessView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <!--
        The screen host produces no automation element of its own — the screen it hosts is the
        element an assistive technology sees — so the identity that answers "where is the
        operator" lives on each view's own root instead.
    -->
    <ContentControl Content="{Binding Current}" />
</Window>
