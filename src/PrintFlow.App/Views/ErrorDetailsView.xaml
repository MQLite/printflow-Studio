<UserControl x:Class="PrintFlow.App.Views.ErrorDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:PrintFlow.App.Views"
             Background="{DynamicResource PF.Brush.Canvas}" Foreground="{DynamicResource PF.Brush.Ink}"
             FontFamily="{DynamicResource PF.Font.Family}" FontSize="{DynamicResource PF.Font.Body}"
             AutomationProperties.AutomationId="Screen.ErrorDetails"
             AutomationProperties.Name="{Binding Heading}">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PrintFlow.App;component/Themes/WpfUiTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:PreviewPayloadConverter x:Key="PreviewPayload" />
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="ReadOnlyValue" TargetType="TextBox" BasedOn="{StaticResource PF.Input.TextBox}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PF.Button.Secondary}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="{DynamicResource PF.Control.MinHeight}" />
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24">
      <Grid Visibility="{Binding IsErrorDetails, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <ui:SymbolIcon Symbol="Info24" Style="{StaticResource PF.Icon}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource PF.Font.Section}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,16"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ui:Card Style="{StaticResource PF.Card.Fluent}"><StackPanel>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource PF.Brush.Danger}"
                           AutomationProperties.AutomationId="ErrorDetails.Notice" />
                <!-- The notice's own code; the Code row below belongs to the opened attempt (SCRUM-11151). -->
                <views:NoticeErrorDetails Margin="0,4,0,0" />
                <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding WhatHappenedHeading}" Style="{StaticResource SectionHeading}" />
                    <TextBox Text="{Binding Description, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"
                             FontSize="16" AutomationProperties.AutomationId="ErrorDetails.Description"
                             AutomationProperties.Name="{Binding WhatHappenedHeading}" />
                    <TextBlock Text="{Binding CodeLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Code, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"
                             AutomationProperties.AutomationId="ErrorDetails.Code" AutomationProperties.Name="{Binding CodeLabel}" />
                    <TextBlock Text="{Binding HistoricalNotice}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ErrorDetails.HistoricalNotice" />

                    <TextBlock Text="{Binding ProcessingHeading}" Style="{StaticResource SectionHeading}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding WorkflowLabel}" Margin="0,0,16,6" />
                        <TextBlock Grid.Column="1" Text="{Binding Workflow}" TextWrapping="Wrap" AutomationProperties.AutomationId="ErrorDetails.Workflow" />
                        <TextBlock Grid.Row="1" Text="{Binding StepLabel}" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Step}" TextWrapping="Wrap" AutomationProperties.AutomationId="ErrorDetails.Step" />
                    </Grid>
                    <TextBlock Text="{Binding RetryInformation}" Margin="0,2,0,10" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ErrorDetails.RetryInformation" />
                    <TextBlock Text="{Binding InputLabel}" />
                    <TextBox Text="{Binding InputPath, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"
                             AutomationProperties.AutomationId="ErrorDetails.InputPath" AutomationProperties.Name="{Binding InputLabel}" />
                    <TextBlock Text="{Binding ExpectedOutputLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding ExpectedOutputPath, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"
                             AutomationProperties.AutomationId="ErrorDetails.ExpectedOutputPath" AutomationProperties.Name="{Binding ExpectedOutputLabel}" />

                    <TextBlock Text="{Binding EvidenceHeading}" Style="{StaticResource SectionHeading}" />
                    <Image Source="{Binding ScreenshotPayload, Converter={StaticResource PreviewPayload}}"
                           MaxHeight="240" Stretch="Uniform" HorizontalAlignment="Left"
                           Visibility="{Binding HasScreenshot, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="ErrorDetails.Screenshot" AutomationProperties.Name="{Binding EvidenceHeading}" />
                    <TextBlock Text="{Binding ScreenshotNotice}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ErrorDetails.ScreenshotStatus" />
                    <TextBlock Text="{Binding ScreenshotPathLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding ScreenshotPath, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"
                             AutomationProperties.AutomationId="ErrorDetails.ScreenshotPath" AutomationProperties.Name="{Binding ScreenshotPathLabel}" />

                    <Expander Header="{Binding TechnicalHeading}" Style="{StaticResource PF.Disclosure}" IsExpanded="False" Margin="0,16,0,0"
                              AutomationProperties.AutomationId="ErrorDetails.TechnicalDisclosure">
                        <TextBox Text="{Binding TechnicalDetail, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"
                             AutomationProperties.AutomationId="ErrorDetails.TechnicalDetail" AutomationProperties.Name="{Binding TechnicalHeading}" />
                    </Expander>
                </StackPanel>
            </StackPanel></ui:Card>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="True"><Button DockPanel.Dock="Left" Content="{Binding BackLabel}" Command="{Binding BackCommand}"
                    AutomationProperties.AutomationId="ErrorDetails.Back" AutomationProperties.Name="{Binding BackLabel}" /><WrapPanel HorizontalAlignment="Right">
            <Button Content="{Binding RetryLabel}" Command="{Binding RetryCommand}"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="ErrorDetails.Retry" AutomationProperties.Name="{Binding RetryLabel}" />
            <Button Content="{Binding ManualProcessingLabel}" Command="{Binding ManualProcessingCommand}"
                    Visibility="{Binding CanManualProcessing, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="ErrorDetails.ManualProcessing" AutomationProperties.Name="{Binding ManualProcessingLabel}" />
            <Button Content="{Binding ReenterAutomationLabel}" Command="{Binding ReenterAutomationCommand}"
                    Visibility="{Binding CanReenterAutomation, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="ErrorDetails.ReenterAutomation" AutomationProperties.Name="{Binding ReenterAutomationLabel}" />
            <Button Content="{Binding ExportDiagnosticPackageLabel}" Command="{Binding OpenDiagnosticPackageCommand}"
                    Visibility="{Binding CanExportDiagnosticPackage, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="ErrorDetails.ExportDiagnosticPackage"
                    AutomationProperties.Name="{Binding ExportDiagnosticPackageLabel}" />

        </WrapPanel></DockPanel>
      </Grid>

      <Grid Visibility="{Binding IsPackagePreview, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.AutomationId="Screen.DiagnosticPackage"
            AutomationProperties.Name="{Binding PackageHeading}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="{Binding PackageHeading}" FontSize="{DynamicResource PF.Font.Section}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PackageLocalOnlyNotice}" Margin="0,8,0,0" TextWrapping="Wrap"
                     FontWeight="SemiBold" AutomationProperties.AutomationId="DiagnosticPackage.LocalOnlyNotice" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,16"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      AutomationProperties.AutomationId="DiagnosticPackage.Contents">
          <ui:Card Style="{StaticResource PF.Card.Fluent}"><StackPanel>
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource PF.Brush.Danger}"
                       AutomationProperties.AutomationId="DiagnosticPackage.Notice" />

            <TextBlock Text="{Binding PackageSubjectHeading}" Style="{StaticResource SectionHeading}" />
            <Grid AutomationProperties.AutomationId="DiagnosticPackage.Subject">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{Binding PackageProcessingNameLabel}" Margin="0,0,16,6" />
              <TextBlock Grid.Column="1" Text="{Binding PackageProcessingName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="{Binding PackageWorkflowLabel}" Margin="0,0,16,6" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackageWorkflow}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="{Binding PackageStepLabel}" Margin="0,0,16,6" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PackageStep}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="{Binding PackageCodeLabel}" Margin="0,0,16,6" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PackageCode}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="{Binding PackageReferenceLabel}" Margin="0,0,16,6" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PackageReference, Mode=OneWay}"
                       Style="{StaticResource ReadOnlyValue}"
                       AutomationProperties.AutomationId="DiagnosticPackage.FailureReference"
                       AutomationProperties.Name="{Binding PackageReferenceLabel}" />
            </Grid>

            <TextBlock Text="{Binding PackageIncludedHeading}" Style="{StaticResource SectionHeading}" />
            <ItemsControl ItemsSource="{Binding IncludedPackageItems}" Focusable="False"
                          KeyboardNavigation.IsTabStop="False"
                          AutomationProperties.AutomationId="DiagnosticPackage.Included">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text, StringFormat=✓ {0}}" Margin="0,2" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding PackagePathsHeading}" Style="{StaticResource SectionHeading}" />
            <TextBox Text="{Binding PackagePathPreview, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"
                     AutomationProperties.AutomationId="DiagnosticPackage.LocalPaths"
                     AutomationProperties.Name="{Binding PackagePathsHeading}" />

            <StackPanel Visibility="{Binding HasUnavailablePackageItems, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding PackageUnavailableHeading}" Style="{StaticResource SectionHeading}" />
              <ItemsControl ItemsSource="{Binding UnavailablePackageItems}" Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            AutomationProperties.AutomationId="DiagnosticPackage.Unavailable">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text, StringFormat=— {0}}" Margin="0,2" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding HasExcludedPackageItems, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding PackageExcludedHeading}" Style="{StaticResource SectionHeading}" />
              <ItemsControl ItemsSource="{Binding ExcludedPackageItems}" Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            AutomationProperties.AutomationId="DiagnosticPackage.ExcludedByPolicy">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text, StringFormat=— {0}}" Margin="0,2" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding PackageDestinationHeading}" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="{Binding PackageDestinationHint}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="DiagnosticPackage.Destination" />
            <TextBlock Text="{Binding PackageNoOverwriteNotice}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel></ui:Card>
        </ScrollViewer>

        <DockPanel Grid.Row="2" LastChildFill="True"><Button DockPanel.Dock="Left" Content="{Binding BackToDetailsLabel}" Command="{Binding BackFromPackageCommand}"
                  AutomationProperties.AutomationId="DiagnosticPackage.Back"
                  AutomationProperties.Name="{Binding BackToDetailsLabel}" /><WrapPanel HorizontalAlignment="Right">
          <Button Content="{Binding SavePackageLabel}" Command="{Binding SavePackageCommand}"
                  AutomationProperties.AutomationId="DiagnosticPackage.Save"
                  AutomationProperties.Name="{Binding SavePackageLabel}" />

        </WrapPanel></DockPanel>
      </Grid>
    </Grid>
</UserControl>
