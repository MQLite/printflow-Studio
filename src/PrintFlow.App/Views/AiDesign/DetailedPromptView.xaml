<UserControl x:Class="PrintFlow.App.Views.AiDesign.DetailedPromptView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:r="clr-namespace:PrintFlow.App.Views.AiDesign" xmlns:controls="clr-namespace:PrintFlow.App.Controls"
 xmlns:views="clr-namespace:PrintFlow.App.Views">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PrintFlow.App;component/Themes/WpfUiTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/><views:PreviewPayloadConverter x:Key="Preview"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,4,6,4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#C4D9D4"/><Setter Property="Background" Value="{DynamicResource PF.Brush.Canvas}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="18"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid IsEnabled="{Binding CanEdit}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2.3*" MinWidth="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2.7*" MinWidth="300"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding DetailedSteps}"><ItemsControl.ItemTemplate><DataTemplate>
    <Button Command="{Binding DataContext.SelectDetailedStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
     <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer></Border>
  <Border Grid.Column="2" Style="{StaticResource Panel}"><DockPanel>
   <Button DockPanel.Dock="Bottom" Content="{x:Static r:AiDetailedLabels.Next}" Command="{Binding NextDetailedStepCommand}"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolVisibility}}">
     <TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiDetailedLabels.Step1}"/>
     <TextBlock Text="{Binding Draft.TemplateSnapshot.Name}" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="{x:Static r:AiDetailedLabels.ModeNotice}" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Templates}"><ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Content.Name}"/></Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolVisibility}}">
     <TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiDetailedLabels.Step2}"/>
     <TextBlock Text="{x:Static r:AiDetailedLabels.ReferencesNotice}" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Photos}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Panel}" Margin="0,0,0,10" Padding="8"><StackPanel>
       <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/><Image Source="{Binding Preview.Payload, Converter={StaticResource Preview}}" Height="100" Stretch="Uniform" AutomationProperties.Name="{Binding Role}"/>
       <TextBlock Text="{Binding FileName}"/><TextBlock Text="{Binding PreviewError}" Foreground="#B42318"/>
       <Button Content="{x:Static r:AiPromptLabels.AiPrompt_ChoosePhoto}" Command="{Binding DataContext.PickSlotImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SlotId}" AutomationProperties.Name="{Binding Role}"/>
       <WrapPanel><Button Content="{x:Static r:AiPromptLabels.AiPrompt_Expand}" Command="{Binding DataContext.ExpandPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="{x:Static r:AiPromptLabels.AiPrompt_RemovePhoto}" Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></WrapPanel>
       <ComboBox ItemsSource="{Binding AvailableAssets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="UploadName" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_Reuse}"/>
       <Button Content="{x:Static r:AiPromptLabels.AiPrompt_Reuse}" Command="{Binding DataContext.ReusePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_ReferenceRole}"/><TextBox Text="{Binding ReferenceRole, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_ReferenceRole}"/>
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_AddReference}" Command="{Binding AddReferenceCommand}"/>
    </StackPanel>
    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolVisibility}}">
     <TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiDetailedLabels.Step3}"/><TextBlock Text="{x:Static r:AiDetailedLabels.PreserveNotice}" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding PreservationChecks}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Panel}" Margin="0,0,0,10" Padding="8"><StackPanel>
       <TextBlock Text="{Binding Roles}" FontWeight="SemiBold"/><Image Source="{Binding Photo.Preview.Payload, Converter={StaticResource Preview}}" Height="100" Stretch="Uniform"/>
       <TextBlock Text="{Binding Asset.UploadName}"/><Button Content="{x:Static r:AiPromptLabels.AiPrompt_Expand}" Command="{Binding DataContext.ExpandPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Photo}"/>
       <CheckBox Style="{StaticResource PF.Input.CheckBox}" Content="{x:Static r:AiDetailedLabels.Keep}" IsChecked="{Binding KeepContent}" Margin="0,4"/><CheckBox Style="{StaticResource PF.Input.CheckBox}" Content="{x:Static r:AiDetailedLabels.Move}" IsChecked="{Binding AllowMove}" Margin="0,4"/>
       <CheckBox Style="{StaticResource PF.Input.CheckBox}" Content="{x:Static r:AiDetailedLabels.Scale}" IsChecked="{Binding AllowUniformScale}" Margin="0,4"/><CheckBox Style="{StaticResource PF.Input.CheckBox}" Content="{x:Static r:AiDetailedLabels.Crop}" IsChecked="{Binding AllowCrop}" Margin="0,4"/>
       <CheckBox Style="{StaticResource PF.Input.CheckBox}" Content="{x:Static r:AiDetailedLabels.Redraw}" IsChecked="{Binding AllowRedraw}" Margin="0,4"/><TextBlock Text="{x:Static r:AiDetailedLabels.RedrawNotice}" FontSize="12" Margin="0,4"/>
       <TextBlock Text="{Binding Status}" Foreground="#875800"/>
       <Button IsEnabled="{Binding CanConfirm}" Command="{Binding DataContext.ConfirmPreservationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><TextBlock Text="{x:Static r:AiDetailedLabels.ConfirmPreservation}"/></Button>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolVisibility}}">
     <TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiDetailedLabels.Step4}"/><TextBlock Text="{x:Static r:AiDetailedLabels.TextPreviewNotice}" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding TextChecks}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Panel}" Margin="0,0,0,10" Padding="8"><StackPanel>
       <TextBlock Text="{Binding Input.Label}" FontWeight="SemiBold"/><TextBlock Text="{x:Static r:AiDetailedLabels.SavedInput}" FontSize="12" Margin="0,8,0,2"/>
       <TextBlock Text="{Binding OriginalValue}" FontSize="18"/><TextBlock Text="{x:Static r:AiDetailedLabels.ProposedText}" FontSize="12" Margin="0,8,0,0"/>
       <TextBox Text="{Binding Input.Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" FontSize="20" MaxHeight="130" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Input.Label}" AutomationProperties.AutomationId="{Binding ValueAutomationId}"/>
       <StackPanel Visibility="{Binding HasLabel, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_DateLabel}"/><TextBox Text="{Binding LabelInput.Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_DateLabel}"/></StackPanel>
       <StackPanel Visibility="{Binding IsDate, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{x:Static r:AiDetailedLabels.DateFormat}"/><ComboBox ItemsSource="{Binding DataContext.DateFormats, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiDetailedLabels.DateFormat}" Margin="0,4,0,8"/>
        <TextBlock Text="{x:Static r:AiDetailedLabels.DateMeaning}"/><TextBlock Text="{Binding DateInterpretation}" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock Text="{Binding Warning}" Foreground="#875800" Margin="0,6"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
       <Button IsEnabled="{Binding CanConfirm}" Command="{Binding DataContext.ConfirmTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><TextBlock Text="{x:Static r:AiDetailedLabels.ConfirmText}"/></Button>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border BorderBrush="#D7B464" BorderThickness="1" Padding="10" Visibility="{Binding ReconciliationNeeded, Converter={StaticResource BoolVisibility}}"><StackPanel>
      <TextBlock Text="{x:Static r:AiDetailedLabels.CompareNotice}"/><Button Command="{Binding ReconcileCommand}"><TextBlock Text="{x:Static r:AiDetailedLabels.Acknowledge}"/></Button>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource BoolVisibility}}">
     <TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiDetailedLabels.Step5}"/><TextBlock Text="{x:Static r:AiDetailedLabels.CapabilityMissing}" Foreground="#875800" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding QuickFields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Label}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="{x:Static r:AiDetailedLabels.PreviewLayout}" IsEnabled="{Binding CanPreviewLayout}"/>
    </StackPanel>
    <StackPanel Visibility="{Binding IsStep6, Converter={StaticResource BoolVisibility}}">
     <TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiDetailedLabels.Step6}"/><TextBlock Text="{Binding DetailedSummary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="{x:Static r:AiDetailedLabels.SummaryNotice}" Margin="0,0,0,12"/><TextBlock Text="{x:Static r:AiDetailedLabels.CapabilityMissing}" Foreground="#875800" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding TextChecks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Input.Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Input.Value}"/><TextBlock Text="{Binding Status}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <ItemsControl ItemsSource="{Binding PreservationChecks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding Roles}" FontWeight="SemiBold"/><TextBlock Text="{Binding Asset.UploadName}"/><TextBlock Text="{Binding Status}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </StackPanel></ScrollViewer>
  </DockPanel></Border>
  <Border Grid.Column="4" Style="{StaticResource Panel}"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiPromptLabels.AiPrompt_FinalText}"/><TextBlock Text="{Binding PromptNotice}" Foreground="#875800" Margin="0,0,0,6"/></StackPanel>
   <controls:AiPromptEditor Grid.Row="1" Document="{Binding Document, Mode=TwoWay}" ReferenceLabels="{Binding ReferenceLabels}" ImageReferenceInvoked="OnImageReferenceInvoked" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_FinalText}"/>
   <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_ManifestNotice}" FontSize="12"/>
    <Button Content="{x:Static r:AiPromptLabels.AiPrompt_Compose}" Command="{Binding ComposeCommand}"/>
    <Expander Header="{x:Static r:AiPromptLabels.AiPrompt_Manifest}"><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding AttachmentManifest}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding UploadName}"/><Run Text=" · "/><Run Text="{Binding Purpose}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander>
   </StackPanel>
  </Grid></Border>
 </Grid>
</UserControl>
