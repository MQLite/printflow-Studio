<UserControl x:Class="PrintFlow.App.Views.AiDesign.MemorialProofView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:r="clr-namespace:PrintFlow.App.Views.AiDesign" xmlns:views="clr-namespace:PrintFlow.App.Views">
 <UserControl.Resources>
  <views:PreviewPayloadConverter x:Key="Preview"/>
  <BooleanToVisibilityConverter x:Key="VisibleIf"/>
  <DrawingBrush x:Key="ProofCheckerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
   <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#FAFAFA" Geometry="M0,0 H16 V16 H0 Z"/><GeometryDrawing Brush="#D6D6D6" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/></DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
 </UserControl.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <TextBlock Text="{Binding MemorialResultLabel}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{x:Static r:AiMemorialLabels.ProofReduced}" Margin="0,4,0,0" TextWrapping="Wrap"
              Visibility="{Binding MemorialResultImage.IsDownsampledForDisplay, Converter={StaticResource VisibleIf}}"/>
   <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
    <ComboBox x:Name="SourceChoice" ItemsSource="{Binding MemorialProofSources}" DisplayMemberPath="Label" IsSynchronizedWithCurrentItem="True" MinWidth="180"
              AutomationProperties.Name="{x:Static r:AiMemorialLabels.SourceReference}" Margin="0,0,12,0"/>
    <ComboBox x:Name="BackgroundChoice" SelectedIndex="0" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Background}" Margin="0,0,12,0">
     <ComboBoxItem Content="{x:Static r:AiMemorialLabels.Checkerboard}"/><ComboBoxItem Content="{x:Static r:AiMemorialLabels.Black}"/><ComboBoxItem Content="{x:Static r:AiMemorialLabels.White}"/>
    </ComboBox>
    <TextBlock Text="{x:Static r:AiMemorialLabels.Zoom}" VerticalAlignment="Center"/>
    <Slider x:Name="ZoomHeight" Width="145" Minimum="240" Maximum="1600" Value="480" SmallChange="20" LargeChange="120" Margin="8,0,12,0"
            AutomationProperties.Name="{x:Static r:AiMemorialLabels.Zoom}" VerticalAlignment="Center"/>
    <CheckBox x:Name="SafetyGuide" Content="{x:Static r:AiMemorialLabels.Guide}" IsEnabled="{Binding HasMemorialBadgeGuide}" VerticalAlignment="Center"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
   <StackPanel Orientation="Horizontal">
    <StackPanel Margin="0,0,12,0">
     <TextBlock Text="{Binding SelectedItem.Label, ElementName=SourceChoice}" FontWeight="SemiBold"/>
     <Border Background="{StaticResource ProofCheckerboard}" Margin="0,4,0,0">
      <Image Source="{Binding SelectedItem.Image.Payload, ElementName=SourceChoice, Converter={StaticResource Preview}}"
             Height="{Binding Value, ElementName=ZoomHeight}" MaxWidth="2200" Stretch="Uniform" AutomationProperties.Name="{x:Static r:AiMemorialLabels.SourceReference}"/>
     </Border>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="{Binding MemorialResultLabel}" FontWeight="SemiBold"/>
     <Border Margin="0,4,0,0">
      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource ProofCheckerboard}"/><Style.Triggers>
       <DataTrigger Binding="{Binding SelectedIndex, ElementName=BackgroundChoice}" Value="1"><Setter Property="Background" Value="Black"/></DataTrigger>
       <DataTrigger Binding="{Binding SelectedIndex, ElementName=BackgroundChoice}" Value="2"><Setter Property="Background" Value="White"/></DataTrigger>
      </Style.Triggers></Style></Border.Style>
      <Grid>
       <Image Source="{Binding MemorialResultImage.Payload, Converter={StaticResource Preview}}" Height="{Binding Value, ElementName=ZoomHeight}"
              MaxWidth="2200" Stretch="Uniform" AutomationProperties.Name="{Binding MemorialResultLabel}"/>
       <r:MemorialBadgeGuide Preview="{Binding MemorialResultImage}" SafeRatio="{Binding MemorialProofSafeRatio}" IsHitTestVisible="False"
                             Visibility="{Binding IsChecked, ElementName=SafetyGuide, Converter={StaticResource VisibleIf}}"/>
      </Grid>
     </Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
