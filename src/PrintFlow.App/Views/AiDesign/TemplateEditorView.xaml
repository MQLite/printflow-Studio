<UserControl x:Class="PrintFlow.App.Views.AiDesign.TemplateEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:r="clr-namespace:PrintFlow.App.Views.AiDesign">
 <UserControl.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="6"/></Style><BooleanToVisibilityConverter x:Key="VisibleIf"/></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_EditTemplate}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_TemplateName}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_TemplateName}"/>
    <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_TemplateBody}"/><TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180" MaxHeight="300" Margin="0,4,0,12" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_TemplateBody}"/>
    <Expander Header="{x:Static r:AiPromptLabels.AiPrompt_TemplateFields}">
     <StackPanel>
      <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#C4D9D4" BorderThickness="1" Padding="8" Margin="0,4">
        <StackPanel>
         <WrapPanel>
          <StackPanel Width="150" Margin="0,0,8,8"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Key}"/><TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_Key}"/></StackPanel>
          <StackPanel Width="150" Margin="0,0,8,8"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Kind}"/><ComboBox ItemsSource="{Binding DataContext.FieldKinds, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValue="{Binding Kind}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_Kind}"/></StackPanel>
          <StackPanel Width="150" Margin="0,0,8,8"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Semantic}"/><ComboBox ItemsSource="{Binding DataContext.Semantics, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValue="{Binding Semantic}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_Semantic}"/></StackPanel>
         </WrapPanel>
         <WrapPanel>
          <StackPanel Width="150" Margin="0,0,8,8">
           <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Default}"/>
           <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsDefaultReadOnly}" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_Default}"/>
           <TextBlock Text="{x:Static r:AiMemorialLabels.FixedSpecification}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding IsDefaultReadOnly, Converter={StaticResource VisibleIf}}"/>
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,8,8"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Slot}"/><TextBox Text="{Binding SlotId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_Slot}"/></StackPanel>
          <StackPanel Width="150" Margin="0,0,8,8"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_DateLabel}"/><TextBox Text="{Binding DateLabel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_DateLabel}"/></StackPanel>
         </WrapPanel>
         <WrapPanel><CheckBox Content="{x:Static r:AiPromptLabels.AiPrompt_Required}" IsChecked="{Binding Required}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="{x:Static r:AiPromptLabels.AiPrompt_RemoveField}" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,5"/></WrapPanel>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button Content="{x:Static r:AiPromptLabels.AiPrompt_AddField}" Command="{Binding AddFieldCommand}" HorizontalAlignment="Left" Padding="10,7"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <CheckBox Content="{x:Static r:AiPromptLabels.AiPrompt_SaveAsNew}" IsChecked="{Binding SaveAsNew}" Margin="0,0,0,8"/>
   <CheckBox IsChecked="{Binding PreviewConfirmed}" Margin="0,0,0,8"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Confirmed}" TextWrapping="Wrap"/></CheckBox>
   <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
   <Button Content="{x:Static r:AiPromptLabels.AiPrompt_SaveTemplate}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Padding="16,8"/>
  </StackPanel>
 </Grid>
</UserControl>
