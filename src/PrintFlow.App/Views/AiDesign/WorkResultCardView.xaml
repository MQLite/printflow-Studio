<UserControl x:Class="PrintFlow.App.Views.AiDesign.WorkResultCardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:PrintFlow.App.Views"
 AutomationProperties.AutomationId="AiPrompt.WorkResult">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <views:PreviewPayloadConverter x:Key="Preview"/>
  <Style x:Key="ProgressLine" TargetType="Border">
   <Setter Property="Height" Value="2"/><Setter Property="Background" Value="#9CAFAA"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </UserControl.Resources>
 <Border Background="#E9F8F4" BorderBrush="#B8DFD5" BorderThickness="1" CornerRadius="8" Padding="12,8">
  <StackPanel>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Right">
     <Button Content="{Binding OpenWorkResultPreviewLabel}" Command="{Binding OpenWorkResultPreviewCommand}" Padding="10,6"
      Margin="0,0,8,0" Visibility="{Binding WorkCard.CanContinue, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
      AutomationProperties.AutomationId="AiPrompt.OpenResultPreview"/>
     <Button Content="{Binding ContinueWorkResultLabel}" ToolTip="{Binding ContinueWorkResultHint}"
      Command="{Binding ContinueWorkResultCommand}" Padding="10,6" Background="#007F6B" Foreground="White"
      Visibility="{Binding WorkCard.CanContinue, Converter={StaticResource Visible}, FallbackValue=Collapsed}" AutomationProperties.AutomationId="AiPrompt.ContinueWorkResult"/>
     <Button Content="{Binding ViewWorkLabel}" Command="{Binding ViewWorkCommand}" Padding="10,5" Margin="8,0,0,0"
      Visibility="{Binding WorkCard.CanViewWork, Converter={StaticResource Visible}, FallbackValue=Collapsed}" AutomationProperties.AutomationId="AiPrompt.ViewWork"/>
     <Button Content="{Binding RegenerateInWorkLabel}" Command="{Binding RegenerateInWorkCommand}" Padding="10,5" Margin="8,0,0,0"
      Visibility="{Binding WorkCard.CanRegenerate, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
      AutomationProperties.AutomationId="AiPrompt.RegenerateInWork"/>
    </WrapPanel>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding GenerationProgressLabel}" FontSize="16" FontWeight="SemiBold" Foreground="#12483E"/>
     <TextBlock Text="{Binding GenerationFeedback, NotifyOnTargetUpdated=True}" TextWrapping="Wrap" Foreground="#12483E"
      AutomationProperties.LiveSetting="Polite" TargetUpdated="OnStageUpdated"/>
     <TextBlock Text="{Binding WorkCard.Problem}" TextWrapping="Wrap" Foreground="#84251C"/>
    </StackPanel>
   </DockPanel>
   <DockPanel Margin="0,6,0,0"
              Visibility="{Binding WorkCard.HasOpenAiReceipt, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
    <Button DockPanel.Dock="Right" Content="{Binding CopyOpenAiResponseIdLabel}" Command="{Binding CopyOpenAiResponseIdCommand}"
            Padding="8,3" Margin="8,0,0,0" AutomationProperties.AutomationId="AiPrompt.CopyOpenAiResponseId"/>
    <TextBlock Text="{Binding WorkCard.OpenAiResponseDetails}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
   </DockPanel>
   <DockPanel Margin="0,6,0,0"
              Visibility="{Binding WorkCard.HasCloudPdf, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
    <Button DockPanel.Dock="Right" Content="{Binding SaveCloudPdfLabel}" Command="{Binding SaveCloudPdfCommand}"
            Padding="8,3" Margin="8,0,0,0" AutomationProperties.AutomationId="AiPrompt.SaveCloudPdf"/>
    <TextBlock Text="{Binding WorkCard.CloudReviewDetails}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </DockPanel>
   <ItemsControl ItemsSource="{Binding GenerationMilestones}" Margin="0,6,0,0">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <StackPanel>
       <Grid Height="22">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Visibility="{Binding HasPrevious, Converter={StaticResource Visible}}">
         <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ProgressLine}">
           <Style.Triggers>
            <DataTrigger Binding="{Binding Reached}" Value="True"><Setter Property="Background" Value="#007F6B"/></DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#007F6B"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
        </Border>
        <Border Grid.Column="1" Visibility="{Binding HasNext, Converter={StaticResource Visible}}">
         <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ProgressLine}">
           <Style.Triggers><DataTrigger Binding="{Binding Reached}" Value="True"><Setter Property="Background" Value="#007F6B"/></DataTrigger></Style.Triggers>
          </Style>
         </Border.Style>
        </Border>
        <Border Grid.ColumnSpan="2" Width="20" Height="20" HorizontalAlignment="Center" BorderThickness="2" CornerRadius="10">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#8A9C97"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Reached}" Value="True"><Setter Property="Background" Value="#007F6B"/><Setter Property="BorderBrush" Value="#007F6B"/></DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="BorderBrush" Value="#007F6B"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <Grid>
          <TextBlock Text="✓" Visibility="{Binding Reached, Converter={StaticResource Visible}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
          <Ellipse Width="8" Height="8" Fill="#007F6B" Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}"/>
         </Grid>
        </Border>
       </Grid>
       <TextBlock Text="{Binding Label}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="3,3,3,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
         <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding WorkCard.CanContinue, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
    <Image Width="48" Height="40" Source="{Binding WorkCard.Thumbnail, Converter={StaticResource Preview}}"
     Visibility="{Binding WorkCard.HasThumbnail, Converter={StaticResource Visible}, FallbackValue=Collapsed}" Stretch="Uniform"/>
    <TextBlock Text="{Binding WorkCard.ImageFacts}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
   </StackPanel>
  </StackPanel>
 </Border>
</UserControl>
