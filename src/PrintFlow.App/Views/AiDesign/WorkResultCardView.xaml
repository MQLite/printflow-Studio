<UserControl x:Class="PrintFlow.App.Views.AiDesign.WorkResultCardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:PrintFlow.App.Views"
 AutomationProperties.AutomationId="AiPrompt.WorkResult">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <views:PreviewPayloadConverter x:Key="Preview"/>
 </UserControl.Resources>
 <Border BorderBrush="{DynamicResource PF.Brush.Border}" BorderThickness="1" CornerRadius="8">
  <DockPanel>
   <Border DockPanel.Dock="Top" Background="#E1F6F1" CornerRadius="7,7,0,0" Padding="12,5">
    <TextBlock Text="{Binding WorkResultLabel}" FontWeight="SemiBold" Foreground="#06483E"/>
   </Border>
   <Grid Margin="12,8">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="78"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Border Height="70" Padding="3" Background="{DynamicResource PF.Brush.Canvas}" BorderBrush="#8DAEA7" BorderThickness="1" CornerRadius="5">
     <Grid>
      <TextBlock Text="{Binding WorkCard.Placeholder}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
       HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <DataTrigger Binding="{Binding WorkCard.HasThumbnail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <Image Source="{Binding WorkCard.Thumbnail, Converter={StaticResource Preview}}"
       Visibility="{Binding WorkCard.HasThumbnail, Converter={StaticResource Visible}}" Stretch="Uniform"/>
     </Grid>
    </Border>
    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding WorkCard.Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding WorkCard.Stage, NotifyOnTargetUpdated=True}" TextWrapping="Wrap" FontWeight="SemiBold"
      Foreground="#007362" AutomationProperties.LiveSetting="Polite" TargetUpdated="OnStageUpdated"/>
     <TextBlock Text="{Binding WorkCard.ImageFacts}" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding WorkCard.Problem}" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
    <ItemsControl Grid.Column="2" ItemsSource="{Binding WorkCard.Milestones}" VerticalAlignment="Center" Margin="0,0,12,0">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel HorizontalAlignment="Center">
        <TextBlock TextAlignment="Center" FontSize="16">
         <TextBlock.Style><Style TargetType="TextBlock">
          <Setter Property="Text" Value="○"/><Setter Property="Foreground" Value="#64827D"/>
          <Style.Triggers><DataTrigger Binding="{Binding Reached}" Value="True">
           <Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="#007F6B"/>
          </DataTrigger></Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Column="3" VerticalAlignment="Center">
     <Button Content="{Binding ContinueWorkResultLabel}" ToolTip="{Binding ContinueWorkResultHint}"
      Command="{Binding ContinueWorkResultCommand}" Padding="10,6" Background="#007F6B" Foreground="White"
      Visibility="{Binding WorkCard.CanContinue, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="AiPrompt.ContinueWorkResult"/>
     <Button Content="{Binding ViewWorkLabel}" Command="{Binding ViewWorkCommand}" Padding="10,5"
      Visibility="{Binding WorkCard.CanViewWork, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="AiPrompt.ViewWork"/>
    </StackPanel>
   </Grid>
  </DockPanel>
 </Border>
</UserControl>
