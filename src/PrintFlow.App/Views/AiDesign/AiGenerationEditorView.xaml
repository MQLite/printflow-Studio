<UserControl x:Class="PrintFlow.App.Views.AiDesign.AiGenerationEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:r="clr-namespace:PrintFlow.App.Views.AiDesign" xmlns:controls="clr-namespace:PrintFlow.App.Controls"
 xmlns:views="clr-namespace:PrintFlow.App.Views">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PrintFlow.App;component/Themes/WpfUiTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <views:PreviewPayloadConverter x:Key="Preview"/>
  <r:PromptHistoryPreviewConverter x:Key="HistoryPreview"/>
  <BooleanToVisibilityConverter x:Key="VisibleIf"/>
  <Style TargetType="Button" BasedOn="{StaticResource PF.Button.Secondary}"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,4,6,4"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource PF.Input.TextBox}"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#C4D9D4"/><Setter Property="Background" Value="{DynamicResource PF.Brush.Canvas}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Panel}" Padding="12,8" Margin="0,0,0,12">
   <DockPanel>
    <TextBlock DockPanel.Dock="Left" Text="{x:Static r:AiPromptLabels.AiPrompt_FieldOptions}" FontWeight="SemiBold"
     VerticalAlignment="Center" Margin="0,0,14,8"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="128">
     <ItemsControl ItemsSource="{Binding FieldOptions}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Cursor="Hand"
        AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding AutomationId}" Margin="0,0,10,4">
        <ToggleButton.Style>
         <Style TargetType="ToggleButton">
          <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#8A9694"/>
          <Style.Triggers>
           <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#DDF5EE"/><Setter Property="BorderBrush" Value="#007F6B"/></Trigger>
           <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#007F6B"/></Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#006150"/></Trigger>
          </Style.Triggers>
         </Style>
        </ToggleButton.Style>
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="9"/></Grid.RowDefinitions>
           <Grid.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.18"/></Grid.Effect>
           <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
            CornerRadius="18" Padding="13,6">
            <StackPanel Orientation="Horizontal">
             <TextBlock x:Name="Mark" Text="+" FontWeight="SemiBold" Margin="0,0,7,0"/>
             <ContentPresenter RecognizesAccessKey="True"/>
            </StackPanel>
           </Border>
           <Grid Grid.Row="1" Width="16" Height="10" Margin="13,-1,0,0" HorizontalAlignment="Left">
            <Path Fill="{TemplateBinding Background}" Data="M 4,0 L 0,9 L 15,0 Z"/>
            <Path Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" Data="M 4,0 L 0,9 L 15,0"/>
           </Grid>
          </Grid>
          <ControlTemplate.Triggers>
           <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Text" Value="✓"/><Setter TargetName="Mark" Property="Foreground" Value="#007F6B"/></Trigger>
           <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.58"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="145"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.5*" MinWidth="175"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2.2*" MinWidth="250"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Panel}">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="{x:Static r:AiPromptLabels.AiPrompt_Templates}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <ItemsControl ItemsSource="{Binding TemplateChoices}"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,0,0,7">
        <Button Command="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Template}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,10" Margin="0">
         <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
           <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
            <Setter Property="Background" Value="#DDF5EE"/><Setter Property="BorderBrush" Value="#007F6B"/>
           </DataTrigger></Style.Triggers>
          </Style>
         </Button.Style>
         <TextBlock Text="{Binding Template.Content.Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Button>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander x:Name="TemplateManagement" Header="{x:Static r:AiPromptLabels.AiPrompt_Manage}" Margin="0,3,0,0">
       <StackPanel Margin="0,6,0,0">
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_EditTemplate}" Command="{Binding EditTemplateCommand}" HorizontalContentAlignment="Left"/>
     <Button Command="{Binding SaveInstanceTemplateCommand}" HorizontalContentAlignment="Left"><TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_SaveInstanceTemplate}" TextWrapping="Wrap"/></Button>
        <ItemsControl ItemsSource="{Binding Templates}">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Expander Header="{Binding Content.Name}" Margin="0,4,0,0">
           <StackPanel>
         <Button Content="{x:Static r:AiPromptLabels.AiPrompt_SetDefault}" Command="{Binding DataContext.SetDefaultTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         <Button Content="{x:Static r:AiPromptLabels.AiPrompt_ToggleFavorite}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         <WrapPanel><Button Content="{x:Static r:AiPromptLabels.AiPrompt_MoveUp}" Command="{Binding DataContext.MoveTemplateUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="{x:Static r:AiPromptLabels.AiPrompt_MoveDown}" Command="{Binding DataContext.MoveTemplateDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></WrapPanel>
         <Button Content="{x:Static r:AiPromptLabels.AiPrompt_DeletePersonal}" Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         <Button Content="{x:Static r:AiPromptLabels.AiPrompt_RestoreBuiltin}" Command="{Binding DataContext.RestoreBuiltinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           </StackPanel>
          </Expander>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Expander>
      <Expander x:Name="DraftTools" Header="{x:Static r:AiPromptLabels.AiPrompt_DraftTools}" Margin="0,8,0,0">
       <StackPanel>
        <Expander Header="{x:Static r:AiPromptLabels.AiPrompt_HistoryShort}">
         <StackPanel><Button Content="{x:Static r:AiPromptLabels.AiPrompt_History}" Command="{Binding RefreshHistoryCommand}"/>
          <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate>
           <Expander Header="{Binding Revision}"><StackPanel><TextBlock Text="{Binding FinalDocument, Converter={StaticResource HistoryPreview}}" TextWrapping="Wrap" MaxHeight="140" TextTrimming="CharacterEllipsis"/><Button Content="{x:Static r:AiPromptLabels.AiPrompt_Restore}" Command="{Binding DataContext.RestoreHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Expander>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
         </StackPanel>
        </Expander>
        <r:AiGenerationReviewView/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Border x:Name="FieldColumn" Grid.Column="2" Style="{StaticResource Panel}">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="{x:Static r:AiPromptLabels.AiPrompt_Inputs}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <ItemsControl ItemsSource="{Binding VisibleFields}"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel>
        <TextBlock Text="{Binding WorkbenchLabel}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding WorkbenchLabel}" AutomationProperties.AutomationId="{Binding WorkbenchAutomationId}"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto"/>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Border Grid.Column="4" Style="{StaticResource Panel}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <DockPanel>
      <WrapPanel DockPanel.Dock="Right">
       <Button Content="{x:Static r:AiPromptLabels.AiPrompt_CopyShort}" Command="{Binding CopyCommand}" Padding="8,4" AutomationProperties.AutomationId="AiPrompt.Copy"/>
       <Button Content="{x:Static r:AiPromptLabels.AiPrompt_Save}" Command="{Binding SaveDraftCommand}" Padding="8,4" AutomationProperties.AutomationId="AiPrompt.SaveDraft"/>
      </WrapPanel>
      <TextBlock Style="{StaticResource Heading}" Text="{x:Static r:AiPromptLabels.AiPrompt_FinalText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     </DockPanel>
     <TextBlock Text="{Binding PromptNotice}" TextWrapping="Wrap" Foreground="#875800" AutomationProperties.LiveSetting="Polite"/>
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_UpdateSpecification}" Command="{Binding ComposeCommand}" HorizontalAlignment="Left"
      Visibility="{Binding RequiresSpecificationUpdate, Converter={StaticResource VisibleIf}}"/>
    </StackPanel>
    <controls:AiPromptEditor Grid.Row="1" x:Name="PromptEditor" Document="{Binding Document, Mode=TwoWay}" ReferenceLabels="{Binding ReferenceLabels}" ImageReferenceInvoked="OnImageReferenceInvoked" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_FinalText}"/>
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
     <ItemsControl ItemsSource="{Binding ActivePhotoSlots}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Content="{Binding Role}" ToolTip="{Binding FileName}" Padding="8,4" CommandParameter="{Binding SlotId}"
        Command="{Binding DataContext.PickSlotImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_ChooseReferenceImage}"
             Command="{Binding ChooseReferenceImageCommand}" HorizontalAlignment="Left" Padding="8,4"
             Margin="0,4,0,0" AutomationProperties.AutomationId="AiPrompt.ChooseReferenceImage"/>
     <StackPanel Margin="0,8,0,8">
      <StackPanel.Style>
       <Style TargetType="StackPanel">
        <Style.Triggers>
         <DataTrigger Binding="{Binding ReferenceFileName}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </StackPanel.Style>
      <TextBlock Text="{Binding ReferenceFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="ReferencePurposeLabel" Text="{x:Static r:AiPromptLabels.AiPrompt_ReferenceRole}" Margin="0,6,0,0"/>
      <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_ReferenceRoleHint}" TextWrapping="Wrap" FontSize="12"/>
      <TextBox Text="{Binding ReferenceRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"
               AutomationProperties.LabeledBy="{Binding ElementName=ReferencePurposeLabel}"
               AutomationProperties.AutomationId="AiPrompt.ReferencePurpose"/>
      <Button Content="{x:Static r:AiPromptLabels.AiPrompt_AddReference}" Command="{Binding AddReferenceCommand}"
              HorizontalAlignment="Left" Padding="8,4" AutomationProperties.AutomationId="AiPrompt.AddReference"/>
     </StackPanel>
     <Expander Header="{x:Static r:AiPromptLabels.AiPrompt_ReferenceTools}" AutomationProperties.AutomationId="AiPrompt.ReferenceTools">
      <ScrollViewer MaxHeight="215" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <ItemsControl ItemsSource="{Binding ActivePhotoSlots}"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Panel}" Margin="0,0,0,10" Padding="8">
          <StackPanel>
           <TextBlock Text="{Binding Role}" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <Image Source="{Binding Preview.Payload, Converter={StaticResource Preview}}" Height="76" Stretch="Uniform" AutomationProperties.Name="{Binding Role}"/>
           <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontSize="12"/>
           <TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap" Foreground="#B42318"/>
           <WrapPanel>
            <Button Content="{x:Static r:AiPromptLabels.AiPrompt_Expand}" Command="{Binding DataContext.ExpandPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="{x:Static r:AiPromptLabels.AiPrompt_RemovePhoto}" Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           </WrapPanel>
           <ComboBox ItemsSource="{Binding AvailableAssets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="UploadName" AutomationProperties.Name="{x:Static r:AiPromptLabels.AiPrompt_Reuse}"/>
           <Button Content="{x:Static r:AiPromptLabels.AiPrompt_Reuse}" Command="{Binding DataContext.ReusePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <ItemsControl ItemsSource="{Binding AttachmentManifest}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding UploadName}"/><Run Text=" · "/><Run Text="{Binding Purpose}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </ScrollViewer>
     </Expander>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Grid>
</UserControl>
