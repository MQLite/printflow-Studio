<UserControl x:Class="PrintFlow.App.Views.AiDesign.MemorialLayoutView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:r="clr-namespace:PrintFlow.App.Views.AiDesign">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleIf"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3,4,6"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,4,5,4"/><Setter Property="Padding" Value="8,5"/></Style>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="{Binding MemorialCanvasLabel}" FontWeight="SemiBold"/>
  <TextBlock Text="{x:Static r:AiMemorialLabels.LayoutHelp}" Margin="0,6,0,8"/>
  <TextBlock Text="{Binding MemorialLayoutStatus}" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding MemorialLayoutIssues}" Margin="0,4" Foreground="#B42318"/>
  <Button Content="{x:Static r:AiMemorialLabels.EditLayout}" Command="{Binding PrepareMemorialLayoutCommand}"
          IsEnabled="{Binding CanPrepareMemorialLayout}" AutomationProperties.AutomationId="Memorial.EditLayout"/>
  <StackPanel Visibility="{Binding IsMemorialLayoutEditorOpen, Converter={StaticResource VisibleIf}}">
   <TextBlock Text="{x:Static r:AiMemorialLabels.MmHelp}" Margin="0,6"/>
   <ItemsControl ItemsSource="{Binding MemorialImages}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,0,0,12">
      <TextBlock Text="{Binding Asset.OriginalName}" FontWeight="SemiBold"/>
      <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" DisplayMemberPath="Label"
                AutomationProperties.Name="{x:Static r:AiMemorialLabels.LayerRole}" Margin="0,4"/>
      <UniformGrid Columns="3">
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.Left}"/><TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Left}"/></StackPanel>
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.Top}"/><TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Top}"/></StackPanel>
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.Width}"/><TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Width}"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="{Binding Height, StringFormat={}{0:0.##} mm}" ToolTip="{x:Static r:AiMemorialLabels.Height}"/>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <ItemsControl ItemsSource="{Binding MemorialText}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,0,0,12">
      <TextBlock Text="{Binding Text}" FontWeight="SemiBold"/>
      <TextBlock Text="{x:Static r:AiMemorialLabels.Font}"/>
      <TextBox Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Font}"/>
      <UniformGrid Columns="2">
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.FontSize}"/><TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.FontSize}"/></StackPanel>
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.TextPlacement}"/><ComboBox ItemsSource="{Binding Placements}" SelectedItem="{Binding Placement, Mode=TwoWay}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:AiMemorialLabels.TextPlacement}"/></StackPanel>
      </UniformGrid>
      <UniformGrid Columns="4">
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.Left}"/><TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Left}"/></StackPanel>
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.Top}"/><TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Top}"/></StackPanel>
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.Width}"/><TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Width}"/></StackPanel>
       <StackPanel><TextBlock Text="{x:Static r:AiMemorialLabels.Height}"/><TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Height}"/></StackPanel>
      </UniformGrid>
      <StackPanel Visibility="{Binding IsArc, Converter={StaticResource VisibleIf}}">
       <TextBlock Text="{x:Static r:AiMemorialLabels.Radius}"/><TextBox Text="{Binding ArcRadius, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:AiMemorialLabels.Radius}"/>
      </StackPanel>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <WrapPanel>
    <Button Content="{x:Static r:AiMemorialLabels.SaveLayout}" Command="{Binding SaveMemorialLayoutCommand}" IsEnabled="{Binding CanSaveMemorialLayout}" AutomationProperties.AutomationId="Memorial.SaveLayout"/>
    <Button Content="{x:Static r:AiMemorialLabels.DiscardLayout}" Command="{Binding DiscardMemorialLayoutCommand}"/>
   </WrapPanel>
  </StackPanel>
  <Button Content="{x:Static r:AiMemorialLabels.ConfirmLayout}" Command="{Binding ConfirmMemorialLayoutCommand}" IsEnabled="{Binding CanConfirmMemorialLayout}" AutomationProperties.AutomationId="Memorial.ConfirmLayout"/>
  <Button Content="{x:Static r:AiMemorialLabels.Preview}" Command="{Binding RenderMemorialPreviewCommand}" IsEnabled="{Binding CanPreviewLayout}" AutomationProperties.AutomationId="Memorial.Preview"/>
  <Button Content="{x:Static r:AiMemorialLabels.Convert}" Command="{Binding BeginMemorialConversionCommand}" IsEnabled="{Binding CanBeginMemorialConversion}"/>
  <Border BorderBrush="#A6B4B1" BorderThickness="1" Padding="8" Margin="0,6"
          Visibility="{Binding IsMemorialConversionPending, Converter={StaticResource VisibleIf}}">
   <StackPanel>
    <TextBlock Text="{Binding MemorialConversionLabel}"/>
    <WrapPanel><Button Content="{x:Static r:AiMemorialLabels.ConfirmConversion}" Command="{Binding ConfirmMemorialConversionCommand}"/>
     <Button Content="{x:Static r:AiMemorialLabels.Cancel}" Command="{Binding CancelMemorialConversionCommand}"/></WrapPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
