<UserControl x:Class="PrintFlow.App.Views.AiDesign.PromptPhotoPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PrintFlow.App.Views">
 <UserControl.Resources><views:PreviewPayloadConverter x:Key="Preview"/></UserControl.Resources>
 <DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding Role}" FontSize="20" Margin="0,0,0,10"/><TextBlock DockPanel.Dock="Bottom" Text="{Binding FileName}" TextWrapping="Wrap"/><Image Source="{Binding Preview.Payload, Converter={StaticResource Preview}}" Stretch="Uniform" AutomationProperties.Name="{Binding Role}"/></DockPanel>
</UserControl>
