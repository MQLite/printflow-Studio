<UserControl x:Class="PrintFlow.App.Views.AiDesign.AiPromptWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PrintFlow.App.Views.AiDesign"
 xmlns:r="clr-namespace:PrintFlow.App.Views.AiDesign"
 xmlns:views="clr-namespace:PrintFlow.App.Views"
 Background="{DynamicResource PF.Brush.Canvas}" Foreground="{DynamicResource PF.Brush.Ink}"
 FontFamily="{DynamicResource PF.Font.Family}" FontSize="14"
 AutomationProperties.AutomationId="Screen.AiPromptWorkbench">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PrintFlow.App;component/Themes/WpfUiTheme.xaml" /></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BoolVisibility" />
   <views:PreviewPayloadConverter x:Key="WorkPreviewPayload"/>
  </ResourceDictionary>
 </UserControl.Resources>
 <DockPanel Margin="20">
 <Button DockPanel.Dock="Bottom" Content="{x:Static r:AiMemorialLabels.CancelTask}" Command="{Binding CancelMemorialTaskCommand}"
         Visibility="{Binding IsMemorialTaskRunning, Converter={StaticResource BoolVisibility}}"
         HorizontalAlignment="Right" Margin="0,8,0,0" Padding="16,10" AutomationProperties.AutomationId="Memorial.StopTask"/>
 <Grid IsEnabled="{Binding CanEdit}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.RowSpan="3">
   <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
    <Condition Binding="{Binding TemplateEditor}" Value="{x:Null}"/><Condition Binding="{Binding ExpandedPhoto}" Value="{x:Null}"/>
    <Condition Binding="{Binding IsChangePending}" Value="False"/><Condition Binding="{Binding IsSavedDraftsVisible}" Value="False"/>
    <Condition Binding="{Binding ShowWorkPreview}" Value="False"/>
    <Condition Binding="{Binding ShowFollowUpEditor}" Value="False"/>
   </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12" LastChildFill="True">
   <WrapPanel DockPanel.Dock="Right">
    <Button Content="{Binding ReturnHomeLabel}" Command="{Binding ReturnHomeCommand}" Margin="0,0,8,0" Padding="10,6" AutomationProperties.AutomationId="AiPrompt.ReturnHome"/>
    <Button Content="{x:Static r:AiPromptLabels.AiPrompt_DraftsShort}" Command="{Binding ShowSavedDraftsCommand}" Margin="0,0,8,0" Padding="10,6" AutomationProperties.AutomationId="AiPrompt.SavedDrafts"/>
    <Button Content="{Binding WorkTasksLabel}" Command="{Binding ShowWorkTasksCommand}" Padding="10,6" AutomationProperties.AutomationId="AiPrompt.WorkTasks"/>
   </WrapPanel>
   <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Title}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <local:AiGenerationEditorView Grid.Row="1"/>
  <StackPanel Grid.Row="2">
   <local:WorkResultCardView Margin="0,10,0,0" Visibility="{Binding ShowGenerationProgress, Converter={StaticResource BoolVisibility}}"/>
  <Grid Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#B42318" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="{Binding WorkCardNotice}" TextWrapping="Wrap" Foreground="#B42318"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   <Button Grid.Column="1" Content="{Binding StopReceivingLabel}" Command="{Binding StopReceivingCommand}"
    Visibility="{Binding CanStopReceiving, Converter={StaticResource BoolVisibility}}"
    Margin="0,0,10,0" Padding="16,10" AutomationProperties.AutomationId="AiPrompt.StopReceiving"/>
   <Button Grid.Column="2" Content="{Binding AutoGenerateLabel}" Command="{Binding AutoGenerateCommand}" Padding="24,10"
    MinWidth="140" AutomationProperties.AutomationId="AiPrompt.AutoGenerate" Background="#007F6B" Foreground="White"/>
  </Grid>
  </StackPanel>
  </Grid>
  <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource PF.Brush.Canvas}" Padding="14" BorderBrush="#007F6B" BorderThickness="2" KeyboardNavigation.TabNavigation="Cycle"
   Visibility="{Binding IsChangePending, Converter={StaticResource BoolVisibility}}">
   <StackPanel VerticalAlignment="Center" MaxWidth="520">
    <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_ConfirmChange}" TextWrapping="Wrap" FontSize="18"/>
    <WrapPanel Margin="0,18,0,0">
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_PreserveContinue}" Command="{Binding ConfirmChangeCommand}" Padding="14,10" Margin="0,0,12,0"/>
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_Cancel}" Command="{Binding CancelChangeCommand}" Padding="14,10"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Border Grid.RowSpan="3" Background="{DynamicResource PF.Brush.Canvas}" BorderBrush="#007F6B" BorderThickness="1" Padding="16" KeyboardNavigation.TabNavigation="Cycle">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding TemplateEditor}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel>
    <Button DockPanel.Dock="Bottom" Content="{x:Static r:AiPromptLabels.AiPrompt_Close}" Command="{Binding CloseTemplateCommand}" HorizontalAlignment="Right" Padding="16,8" Margin="0,8,0,0"/>
    <local:TemplateEditorView DataContext="{Binding TemplateEditor}"/>
   </DockPanel>
  </Border>
  <Border Grid.RowSpan="3" Background="{DynamicResource PF.Brush.Canvas}" Padding="16" KeyboardNavigation.TabNavigation="Cycle">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ExpandedPhoto}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel>
    <Button DockPanel.Dock="Bottom" Content="{x:Static r:AiPromptLabels.AiPrompt_Close}" Command="{Binding ClosePhotoCommand}" Padding="16,8" HorizontalAlignment="Right"/>
    <local:PromptPhotoPreview DataContext="{Binding ExpandedPhoto}"/>
   </DockPanel>
  </Border>
  <Border Grid.RowSpan="3" Background="{DynamicResource PF.Brush.Canvas}" Padding="16" KeyboardNavigation.TabNavigation="Cycle"
          Visibility="{Binding ShowWorkPreview, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="AiPrompt.ResultPreview">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
     <Button DockPanel.Dock="Right" Content="{x:Static r:AiPromptLabels.AiPrompt_Close}" Command="{Binding CloseWorkResultPreviewCommand}"
             Padding="14,6" AutomationProperties.AutomationId="AiPrompt.CloseResultPreview"/>
     <TextBlock Text="{Binding WorkPreviewTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <Grid>
     <Image Source="{Binding WorkPreview.Payload, Converter={StaticResource WorkPreviewPayload}}" Stretch="Uniform"
            AutomationProperties.Name="{Binding WorkPreviewTitle}"/>
     <TextBlock Text="{Binding WorkPreviewNotice}" HorizontalAlignment="Center" VerticalAlignment="Center"
                TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </DockPanel>
  </Border>
  <Border Grid.RowSpan="3" Background="{DynamicResource PF.Brush.Canvas}" Padding="18" KeyboardNavigation.TabNavigation="Cycle"
          Visibility="{Binding ShowFollowUpEditor, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="AiPrompt.FollowUpEditor">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
     <Button DockPanel.Dock="Right" Content="{x:Static r:AiPromptLabels.AiPrompt_Close}" Command="{Binding CloseFollowUpEditorCommand}"
             Padding="14,6" AutomationProperties.AutomationId="AiPrompt.CloseFollowUp"/>
     <TextBlock Text="{Binding RegenerateInWorkLabel}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource PF.Brush.Surface}" Margin="0,0,16,0" Padding="12" CornerRadius="12">
      <Grid>
       <Image Source="{Binding WorkPreview.Payload, Converter={StaticResource WorkPreviewPayload}}" Stretch="Uniform"
              AutomationProperties.Name="{Binding WorkPreviewTitle}"/>
       <TextBlock Text="{Binding WorkPreviewNotice}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
     </Border>
     <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
       <TextBlock Text="{Binding FollowUpFeedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <Button Content="{Binding SubmitFollowUpLabel}" Command="{Binding SubmitFollowUpCommand}" HorizontalAlignment="Right"
               Margin="0,8,0,0" Padding="24,10" Background="#007F6B" Foreground="White" AutomationProperties.AutomationId="AiPrompt.SubmitFollowUp"/>
      </StackPanel>
      <Border BorderBrush="#C6D5CF" BorderThickness="1" Background="{DynamicResource PF.Brush.Surface}" Padding="14" CornerRadius="12">
       <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding FollowUpPrefix}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox Text="{Binding FollowUpInstructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0"
                 AutomationProperties.Name="{Binding FollowUpPrefix}" AutomationProperties.AutomationId="AiPrompt.FollowUpInstructions"/>
       </DockPanel>
      </Border>
     </DockPanel>
    </Grid>
   </DockPanel>
  </Border>
  <Border Grid.RowSpan="3" Background="{DynamicResource PF.Brush.Canvas}" Padding="16" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsSavedDraftsVisible, Converter={StaticResource BoolVisibility}}">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding SavedDraftsLabel}" FontSize="22" Margin="0,0,0,12"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding SavedDraftsNotice}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#B42318" AutomationProperties.AutomationId="AiPrompt.SavedDraftError" AutomationProperties.LiveSetting="Polite"/>
    <Button DockPanel.Dock="Bottom" Content="{x:Static r:AiPromptLabels.AiPrompt_Close}" Command="{Binding CloseSavedDraftsCommand}" HorizontalAlignment="Right" Padding="16,8"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <ItemsControl ItemsSource="{Binding SavedDrafts}"><ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.OpenSavedDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="12">
       <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding TextPreview}" TextWrapping="Wrap"/></StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Border>
 </Grid>
 </DockPanel>
</UserControl>
