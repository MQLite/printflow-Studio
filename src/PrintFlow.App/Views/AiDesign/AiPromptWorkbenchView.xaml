<UserControl x:Class="PrintFlow.App.Views.AiDesign.AiPromptWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PrintFlow.App.Views.AiDesign"
 xmlns:r="clr-namespace:PrintFlow.App.Views.AiDesign"
 Background="{DynamicResource PF.Brush.Canvas}" Foreground="{DynamicResource PF.Brush.Ink}"
 FontFamily="{DynamicResource PF.Font.Family}" FontSize="14"
 AutomationProperties.AutomationId="Screen.AiPromptWorkbench">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PrintFlow.App;component/Themes/WpfUiTheme.xaml" /></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_Title}" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_DetailPending}" Margin="0,6,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <local:QuickPromptView Grid.Row="1"/>
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#B42318" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   <Button Grid.Column="1" Content="{x:Static r:AiPromptLabels.AiPrompt_Save}" Command="{Binding SaveDraftCommand}" Margin="0,0,10,0" Padding="16,10" IsEnabled="{Binding CanEdit}"/>
   <Button Grid.Column="2" Content="{x:Static r:AiPromptLabels.AiPrompt_Copy}" Command="{Binding CopyCommand}" Padding="20,10" IsEnabled="{Binding CanEdit}"
    AutomationProperties.AutomationId="AiPrompt.Copy" Background="#007F6B" Foreground="White"/>
  </Grid>
  <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource PF.Brush.Canvas}" Padding="14" BorderBrush="#007F6B" BorderThickness="2"
   Visibility="{Binding IsChangePending, Converter={StaticResource BoolVisibility}}">
   <StackPanel VerticalAlignment="Center" MaxWidth="520">
    <TextBlock Text="{x:Static r:AiPromptLabels.AiPrompt_ConfirmChange}" TextWrapping="Wrap" FontSize="18"/>
    <WrapPanel Margin="0,18,0,0">
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_PreserveContinue}" Command="{Binding ConfirmChangeCommand}" Padding="14,10" Margin="0,0,12,0"/>
     <Button Content="{x:Static r:AiPromptLabels.AiPrompt_Cancel}" Command="{Binding CancelChangeCommand}" Padding="14,10"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Border Grid.RowSpan="3" Background="{DynamicResource PF.Brush.Canvas}" BorderBrush="#007F6B" BorderThickness="1" Padding="16">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding TemplateEditor}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel>
    <Button DockPanel.Dock="Bottom" Content="{x:Static r:AiPromptLabels.AiPrompt_Close}" Command="{Binding CloseTemplateCommand}" HorizontalAlignment="Right" Padding="16,8" Margin="0,8,0,0"/>
    <local:TemplateEditorView DataContext="{Binding TemplateEditor}"/>
   </DockPanel>
  </Border>
  <Border Grid.RowSpan="3" Background="{DynamicResource PF.Brush.Canvas}" Padding="16">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ExpandedPhoto}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel>
    <Button DockPanel.Dock="Bottom" Content="{x:Static r:AiPromptLabels.AiPrompt_Close}" Command="{Binding ClosePhotoCommand}" Padding="16,8" HorizontalAlignment="Right"/>
    <local:PromptPhotoPreview DataContext="{Binding ExpandedPhoto}"/>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
