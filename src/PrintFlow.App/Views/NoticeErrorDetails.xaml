<UserControl x:Class="PrintFlow.App.Views.NoticeErrorDetails"
             x:Name="DetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">
    <!--
        The Error details of the failure the notice above describes (SCRUM-11151): its exact stable
        code, collapsed so the sentence stays short. Bound to the screen's own NoticeErrorCode, which
        exists only while that notice is shown, so an earlier failure's code never appears here.
        Opening it is view state only: it sends nothing, retries nothing and changes no record.
    -->
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PrintFlow.App;component/Themes/WpfUiTheme.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolToVisibility" /></ResourceDictionary>
    </UserControl.Resources>
    <Expander Header="{Binding NoticeErrorDetailsLabel}"
              Margin="0,0,0,6"
              IsExpanded="False"
              AutomationProperties.AutomationId="NoticeErrorDetails"
              AutomationProperties.Name="{Binding NoticeErrorDetailsLabel}">
        <Expander.Style>
            <Style TargetType="Expander" BasedOn="{StaticResource PF.Disclosure}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Code, ElementName=DetailsControl}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Expander.Style>
        <!-- Code and hint wrap independently so a long code stays selectable at narrow widths. -->
        <StackPanel Margin="0,8,0,0">
            <TextBlock Text="{Binding NoticeErrorCodeLabel}" Margin="0,3,8,0" FontWeight="SemiBold" />
            <TextBox
                     Text="{Binding Code, ElementName=DetailsControl, Mode=OneWay}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0,3" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="NoticeErrorDetails.Code"
                     AutomationProperties.Name="{Binding NoticeErrorCodeLabel}" />
            <TextBlock Text="{Binding NoticeErrorCodeHint}" TextWrapping="Wrap" Opacity="0.85" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="NoticeErrorDetails.Hint" />
        </StackPanel>
    </Expander>
</UserControl>
