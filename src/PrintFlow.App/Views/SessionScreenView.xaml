<UserControl x:Class="PrintFlow.App.Views.SessionScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
             xmlns:local="clr-namespace:PrintFlow.App.Views"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionViewModel}"
             AutomationProperties.AutomationId="Screen.Session"
             AutomationProperties.Name="{Binding SessionName}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:PreviewPayloadConverter x:Key="PreviewPayload" />
        <local:RecommendedCommandConverter x:Key="RecommendedCommand" />
        <local:ProposedTrimConverter x:Key="ProposedTrim" />

        <!--
            A trim-adjustment handle (SCRUM-11147): a white square with a dark border, readable
            over any artwork without relying on colour. Keyboard focus thickens the border.
            Positioned, hit-tested and moved by the code-behind; never a drag source of its own.
        -->
        <Style x:Key="TrimHandle" TargetType="Thumb">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Square" Background="White" BorderBrush="#FF1A1A1A" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Square" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecommendedAction" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RecommendedCommand}">
                            <Binding Path="Command" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="DataContext.RecommendedCommand" RelativeSource="{RelativeSource AncestorType={x:Type local:SessionScreenView}}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="#174D83" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="#E1EEFA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource RecommendedAction}" />

        <Style x:Key="MetadataLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,0,8,2" />
        </Style>

        <Style x:Key="MetadataValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            The transparency checkerboard (§8). Display only: it is a brush painted behind the
            image, so the bytes are never flattened, never composited and never written. Two
            8×8 squares tiled at 16×16, in the conventional light grey pair.
        -->
        <DrawingBrush x:Key="TransparencyCheckerboard"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>



        <!-- Final review and save section (SCRUM-11145); instantiated only while it applies. -->
        <DataTemplate x:Key="FinalSaveTemplate">
            <Border BorderBrush="#174D83" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14"
                    AutomationProperties.AutomationId="Session.FinalSave"
                    AutomationProperties.Name="{Binding FinalSaveHeading}">
                <StackPanel>
                    <TextBlock Text="{Binding FinalSaveHeading}" FontSize="15" FontWeight="SemiBold" />

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasMultipleFinalSaveTargets, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FinalSaveTargetLabel}" Style="{StaticResource MetadataLabel}" />
                        <ComboBox ItemsSource="{Binding FinalSaveTargets}"
                                  SelectedItem="{Binding SelectedFinalSaveTarget, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  IsEnabled="{Binding IsSaveDraftEditable}"
                                  AutomationProperties.AutomationId="Session.FinalSave.Target"
                                  AutomationProperties.Name="{Binding FinalSaveTargetLabel}" />
                    </StackPanel>

                    <TextBlock Text="{Binding FinalSaveStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"
                               AutomationProperties.AutomationId="Session.FinalSave.Status" />
                    <TextBlock Text="{Binding FinalSaveAlert}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#8A1F11"
                               AutomationProperties.AutomationId="Session.FinalSave.Alert"
                               Visibility="{Binding HasFinalSaveAlert, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding FinalSaveProgress, Mode=OneWay}"
                                 AutomationProperties.Name="{Binding FinalSaveStatus}"
                                 Visibility="{Binding HasFinalSaveProgress, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Older and unresolved saves stay reachable with their own destination. -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasFinalSaveRecords, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FinalSaveRecordsLabel}" Style="{StaticResource MetadataLabel}" />
                        <!-- Labels carry full folders, so they wrap rather than clip. -->
                        <ComboBox ItemsSource="{Binding FinalSaveRecords}"
                                  SelectedItem="{Binding SelectedFinalSaveRecord, Mode=TwoWay}"
                                  HorizontalContentAlignment="Stretch"
                                  TextSearch.TextPath="Label"
                                  IsEnabled="{Binding IsSaveDraftEditable}"
                                  AutomationProperties.AutomationId="Session.FinalSave.Record"
                                  AutomationProperties.Name="{Binding FinalSaveRecordsLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- The draft is shown only while a save of this result is possible. -->
                    <StackPanel Visibility="{Binding ShowsSaveDraft, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SaveSummary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   AutomationProperties.AutomationId="Session.FinalSave.Summary" />

                        <TextBlock Text="{Binding SaveFileNameLabel}" Style="{StaticResource MetadataLabel}" Margin="0,8,8,2" />
                        <TextBox Text="{Binding SaveFileNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsSaveDraftEditable}"
                                 AutomationProperties.AutomationId="Session.FinalSave.FileName"
                                 AutomationProperties.Name="{Binding SaveFileNameLabel}" />

                        <TextBlock Text="{Binding SaveFolderLabel}" Style="{StaticResource MetadataLabel}" Margin="0,8,8,2" />
                        <TextBox Text="{Binding SaveFolderText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="Session.FinalSave.Folder"
                                 AutomationProperties.Name="{Binding SaveFolderLabel}" />
                        <Button Content="{Binding ChangeLocationLabel}" Command="{Binding ChangeLocationCommand}"
                                HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0"
                                AutomationProperties.AutomationId="Session.FinalSave.ChangeLocation"
                                AutomationProperties.Name="{Binding ChangeLocationLabel}"
                                Visibility="{Binding CanChangeLocation, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding SaveDraftNotice}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85"
                                   AutomationProperties.AutomationId="Session.FinalSave.DraftNotice"
                                   Visibility="{Binding HasSaveDraftNotice, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FinalSaveSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85"
                               AutomationProperties.AutomationId="Session.FinalSave.Secondary"
                               Visibility="{Binding HasFinalSaveSecondary, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasFinalSaveSavedPath, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SavedPathLabel}" Style="{StaticResource MetadataLabel}" />
                        <TextBox Text="{Binding FinalSaveSavedPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="Session.FinalSave.SavedPath"
                                 AutomationProperties.Name="{Binding SavedPathLabel}" />
                    </StackPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource RecommendedAction}">
                                <Setter Property="Padding" Value="12,5" />
                                <Setter Property="Margin" Value="0,0,8,6" />
                            </Style>
                        </WrapPanel.Resources>
                        <local:ReviewApprovalButton Content="{Binding ConfirmAndSaveLabel}"
                                Style="{StaticResource {x:Type Button}}"
                                TargetIdentity="{Binding ConfirmAndSaveIdentity}"
                                Command="{Binding ConfirmAndSaveCommand}"
                                AutomationProperties.AutomationId="Session.FinalSave.ConfirmAndSave"
                                AutomationProperties.Name="{Binding ConfirmAndSaveLabel}"
                                Visibility="{Binding CanConfirmAndSave, Converter={StaticResource BoolToVisibility}}" />
                        <local:ReviewApprovalButton Content="{Binding SaveApprovedLabel}"
                                Style="{StaticResource {x:Type Button}}"
                                TargetIdentity="{Binding SaveApprovedIdentity}"
                                Command="{Binding SaveApprovedCommand}"
                                AutomationProperties.AutomationId="Session.FinalSave.SaveApproved"
                                AutomationProperties.Name="{Binding SaveApprovedLabel}"
                                Visibility="{Binding CanSaveApproved, Converter={StaticResource BoolToVisibility}}" />
                        <local:ReviewApprovalButton Content="{Binding RetryRecordedLabel}" Command="{Binding RetryRecordedSaveCommand}"
                                Style="{StaticResource {x:Type Button}}" TargetIdentity="{Binding RecordedActionIdentity}"
                                AutomationProperties.AutomationId="Session.FinalSave.RetryRecorded"
                                AutomationProperties.Name="{Binding RetryRecordedLabel}"
                                Visibility="{Binding CanRetryRecordedSave, Converter={StaticResource BoolToVisibility}}" />
                        <local:ReviewApprovalButton Content="{Binding CheckAgainLabel}" Command="{Binding CheckSaveAgainCommand}"
                                Style="{StaticResource {x:Type Button}}" TargetIdentity="{Binding RecordedActionIdentity}"
                                AutomationProperties.AutomationId="Session.FinalSave.CheckAgain"
                                AutomationProperties.Name="{Binding CheckAgainLabel}"
                                Visibility="{Binding CanCheckSaveAgain, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding OpenFolderLabel}" Command="{Binding OpenContainingFolderCommand}"
                                AutomationProperties.AutomationId="Session.FinalSave.OpenFolder"
                                AutomationProperties.Name="{Binding OpenFolderLabel}"
                                Visibility="{Binding CanOpenContainingFolder, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding CheckSavedLabel}" Command="{Binding CheckSavedFileCommand}"
                                AutomationProperties.AutomationId="Session.FinalSave.CheckSaved"
                                AutomationProperties.Name="{Binding CheckSavedLabel}"
                                Visibility="{Binding CanCheckSavedFile, Converter={StaticResource BoolToVisibility}}" />
                        <local:ReviewApprovalButton Content="{Binding SaveAnotherCopyLabel}" Command="{Binding SaveAnotherCopyCommand}"
                                Style="{StaticResource {x:Type Button}}" TargetIdentity="{Binding RecordedActionIdentity}"
                                AutomationProperties.AutomationId="Session.FinalSave.SaveAnotherCopy"
                                AutomationProperties.Name="{Binding SaveAnotherCopyLabel}"
                                Visibility="{Binding CanSaveAnotherCopy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding UseSuggestionLabel}" Command="{Binding UseSuggestedNameCommand}"
                                AutomationProperties.AutomationId="Session.FinalSave.UseSuggestion"
                                AutomationProperties.Name="{Binding UseSuggestionLabel}"
                                Visibility="{Binding CanUseSuggestedName, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding CancelSaveLabel}" Command="{Binding CancelSaveCommand}"
                                AutomationProperties.AutomationId="Session.FinalSave.Cancel"
                                AutomationProperties.Name="{Binding CancelSaveLabel}"
                                Visibility="{Binding CanCancelSave, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding FinalSaveOpenNotice}" TextWrapping="Wrap" Margin="0,4,0,0"
                               AutomationProperties.AutomationId="Session.FinalSave.OpenNotice"
                               Visibility="{Binding HasFinalSaveOpenNotice, Converter={StaticResource BoolToVisibility}}" />

                    <Expander Header="{Binding FinalSaveDetailsLabel}" Margin="0,6,0,0"
                              AutomationProperties.AutomationId="Session.FinalSave.Details"
                              AutomationProperties.Name="{Binding FinalSaveDetailsLabel}"
                              Visibility="{Binding HasFinalSaveDetails, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding FinalSaveDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding FinalSaveDetailsLabel}" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Session identity (§3). -->
        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Workflow}" VerticalAlignment="Center"
                       Margin="12,0,0,0" Opacity="0.85" />
            <TextBlock Text="{Binding SessionName}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Grid.Row="1" x:Name="OperatorStatusPanel" Margin="0,6,0,0" Padding="10,4"
                Background="#F3F7FA"
                Focusable="True" KeyboardNavigation.IsTabStop="True"
                AutomationProperties.AutomationId="Session.OperatorStatus"
                AutomationProperties.Name="{Binding StatusHeading}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#9BAFC0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#174D83" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding StatusHeading, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" /><Run Text=" — " />
                <Run Text="{Binding NextStepText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusReason, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <!--
            The fake-adapter warning (§8). Deliberately loud: an operator must never mistake a
            generated test file for production output.
        -->
        <Border Grid.Row="2"
                Background="#FFF4CE"
                BorderBrush="#E0B000"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,12,0,0"
                Visibility="{Binding IsFakeProcessing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding FakeModeNotice}"
                           TextWrapping="Wrap"
                           Foreground="#5A4500"
                           FontWeight="SemiBold" />

                <!--
                    A synthetic TIFF is the dangerous one: it is named and shaped like
                    something that could be printed, so it says plainly what it is not (§10).
                -->
                <TextBlock Text="{Binding FakeTiffNotice}"
                           TextWrapping="Wrap"
                           Foreground="#5A4500"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsFakeTiffOutput, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- Automation has ended for this session; nothing here restarts it (§14). -->
            <TextBlock Text="{Binding HandedOffNotice}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsHandedOff, Converter={StaticResource BoolToVisibility}}" />

            <!-- The error surface: a localised sentence and a stable code, never a trace (§15). -->
            <TextBlock Text="{Binding PdfSourceNotice}" TextWrapping="Wrap" Margin="0,8,0,8"
                       Visibility="{Binding HasPdfSource, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding PsdSourceNotice}" TextWrapping="Wrap" Margin="0,8,0,8"
                       Visibility="{Binding HasPsdSource, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Notice}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoticeErrorCode}" Value="True">
                                <!-- Keep the existing single-line space; full failures use the
                                     scrolling details column without shrinking the preview. -->
                                <Setter Property="Text" Value="" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--
                Stop and Take Over (Epic 11300 Part D2A §24, §25, §27). Both are bound to the
                workflow layer's own answers — CanStopAutomation and CanTakeOverAutomation —
                and this file states no condition of its own. In particular it does NOT bind to
                IsBusy: that is true for every command the screen issues, including an approval,
                and a Stop offered beside a review decision would offer to stop nothing.

                They are two buttons rather than one because they mean different things and
                §27 requires the operator to be able to tell them apart: Stop tries to cancel
                the operation, Take Over leaves Meitu alone. Neither closes Meitu.
            -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8"
                        Visibility="{Binding CanStopAutomation, Converter={StaticResource BoolToVisibility}}">
                <Button Content="{Binding StopLabel}"
                        Command="{Binding StopAutomationCommand}"
                        AutomationProperties.AutomationId="Session.Stop"
                        AutomationProperties.Name="{Binding StopLabel}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="{Binding TakeOverLabel}"
                        Command="{Binding BeginTakeOverCommand}"
                        AutomationProperties.AutomationId="Session.TakeOver"
                        AutomationProperties.Name="{Binding TakeOverLabel}"
                        Padding="14,6"
                        Margin="0,0,12,0"
                        Visibility="{Binding CanTakeOverAutomation,
                                     Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StopHint}"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Opacity="0.7"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- What PrintFlow is doing while a stop unwinds. Nothing here is a promise (§21). -->
            <TextBlock Text="{Binding StoppingNotice}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Visibility="{Binding IsStopping, Converter={StaticResource BoolToVisibility}}" />

            <!--
                The Take Over confirmation (§26). It states all four things the operator has to
                know before agreeing: automation stops, Meitu is left as it is, this attempt
                produces no Revision, and coming back needs an explicit return. It deliberately
                does not claim Meitu is safe or finished.
            -->
            <Border BorderThickness="1"
                    BorderBrush="#B0B0B0"
                    Padding="12"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsConfirmingTakeOver, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding TakeOverConfirmQuestion}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding TakeOverConfirmLabel}"
                                Command="{Binding ConfirmTakeOverCommand}"
                                AutomationProperties.AutomationId="Session.TakeOverConfirm"
                                AutomationProperties.Name="{Binding TakeOverConfirmLabel}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding TakeOverCancelLabel}"
                                Command="{Binding CancelTakeOverCommand}"
                                AutomationProperties.AutomationId="Session.TakeOverCancel"
                                AutomationProperties.Name="{Binding TakeOverCancelLabel}"
                                Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                What Meitu may still be holding after a stop (§21, §29). Read from the closed
                attempt row, so it survives the run ending and a restart, and it is absent after
                a stop whose signed cancel positively took effect.
            -->
            <TextBlock Text="{Binding RetainedExternalStateNotice}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasRetainedExternalState,
                                    Converter={StaticResource BoolToVisibility}}" />

            <!--
                Explicit automation re-entry after takeover. SCRUM-11092 / SCRUM-11112 adds
                a separate local manual-result submission; restart never resumes automation.
            -->
            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding ShowsReenterAutomationBlock,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ReenterAutomationHint}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Opacity="0.75" />
                <Button Content="{Binding ReenterAutomationLabel}"
                        Command="{Binding ReenterAutomationCommand}"
                        AutomationProperties.AutomationId="Session.ReenterAutomation"
                        AutomationProperties.Name="{Binding ReenterAutomationLabel}"
                        HorizontalAlignment="Left"
                        Padding="14,6" />
            </StackPanel>

            <!--
                A trim that cannot honestly decide (Epic 11200 Part C1 §17). Shown in addition
                to the failure line above, never instead of it. There is still no fabricated
                "after" beside this message, because no Revision was produced — what Part C2
                adds is the way forward: the button below.
            -->
            <TextBlock Text="{Binding ManualCropNotice}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsManualCropRequired, Converter={StaticResource BoolToVisibility}}" />

            <!--
                Manual Crop (Part C2 §3). Its visibility is CanManualCrop, which the workflow
                layer answers from the session state, the step state and the attempt history —
                this file states no condition of its own, which is what "do not infer eligibility
                in XAML" asks for. It is deliberately not bound to IsManualCropRequired: that
                notice covers only the first of the two openings, and the second — offering
                another crop after one was rejected — has no failure code to show (§21).
            -->
            <Button Content="{Binding BeginManualCropLabel}"
                    Command="{Binding BeginManualCropCommand}"
                    AutomationProperties.AutomationId="Session.BeginManualCrop"
                    AutomationProperties.Name="{Binding BeginManualCropLabel}"
                    HorizontalAlignment="Left"
                    Padding="14,6"
                    Margin="0,0,0,8"
                    Visibility="{Binding CanManualCrop, Converter={StaticResource BoolToVisibility}}" />

        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Step list (§3). -->
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding StepsHeading}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <ItemsControl ItemsSource="{Binding Steps}"
                                  IsTabStop="False"
                                  AutomationProperties.AutomationId="Session.StepList"
                                  AutomationProperties.Name="{Binding StepsHeading}">
                        <!--
                            A row announces the step it is, not the class that produced it: an
                            item's accessible name is read from its generated container, so
                            leaving this unset makes a screen reader say "SessionStepRow".
                        -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Ordinal}" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Opacity="0.8" />

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!--
                Image review (Epic 11200 Part C1 §7–§16). One pane when there is a single
                artefact, two — Before then After — when the Revision on screen was derived
                from one that still exists. The pairing is decided in the workflow layer from
                Revision.SourceRevisionId; this file only lays out what it was given (§9).
            -->
            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <!--
                            The review panes and the crop surface share this row, and exactly one
                            of them is up at a time: while a rectangle is being drawn, the drawing
                            is the task, and leaving the read-only panes beside it would invite a
                            drag on the wrong image.
                        -->
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasPreview}" Value="True" />
                                    <Condition Binding="{Binding IsCropping}" Value="False" />
                                    <!--
                                        And not while the specialist TIFF surface is up
                                        (SCRUM-11104 §14). The two answer different questions and
                                        showing both would put a WIC flattening of the production
                                        file beside PrintFlow's own decode of it — two pictures of
                                        one TIFF, made differently, with nothing on screen to say
                                        which the operator should believe.
                                    -->
                                    <Condition Binding="{Binding HasTiffReview}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding PreviewHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <!-- Zoom (§12) and, through the panes' scrollbars, pan (§13). -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding ZoomLabel}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   MinWidth="52"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />
                        <Button Content="{Binding ZoomOutLabel}"
                                AutomationProperties.AutomationId="Session.ReviewZoomOut"
                                AutomationProperties.Name="{Binding ZoomOutLabel}"
                                Command="{Binding ZoomOutCommand}"
                                IsEnabled="{Binding CanZoomOut}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ZoomInLabel}"
                                AutomationProperties.AutomationId="Session.ReviewZoomIn"
                                AutomationProperties.Name="{Binding ZoomInLabel}"
                                Command="{Binding ZoomInCommand}"
                                IsEnabled="{Binding CanZoomIn}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ResetZoomLabel}"
                                AutomationProperties.AutomationId="Session.ReviewResetZoom"
                                AutomationProperties.Name="{Binding ResetZoomLabel}"
                                Command="{Binding ResetZoomCommand}"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>

                <local:SharedReviewSurface />
            </DockPanel>

            <!--
                The production TIFF inspection surface (SCRUM-11104 §5, §14, §33).

                Same row as the general review panes and shown instead of them, exactly as the
                crop surface is: one artefact, one picture of it. The zoom controls are the
                screen's own, so switching between the two surfaces — or between Colour, White ink
                and Colour + white — never means learning a second zoom.
            -->
            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasTiffReview}" Value="True" />
                                    <Condition Binding="{Binding IsCropping}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding TiffReviewModeHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding ZoomLabel}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   MinWidth="52"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />
                        <Button Content="{Binding ZoomOutLabel}"
                                AutomationProperties.AutomationId="Session.TiffReviewZoomOut"
                                AutomationProperties.Name="{Binding ZoomOutLabel}"
                                Command="{Binding ZoomOutCommand}"
                                IsEnabled="{Binding CanZoomOut}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ZoomInLabel}"
                                AutomationProperties.AutomationId="Session.TiffReviewZoomIn"
                                AutomationProperties.Name="{Binding ZoomInLabel}"
                                Command="{Binding ZoomInCommand}"
                                IsEnabled="{Binding CanZoomIn}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ResetZoomLabel}"
                                AutomationProperties.AutomationId="Session.TiffReviewResetZoom"
                                AutomationProperties.Name="{Binding ResetZoomLabel}"
                                Command="{Binding ResetZoomCommand}"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>

                <local:TiffReviewSurface />
            </DockPanel>

            <!--
                The manual crop surface (Epic 11200 Part C2 §5, §7, §8).

                Same row as the review panes, and shown instead of them. The image is the pane
                the C1 preview seam already produced, drawn exactly as a review pane is — same
                checkerboard, same Uniform/None stretch pair, same zoom transform — so the
                rectangle the operator draws sits over the artwork they were just looking at.

                §8, the interaction, stated: dragging draws a crop rectangle and nothing else.
                There is no drag-to-pan to disable, because panning has always been the
                scrollbars (Part C1 §13); a magnified image is navigated with them, and the
                selection stays on the same artwork because it is stored in source pixels and
                re-projected. There is no spacebar modifier and no transform handle — drawing a
                new rectangle replaces the old one, which is the whole of the MVP interaction.

                CropOverlay sits inside the scrolled content rather than over the ScrollViewer,
                which is what keeps the scrollbars usable and what removes scroll offset from
                the coordinate mapping entirely: a mouse position on this canvas is already a
                position in the scrolled content (see CropSurfaceLayout).
            -->
            <DockPanel Grid.Row="1" Margin="0,14,0,0"
                       Visibility="{Binding IsCropping, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding ManualCropHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowsManualCropControls, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="TrimAdjustHeadingText"
                               DockPanel.Dock="Left"
                               Text="{Binding TrimAdjustHeading}"
                               AutomationProperties.AutomationId="Session.TrimAdjust.Heading"
                               Focusable="True"
                               FocusVisualStyle="{x:Null}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsAdjustingTrim, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Zoom acts on the adjust surface; Compare shows both pictures fitted, so it is hidden there. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding ShowsCropSurface, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ZoomLabel}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   MinWidth="52"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />
                        <Button Content="{Binding ZoomOutLabel}"
                                Command="{Binding ZoomOutCommand}"
                                IsEnabled="{Binding CanZoomOut}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ZoomInLabel}"
                                Command="{Binding ZoomInCommand}"
                                IsEnabled="{Binding CanZoomIn}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ResetZoomLabel}"
                                Command="{Binding ResetZoomCommand}"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <!--
                        Adjusting a trim review (SCRUM-11147). Use this trim is the only control
                        here that reaches the service; it is guarded like Approve so a key or click
                        begun elsewhere never submits. Nothing here approves or saves.
                    -->
                    <StackPanel AutomationProperties.AutomationId="Session.TrimAdjust.Panel"
                                Visibility="{Binding IsAdjustingTrim, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   AutomationProperties.AutomationId="Session.TrimAdjust.Instructions">
                            <Run Text="{Binding TrimAdjustInstructions, Mode=OneWay}" />
                            <Run Text="{Binding TrimAdjustKeyboardHint, Mode=OneWay}" Foreground="#FF5A5A5A" />
                        </TextBlock>
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding TrimAdjustKeptSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,16,0"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Kept" />
                            <TextBlock Text="{Binding TrimAdjustSuggestionSummary}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Suggestion" />
                        </WrapPanel>
                        <TextBlock Text="{Binding TrimAdjustUnchangedNotice}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,4"
                                   AutomationProperties.AutomationId="Session.TrimAdjust.Unchanged"
                                   Visibility="{Binding IsTrimDraftUnchanged, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding TrimAdjustInvalidNotice}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,4"
                                   AutomationProperties.AutomationId="Session.TrimAdjust.Invalid"
                                   Visibility="{Binding IsTrimAdjustInvalid, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding TrimAdjustSourceUnavailableNotice}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"
                                   AutomationProperties.AutomationId="Session.TrimAdjust.SourceUnavailable"
                                   Visibility="{Binding IsTrimSourceUnavailable, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel>
                            <local:ReviewApprovalButton Content="{Binding UseThisTrimLabel}"
                                    Style="{StaticResource RecommendedAction}"
                                    TargetIdentity="{Binding UseThisTrimIdentity}"
                                    Command="{Binding UseThisTrimCommand}"
                                    IsEnabled="{Binding CanUseThisTrim}"
                                    AutomationProperties.AutomationId="Session.TrimAdjust.Use"
                                    AutomationProperties.Name="{Binding UseThisTrimLabel}"
                                    Padding="14,6" Margin="0,0,8,4" />
                            <Button Content="{Binding RestoreSuggestionLabel}"
                                    Command="{Binding RestoreAutomaticSuggestionCommand}"
                                    IsEnabled="{Binding CanRestoreAutomaticSuggestion}"
                                    AutomationProperties.AutomationId="Session.TrimAdjust.Restore"
                                    AutomationProperties.Name="{Binding RestoreSuggestionLabel}"
                                    Padding="14,6" Margin="0,0,8,4" />
                            <Button Content="{Binding CancelTrimAdjustLabel}"
                                    Command="{Binding CancelTrimAdjustCommand}"
                                    AutomationProperties.AutomationId="Session.TrimAdjust.Cancel"
                                    AutomationProperties.Name="{Binding CancelTrimAdjustLabel}"
                                    Padding="14,6" Margin="0,0,16,4" />
                            <!-- Compare / Adjust: which picture the surface shows; nothing is written. -->
                            <Button Content="{Binding TrimCompareToggleLabel}"
                                    Command="{Binding ToggleTrimCompareCommand}"
                                    AutomationProperties.AutomationId="Session.TrimAdjust.CompareToggle"
                                    AutomationProperties.Name="{Binding TrimCompareToggleLabel}"
                                    Padding="10,6" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowsManualCropControls, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ManualCropAdjustmentLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton Content="{Binding ManualCropTightLabel}" IsChecked="{Binding IsManualCropTight}" GroupName="ManualCropMode" Margin="0,0,14,0"
                                     AutomationProperties.AutomationId="Session.ManualCropModeTight" AutomationProperties.Name="{Binding ManualCropTightLabel}" />
                        <RadioButton Content="{Binding ManualCropUniformLabel}" IsChecked="{Binding IsManualCropUniform}" GroupName="ManualCropMode" Margin="0,0,14,0"
                                     AutomationProperties.AutomationId="Session.ManualCropModeUniform" AutomationProperties.Name="{Binding ManualCropUniformLabel}" />
                        <RadioButton Content="{Binding ManualCropPerEdgeLabel}" IsChecked="{Binding IsManualCropPerEdge}" GroupName="ManualCropMode"
                                     AutomationProperties.AutomationId="Session.ManualCropModePerEdge" AutomationProperties.Name="{Binding ManualCropPerEdgeLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding IsManualCropUniform, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding ManualCropUniformMargin, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="5,3"
                                 AutomationProperties.AutomationId="Session.ManualCropUniformMargin" AutomationProperties.Name="{Binding ManualCropUniformLabel}" />
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,6" Visibility="{Binding IsManualCropPerEdge, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding TrimLeftLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ManualCropMarginLeft, UpdateSourceTrigger=PropertyChanged}" Width="52" Padding="5,3" Margin="0,0,10,0"
                                 AutomationProperties.AutomationId="Session.ManualCropMarginLeft" AutomationProperties.Name="{Binding TrimLeftLabel}" />
                        <TextBlock Text="{Binding TrimTopLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ManualCropMarginTop, UpdateSourceTrigger=PropertyChanged}" Width="52" Padding="5,3" Margin="0,0,10,0"
                                 AutomationProperties.AutomationId="Session.ManualCropMarginTop" AutomationProperties.Name="{Binding TrimTopLabel}" />
                        <TextBlock Text="{Binding TrimRightLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ManualCropMarginRight, UpdateSourceTrigger=PropertyChanged}" Width="52" Padding="5,3" Margin="0,0,10,0"
                                 AutomationProperties.AutomationId="Session.ManualCropMarginRight" AutomationProperties.Name="{Binding TrimRightLabel}" />
                        <TextBlock Text="{Binding TrimBottomLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ManualCropMarginBottom, UpdateSourceTrigger=PropertyChanged}" Width="52" Padding="5,3"
                                 AutomationProperties.AutomationId="Session.ManualCropMarginBottom" AutomationProperties.Name="{Binding TrimBottomLabel}" />
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ManualCropInstructions}"
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding CropSelectionSummary}"
                               AutomationProperties.AutomationId="Session.ManualCropSelectedBounds"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding CropAppliedSummary}" AutomationProperties.AutomationId="Session.ManualCropAppliedBounds" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ManualCropMarginInvalidNotice}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding IsManualCropMarginInvalid, Converter={StaticResource BoolToVisibility}}" />

                    <!-- A refused selection says so and stops there; nothing else changes (§23). -->
                    <TextBlock Text="{Binding ManualCropInvalidNotice}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Margin="0,0,0,6"
                               Visibility="{Binding IsCropSelectionInvalid,
                                            Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal">
                        <!--
                            Apply is the only control on this surface that reaches the service.
                            Cancel calls a command that touches nothing at all (§22).
                        -->
                        <Button Content="{Binding ApplyManualCropLabel}"
                                AutomationProperties.AutomationId="Session.ApplyManualCrop" AutomationProperties.Name="{Binding ApplyManualCropLabel}"
                                Command="{Binding ApplyManualCropCommand}"
                                IsEnabled="{Binding CanApplyManualCrop}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding CancelManualCropLabel}"
                                AutomationProperties.AutomationId="Session.CancelManualCrop" AutomationProperties.Name="{Binding CancelManualCropLabel}"
                                Command="{Binding CancelManualCropCommand}"
                                Padding="14,6" />
                    </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid>
                <!--
                    Compare (SCRUM-11147): the result under review beside the proposed trim, both
                    fitted. The proposed image is the pre-trim source's preview cut in memory; the
                    two payloads can differ in display reduction, so they are shown fitted rather
                    than at one shared numeric zoom that would draw them at different scales.
                -->
                <Grid AutomationProperties.AutomationId="Session.TrimAdjust.Compare"
                      Visibility="{Binding ShowsTrimCompare, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TrimAdjustCurrentLabel}" TextWrapping="Wrap"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6"
                                Background="{StaticResource TransparencyCheckerboard}">
                            <Image Source="{Binding TrimAdjustCurrentPane.Payload, Converter={StaticResource PreviewPayload}}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.AutomationId="Session.TrimAdjust.CurrentImage" />
                        </Border>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TrimAdjustProposedLabel}" TextWrapping="Wrap"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6"
                                Background="{StaticResource TransparencyCheckerboard}">
                            <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.AutomationId="Session.TrimAdjust.ProposedImage">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ProposedTrim}">
                                        <Binding Path="TrimAdjustSourcePane.Payload" />
                                        <Binding Path="TrimProposedPayloadRect" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>
                    </DockPanel>
                </Grid>

                <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding DataContext.ShowsCropSurface, RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding CropPane}">
                    <ScrollViewer>
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsFitToViewport,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="True">
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <Grid Background="{StaticResource TransparencyCheckerboard}">
                            <Image Source="{Binding Payload, Converter={StaticResource PreviewPayload}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <Image.LayoutTransform>
                                    <ScaleTransform
                                        ScaleX="{Binding DataContext.ZoomScale,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ScaleY="{Binding DataContext.ZoomScale,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Image.LayoutTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Stretch" Value="None" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsFitToViewport,
                                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Value="True">
                                                <Setter Property="Stretch" Value="Uniform" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!--
                                Transparent so it is hit-testable across the whole surface,
                                including the letterboxed margins. A drag that extends outside
                                the image is refused; only expansion of valid bounds may clamp.
                            -->
                            <Canvas x:Name="CropOverlay"
                                    AutomationProperties.AutomationId="Session.ManualCropSurface"
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    Cursor="Cross">
                                <Rectangle x:Name="CropAppliedOutline" Visibility="Collapsed" Stroke="#FF257749" StrokeThickness="2"
                                           AutomationProperties.AutomationId="Session.ManualCropAppliedOutline" IsHitTestVisible="False" />
                                <Rectangle x:Name="CropSelectionOutline"
                                           AutomationProperties.AutomationId="Session.ManualCropSelectedOutline"
                                           Visibility="Collapsed"
                                           Stroke="#FF1E88E5"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="4 3"
                                           Fill="#221E88E5"
                                           IsHitTestVisible="False" />

                                <!--
                                    Trim adjustment (SCRUM-11147): the picture outside the kept
                                    area is dimmed, the boundary is a light solid line under a
                                    dark dashed one drawn just inside the kept area, and eight
                                    square handles sit inside the boundary so none is cut off
                                    when the boundary lies on the picture border. Positioned by
                                    the code-behind from the source-pixel draft.
                                -->
                                <Rectangle x:Name="TrimDimLeft" Visibility="Collapsed" Fill="#8C000000" IsHitTestVisible="False" />
                                <Rectangle x:Name="TrimDimTop" Visibility="Collapsed" Fill="#8C000000" IsHitTestVisible="False" />
                                <Rectangle x:Name="TrimDimRight" Visibility="Collapsed" Fill="#8C000000" IsHitTestVisible="False" />
                                <Rectangle x:Name="TrimDimBottom" Visibility="Collapsed" Fill="#8C000000" IsHitTestVisible="False" />
                                <Rectangle x:Name="TrimOutlineLight" Visibility="Collapsed" Stroke="White" StrokeThickness="2"
                                           IsHitTestVisible="False" AutomationProperties.AutomationId="Session.TrimAdjust.Outline" />
                                <Rectangle x:Name="TrimOutlineDark" Visibility="Collapsed" Stroke="#FF1A1A1A" StrokeThickness="1"
                                           StrokeDashArray="4 3" IsHitTestVisible="False" />
                                <Thumb x:Name="TrimHandleLeft" Style="{StaticResource TrimHandle}" Cursor="SizeWE" Tag="Left"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.Left" />
                                <Thumb x:Name="TrimHandleTop" Style="{StaticResource TrimHandle}" Cursor="SizeNS" Tag="Top"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.Top" />
                                <Thumb x:Name="TrimHandleRight" Style="{StaticResource TrimHandle}" Cursor="SizeWE" Tag="Right"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.Right" />
                                <Thumb x:Name="TrimHandleBottom" Style="{StaticResource TrimHandle}" Cursor="SizeNS" Tag="Bottom"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.Bottom" />
                                <Thumb x:Name="TrimHandleTopLeft" Style="{StaticResource TrimHandle}" Cursor="SizeNWSE" Tag="TopLeft"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.TopLeft" />
                                <Thumb x:Name="TrimHandleTopRight" Style="{StaticResource TrimHandle}" Cursor="SizeNESW" Tag="TopRight"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.TopRight" />
                                <Thumb x:Name="TrimHandleBottomLeft" Style="{StaticResource TrimHandle}" Cursor="SizeNESW" Tag="BottomLeft"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.BottomLeft" />
                                <Thumb x:Name="TrimHandleBottomRight" Style="{StaticResource TrimHandle}" Cursor="SizeNWSE" Tag="BottomRight"
                                       AutomationProperties.AutomationId="Session.TrimAdjust.Handle.BottomRight" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Border>
                </Grid>
            </DockPanel>

            <!--
                Outputs already produced (§15). Present so an operator adding size B can see
                size A is still there, still approved and still valid. Concise metadata only,
                with no path and no way in — this is not a history browser.
            -->
            <Border Grid.Row="2"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding OutputsHeading}" FontSize="15" FontWeight="SemiBold" />

                    <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,8,0,0"
                                  IsTabStop="False"
                                  AutomationProperties.AutomationId="Session.OutputList"
                                  AutomationProperties.Name="{Binding OutputsHeading}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Validity}"
                                               Margin="12,0,0,0"
                                               Opacity="0.8" />

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Opacity="0.8">
                                        <TextBlock Text="{Binding Size}" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding Branch}" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding Review}" />
                                        <TextBlock Text="  ·  " />

                                        <!--
                                            Where the file actually is (Epic 11400 Part C2B §24,
                                            §25). Working until it is approved, Approved once it
                                            has been, and the Recycle Bin once a rejection has
                                            disposed of it — so the list never offers bytes that
                                            are not there.
                                        -->
                                        <TextBlock Text="{Binding Location}" />
                                    </StackPanel>

                                    <!-- An invalidated output is dimmed, and still says so in words. -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </Grid>

            <ScrollViewer x:Name="SessionDetailsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasNoticeErrorCode, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.AutomationId="Session.ActionFailure">
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <local:NoticeErrorDetails />
                    </StackPanel>
                    <!--
                        Colleague correction (SCRUM-11148). Conditional and compact: the Ask panel
                        (S1) while it is open, the handed-off panel (S3) while the request can be
                        imported, and one history line for a request that no longer can. Every state
                        is stated in words; no button here is a default button, and the two
                        consequential ones use the fresh-gesture guard bound to their exact target.
                    -->
                    <Border BorderBrush="#9BAFC0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                            AutomationProperties.AutomationId="Session.Correction.AskPanel"
                            Visibility="{Binding IsAskingColleague, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding AskColleagueLabel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AskColleagueHint}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,8" />
                            <Label Content="{Binding CorrectionNoteLabel}" Target="{Binding ElementName=CorrectionNoteBox}" Padding="0,0,0,2" />
                            <TextBox x:Name="CorrectionNoteBox"
                                     Text="{Binding CorrectionNote, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False" TextWrapping="Wrap" MaxLength="1000" MinHeight="26"
                                     AutomationProperties.AutomationId="Session.Correction.Note"
                                     AutomationProperties.Name="{Binding CorrectionNoteLabel}" />
                            <TextBlock Text="{Binding CorrectionActivityText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="{Binding IsCorrectionBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CorrectionMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="Session.Correction.AskMessage"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Visibility="{Binding HasCorrectionMessage, Converter={StaticResource BoolToVisibility}}" />
                            <local:NoticeErrorDetails Code="{Binding CorrectionErrorCode}" />
                            <WrapPanel Margin="0,10,0,0">
                                <local:ReviewApprovalButton Content="{Binding CorrectionPrepareLabel}"
                                        TargetIdentity="{Binding AskIdentity}"
                                        Command="{Binding PrepareCorrectionFilesCommand}"
                                        IsEnabled="{Binding CanPrepareCorrection}"
                                        AutomationProperties.AutomationId="Session.Correction.Prepare"
                                        AutomationProperties.Name="{Binding CorrectionPrepareLabel}"
                                        Padding="14,6" Margin="0,0,8,4" />
                                <Button Content="{Binding CorrectionCancelLabel}"
                                        Command="{Binding CancelAskColleagueCommand}"
                                        IsEnabled="{Binding CanCancelAskColleague}"
                                        AutomationProperties.AutomationId="Session.Correction.Cancel"
                                        AutomationProperties.Name="{Binding CorrectionCancelLabel}"
                                        Padding="14,6" Margin="0,0,8,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#9BAFC0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                            AutomationProperties.AutomationId="Session.Correction.Panel"
                            Visibility="{Binding ShowsCorrectionPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock x:Name="CorrectionHeadingText"
                                       Text="{Binding CorrectionStatusText}"
                                       Focusable="True" FocusVisualStyle="{x:Null}"
                                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="Session.Correction.Heading"
                                       AutomationProperties.Name="{Binding CorrectionStatusText}" />
                            <TextBlock Text="{Binding CorrectionLastImportText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding ShowsLastImportUnfinished, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CorrectionStep1Text}" TextWrapping="Wrap" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding CorrectionReferenceText}" TextWrapping="Wrap" Margin="12,0,0,2"
                                       AutomationProperties.AutomationId="Session.Correction.Reference" />
                            <TextBlock Text="{Binding CorrectionWorkingText}" TextWrapping="Wrap" Margin="12,0,0,2"
                                       AutomationProperties.AutomationId="Session.Correction.Working" />
                            <TextBox Text="{Binding CorrectionFolderText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent" Padding="0" Margin="12,0,0,4"
                                     AutomationProperties.AutomationId="Session.Correction.Folder"
                                     AutomationProperties.Name="{Binding CorrectionFolderText}" />
                            <WrapPanel Margin="12,0,0,6">
                                <Button Content="{Binding CorrectionOpenFolderLabel}"
                                        Command="{Binding OpenCorrectionFolderCommand}"
                                        IsEnabled="{Binding CanOpenCorrectionFolder}"
                                        AutomationProperties.AutomationId="Session.Correction.OpenFolder"
                                        AutomationProperties.Name="{Binding CorrectionOpenFolderLabel}"
                                        Padding="12,4" Margin="0,0,8,4" />
                            </WrapPanel>
                            <TextBlock Text="{Binding CorrectionOtherComputerText}" TextWrapping="Wrap" Opacity="0.8" Margin="12,0,0,6" />
                            <TextBlock Text="{Binding CorrectionStep2Text}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CorrectionStep3Text}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CorrectionStep4Text}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Visibility="{Binding ShowsCorrectionMissingFiles, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                <TextBlock Text="{Binding CorrectionMissingFilesText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <Button Content="{Binding CorrectionRepairLabel}"
                                        Command="{Binding RepairCorrectionFilesCommand}"
                                        IsEnabled="{Binding CanRepairCorrectionFiles}"
                                        AutomationProperties.AutomationId="Session.Correction.Repair"
                                        AutomationProperties.Name="{Binding CorrectionRepairLabel}"
                                        HorizontalAlignment="Left" Padding="12,4" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CorrectionActivityText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="{Binding IsCorrectionBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CorrectionMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="Session.Correction.Message"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Visibility="{Binding HasCorrectionMessage, Converter={StaticResource BoolToVisibility}}" />
                            <local:NoticeErrorDetails Code="{Binding CorrectionErrorCode}" />
                            <local:ReviewApprovalButton x:Name="ImportCorrectedButton"
                                    Content="{Binding CorrectionImportLabel}"
                                    TargetIdentity="{Binding ImportIdentity}"
                                    Command="{Binding ImportCorrectedImageCommand}"
                                    IsEnabled="{Binding CanImportCorrectedImage}"
                                    AutomationProperties.AutomationId="Session.Correction.Import"
                                    AutomationProperties.Name="{Binding CorrectionImportLabel}"
                                    HorizontalAlignment="Left" Padding="14,6" FontWeight="SemiBold" />
                            <Expander Header="{Binding CorrectionOtherOptionsLabel}" Margin="0,10,0,0"
                                      AutomationProperties.AutomationId="Session.Correction.OtherOptions"
                                      AutomationProperties.Name="{Binding CorrectionOtherOptionsLabel}"
                                      Visibility="{Binding ShowsReenterAutomationInCorrection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ReenterAutomationHint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6" />
                                    <Button Content="{Binding ReenterAutomationLabel}"
                                            Command="{Binding ReenterAutomationCommand}"
                                            AutomationProperties.AutomationId="Session.Correction.ReenterAutomation"
                                            AutomationProperties.Name="{Binding ReenterAutomationLabel}"
                                            HorizontalAlignment="Left" Padding="12,4" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CorrectionObsoleteText}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"
                               AutomationProperties.AutomationId="Session.Correction.Obsolete"
                               Visibility="{Binding ShowsCorrectionObsolete, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding CorrectionIdenticalText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                               AutomationProperties.AutomationId="Session.Correction.Identical"
                               Visibility="{Binding IsCorrectionIdenticalToSent, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        Final review and save (SCRUM-11145). Present only for a final review, an
                        approved final result or its recorded saves. Every state is stated in
                        words; paths are selectable text; technical identities stay in details.
                        No button here is a default button, and approving or saving buttons use
                        the fresh-gesture input guard bound to the exact target and draft.
                    -->
                    <ContentControl Focusable="False" IsTabStop="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Content" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFinalSave}" Value="True">
                                        <Setter Property="Content" Value="{Binding}" />
                                        <Setter Property="ContentTemplate" Value="{StaticResource FinalSaveTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!--
                        What to check (SCRUM-11149). Read-only guidance for the result under review:
                        the checks, what Approve and Reject do, and where to get help. Collapsed while
                        the Ask panel, the trim editor or a manual crop is the task. The two buttons are
                        the existing entries — same command, same eligibility — so nothing here
                        approves, rejects, prepares, hands off, crops or saves.
                    -->
                    <Border BorderBrush="#9BAFC0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                            AutomationProperties.AutomationId="Session.ReviewGuidance"
                            AutomationProperties.Name="{Binding ReviewGuidanceHeading}"
                            Visibility="{Binding ShowsReviewGuidance, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReviewGuidanceHeading}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ReviewGuidanceChecks}" IsTabStop="False" Margin="0,6,0,0"
                                          AutomationProperties.AutomationId="Session.ReviewGuidance.Checks"
                                          AutomationProperties.Name="{Binding ReviewGuidanceHeading}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="•" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ReviewGuidanceApprove}" TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="Session.ReviewGuidance.Approve" />
                            <TextBlock Text="{Binding ReviewGuidanceReject}" TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="Session.ReviewGuidance.Reject" />
                            <TextBlock Text="{Binding ReviewGuidanceHelp}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="Session.ReviewGuidance.Help" />
                            <Button Content="{Binding AskColleagueLabel}"
                                    Command="{Binding BeginAskColleagueCommand}"
                                    IsEnabled="{Binding CanAskColleague}"
                                    AutomationProperties.AutomationId="Session.ReviewGuidance.AskColleague"
                                    AutomationProperties.Name="{Binding AskColleagueLabel}"
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0"
                                    Visibility="{Binding ShowsGuidanceAskColleague, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding TrimAdjustBeginLabel}"
                                    Command="{Binding BeginTrimAdjustCommand}"
                                    IsEnabled="{Binding CanAdjustTrim}"
                                    AutomationProperties.AutomationId="Session.ReviewGuidance.AdjustTrim"
                                    AutomationProperties.Name="{Binding TrimAdjustBeginLabel}"
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0"
                                    Visibility="{Binding ShowsGuidanceAdjustTrim, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Current artefact metadata (§3): a file name, never a source path. -->
                    <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding ArtefactHeading}" FontSize="15" FontWeight="SemiBold" />

                            <TextBlock Text="{Binding ArtefactNoneText}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasArtefact}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding ArtefactIsInputText}"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding ArtefactIsInput, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding HasArtefact, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding FileNameLabel}" />
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Style="{StaticResource MetadataValue}" Text="{Binding ArtefactFileName}" />
                                    <TextBlock Text="{Binding ManualProcessingResultLabel}" FontWeight="SemiBold"
                                               Visibility="{Binding IsManualProcessingResult, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding FormatLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactFormat}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding PixelsLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactPixels}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding DpiLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactDpi}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding HashLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetadataValue}" FontFamily="Consolas" Text="{Binding ArtefactHash}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding RevisionLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MetadataValue}" FontFamily="Consolas" Text="{Binding ArtefactRevision}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--
                        Background removal, reviewed-content authority (Epic 11300 Part C2B2
                        §3–§9). Visible exactly while CanAuthoriseAutomaticSelection is true,
                        which is the engine's own answer to whether
                        SetBackgroundRemovalDecision would be accepted — this file states no
                        condition of its own, and in particular re-derives no staleness rule
                        (§7).
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanAuthoriseAutomaticSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding BackgroundRemovalHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BackgroundRemovalHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <!--
                                The unauthorised half (§9). An explicit action about the image on
                                screen, not a settings checkbox: nothing here is ticked, and
                                nothing carries over to the next artefact (§4).
                            -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsAutomaticSelectionPending, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding AutomaticSelectionNotAuthorisedNotice}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />

                                <Button Content="{Binding AuthoriseAutomaticSelectionLabel}"
                                        Command="{Binding BeginAutomaticSelectionCommand}"
                                        IsEnabled="{Binding CanBeginAutomaticSelection}"
                                        HorizontalAlignment="Left"
                                        Padding="14,6"
                                        Margin="0,10,0,0" />

                                <!--
                                    The confirmation (§11). It says Meitu decides the subject on
                                    its own and that the result still needs checking; it promises
                                    nothing about quality and claims nothing about later versions
                                    of the image.
                                -->
                                <Border BorderBrush="#33000000"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding IsConfirmingAutomaticSelection, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AutomaticSelectionConfirmQuestion}"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{Binding ConfirmAutomaticSelectionLabel}"
                                                    Command="{Binding ConfirmAutomaticSelectionCommand}"
                                                    Padding="14,6"
                                                    Margin="0,0,8,0" />

                                            <Button Content="{Binding CancelAutomaticSelectionLabel}"
                                                    Command="{Binding CancelAutomaticSelectionCommand}"
                                                    Padding="14,6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--
                                The authorised half (§9). It names the Revision the authority
                                covers, and it disappears of its own accord once the upstream
                                changes — because the read model stops reporting a usable
                                authority, not because this file checks anything.
                            -->
                            <TextBlock Text="{Binding AutomaticSelectionAuthorisedNotice}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"
                                       Visibility="{Binding IsAutomaticSelectionAuthorised, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Readiness, from CanRunBackgroundRemoval and nothing else (§8). -->
                            <TextBlock Text="{Binding BackgroundRemovalRunnableNotice}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding CanRunBackgroundRemoval, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        Trim margin (Epic 11200 Part C3 §9–§12). Visible exactly while
                        CanSetTrimParameters is true, which the workflow layer answers from the
                        engine's legality plus the attempt history — so this panel disappears on
                        a ManualCropRequired outcome without this file stating that rule, and
                        cannot mislead an operator into thinking margin could fix missing alpha
                        (§17).
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanSetTrimParameters, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding TrimHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TrimHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <!--
                                Tight is pre-selected, unlike the W1 selector below. That is the
                                §10 distinction made visible: a trim margin is an operational
                                parameter whose zero is meaningful, and no non-zero safety margin
                                is ever added on the operator's behalf.
                            -->
                            <ListBox ItemsSource="{Binding TrimModes}"
                                     SelectedItem="{Binding SelectedTrimMode}"
                                     DisplayMemberPath="Label"
                                     BorderThickness="0"
                                     Margin="0,8,0,0"
                                     AutomationProperties.AutomationId="Session.TrimModes"
                                     AutomationProperties.Name="{Binding TrimHeading}">
                                <!--
                                    DisplayMemberPath decides what is drawn, not what is read
                                    out: an item announces its own label rather than the class
                                    the label came from.
                                -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Uniform: one non-negative pixel count (§11). -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding IsUniformMargin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding TrimMarginLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Text="{Binding UniformMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Left"
                                         MinWidth="80" />
                            </StackPanel>

                            <!-- Edge-specific: four non-negative pixel counts, kept compact (§12). -->
                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding IsEdgeSpecificMargin, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding TrimTopLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding TopMarginText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding TrimRightLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding RightMarginText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="4"
                                           Text="{Binding TrimBottomLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="4"
                                         Text="{Binding BottomMarginText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="6"
                                           Text="{Binding TrimLeftLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="6"
                                         Text="{Binding LeftMarginText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Button Content="{Binding ApplyTrimMarginLabel}"
                                    Command="{Binding ApplyTrimMarginCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <!-- The persisted decision, so it says what Run Step would do (§18). -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding TrimCurrentLabel}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding PendingTrimSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanChooseFlexibleSize, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SizeHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UsePresetLabel}" Opacity="0.6" Margin="0,8,0,4" />
                            <!-- When each choice fits (SCRUM-11150), beside the choice it explains. -->
                            <TextBlock Text="{Binding PresetModeHelp}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="Session.PrintDimensions.PresetHelp" />
                            <ItemsControl ItemsSource="{Binding SizePresets}"
                                          IsTabStop="False"
                                          AutomationProperties.AutomationId="Session.SizePresetList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button CommandParameter="{Binding}"
                                                Command="{Binding DataContext.UsePresetCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Padding="12,7"
                                                Margin="0,0,6,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RecommendationLabel}"
                                                           FontSize="11"
                                                           Opacity="0.7" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding CustomModeHelp}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,4,0,6"
                                       AutomationProperties.AutomationId="Session.PrintDimensions.CustomHelp" />
                            <Button Content="{Binding CustomSizeLabel}"
                                    Command="{Binding ChooseCustomSizeCommand}"
                                    AutomationProperties.AutomationId="Session.PrintDimensions.CustomSize"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,4,0,0" />

                            <Border BorderBrush="#22000000"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsChoosingCustomSize, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CustomPresetContext}"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding HasCustomPresetContext, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding CustomPresetRecommendation}"
                                               Opacity="0.7"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding HasCustomPresetContext, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding TargetEdgeLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                        <ComboBox Grid.Row="1" Grid.Column="0"
                                                  ItemsSource="{Binding TargetEdgeChoices}"
                                                  SelectedItem="{Binding SelectedTargetEdgeChoice}"
                                                  AutomationProperties.AutomationId="Session.PrintDimensions.TargetEdge"
                                                  AutomationProperties.Name="{Binding TargetEdgeLabel}"
                                                  DisplayMemberPath="Label" />
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding TargetSizeMmLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="1" Grid.Column="2"
                                                 AutomationProperties.AutomationId="Session.PrintDimensions.TargetMillimetres"
                                                 AutomationProperties.Name="{Binding TargetSizeMmLabel}"
                                                 Text="{Binding CustomMillimetresText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <!-- The existing custom-size validation, beside the input it is about. -->
                                    <TextBlock Text="{Binding CustomSizeInputHint}"
                                               TextWrapping="Wrap"
                                               Foreground="#8A5600"
                                               Margin="0,6,0,0"
                                               AutomationProperties.AutomationId="Session.PrintDimensions.TargetSizeHint"
                                               Visibility="{Binding HasCustomSizeInputHint, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding ConfirmCustomSizeLabel}"
                                            Command="{Binding ConfirmCustomSizeCommand}"
                                            AutomationProperties.AutomationId="Session.PrintDimensions.ConfirmSize"
                                            HorizontalAlignment="Left"
                                            Padding="14,6"
                                            Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            AutomationProperties.AutomationId="Session.PrintDimensions.Preflight"
                            Visibility="{Binding HasPrintDimensionsPreflight, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PreflightHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PreflightDraftHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,6"
                                       Visibility="{Binding IsDraftPreflight, Converter={StaticResource BoolToVisibility}}" />
                            <!--
                                The live summary (SCRUM-11150), formatted from this same preflight: the
                                millimetres, what decided them and that proportions are kept.
                            -->
                            <TextBlock Text="{Binding PrintSizeSummary}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="Session.PrintDimensions.Summary"
                                       AutomationProperties.Name="{Binding PrintSizeSummary}" />
                            <TextBlock Text="{Binding PreflightEnlargementNote}"
                                       TextWrapping="Wrap"
                                       Foreground="#8A5600"
                                       Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="Session.PrintDimensions.DraftEnlargementNote"
                                       Visibility="{Binding HasPreflightEnlargementNote, Converter={StaticResource BoolToVisibility}}" />
                            <!-- The unchanged pixel and PPI facts, one click away. View state only. -->
                            <Expander Header="{Binding SizeTechnicalDetailsLabel}"
                                      Margin="0,8,0,0"
                                      AutomationProperties.AutomationId="Session.PrintDimensions.TechnicalDetails"
                                      AutomationProperties.Name="{Binding SizeTechnicalDetailsLabel}">
                            <ItemsControl ItemsSource="{Binding PreflightRows}" IsTabStop="False"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Opacity="0.7" Margin="0,0,10,0" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="{Binding AutomationId}"
                                                       AutomationProperties.Name="{Binding AccessibleName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!--
                        The projected preparation plan (Part B1A.2B §8). Read-only, and shown only
                        while a plan is actually in force — SessionView reports the *usable* plan,
                        so a stale one simply never appears here (§16).
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasPreparationPlan, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PreparationHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentSizeSummary}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CurrentPresetContext}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasCurrentPresetContext, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CurrentRecommendation}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasCurrentRecommendation, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding AdjustSizeLabel}"
                                    Command="{Binding AdjustSizeCommand}"
                                    IsEnabled="{Binding CanAdjustSelectedPreset}"
                                    HorizontalAlignment="Left"
                                    Padding="10,4"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding HasPresetSizeSelection, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding PreparationModeText}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasPreparationModeText, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding PresetLimitNotice}"
                                       TextWrapping="Wrap"
                                       Foreground="#8A5600"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasPresetLimitNotice, Converter={StaticResource BoolToVisibility}}" />

                            <Border BorderBrush="#88B36B00"
                                    Background="#18B36B00"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding NeedsEnlargementAuthority, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EnlargementPlainWarning}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="Session.PrintDimensions.EnlargementWarning" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding ChangeSizeLabel}"
                                                Command="{Binding ChangeSizeCommand}"
                                                Padding="12,5"
                                                Margin="0,0,8,0" />
                                        <Button Content="{Binding ContinueWithSizeLabel}"
                                                Command="{Binding ContinueWithSizeCommand}"
                                                IsEnabled="{Binding CanAuthoriseEnlargement}"
                                                Padding="12,5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding EnlargementConfirmedNotice}"
                                       TextWrapping="Wrap"
                                       Foreground="#2F6B3A"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasUsableEnlargementAuthority, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Readiness from CanRunPhotoshopOutput, never from "a size exists". -->
                            <TextBlock Text="{Binding RunReadinessNotice}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasRunReadinessNotice,
                                                    Converter={StaticResource BoolToVisibility}}" />

                            <!-- The plan's unchanged pixel, PPI and edge facts (SCRUM-11150). View state only. -->
                            <Expander Header="{Binding SizeTechnicalDetailsLabel}"
                                      Margin="0,8,0,0"
                                      AutomationProperties.AutomationId="Session.Preparation.TechnicalDetails"
                                      AutomationProperties.Name="{Binding SizeTechnicalDetailsLabel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PreparationLimitingEdge}"
                                               TextWrapping="Wrap"
                                               Opacity="0.8"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasPreparationLimitingEdge,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding PreparationProjectedSize}"
                                               TextWrapping="Wrap"
                                               Opacity="0.8"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding PreparationResolution}"
                                               TextWrapping="Wrap"
                                               Opacity="0.8"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding EnlargementWarning}"
                                               TextWrapping="Wrap"
                                               Opacity="0.8"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding NeedsEnlargementAuthority, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!--
                        Dimensions that cannot be executed (Part B1A.2B §11–§15). A size decision
                        to redo, not a Photoshop failure: nothing was attempted and nothing was
                        lost. The way back is the ordinary ReturnToStep confirmation below, aimed
                        at the step that owns the decision — there is no second SetPrintDimensions
                        route from here (§12).
                    -->
                    <Border BorderBrush="#55B36B00"
                            Background="#14B36B00"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding NeedsDimensionReview, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DimensionReviewWarning}"
                                       TextWrapping="Wrap" />

                            <!-- Retained millimetres, labelled as history and never as limits. -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasHistoricalBounds,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding HistoricalBoundsLabel}"
                                           TextWrapping="Wrap"
                                           Opacity="0.6"
                                           FontSize="11" />
                                <TextBlock Text="{Binding HistoricalBounds}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                            </StackPanel>

                            <Button Content="{Binding ReviewMaximumBoundsLabel}"
                                    Command="{Binding ReviewMaximumBoundsCommand}"
                                    IsEnabled="{Binding CanReviewMaximumBounds}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <TextBlock Text="{Binding RunReadinessNotice}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasRunReadinessNotice,
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        White underbase (§6, §7). Nothing is pre-selected and nothing is marked
                        recommended: the operator classifies the design and PrintFlow records
                        what they chose.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanSelectWhiteUnderbase, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding WhiteUnderbaseHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WhiteUnderbaseHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <ListBox ItemsSource="{Binding WhiteUnderbaseChoices}"
                                     SelectedItem="{Binding SelectedWhiteUnderbaseChoice}"
                                     DisplayMemberPath="Label"
                                     BorderThickness="0"
                                     Margin="0,8,0,0"
                                     AutomationProperties.AutomationId="Session.WhiteUnderbaseChoices"
                                     AutomationProperties.Name="{Binding WhiteUnderbaseHeading}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Button Content="{Binding ConfirmWhiteUnderbaseLabel}"
                                    Command="{Binding SelectWhiteUnderbaseCommand}"
                                    IsEnabled="{Binding CanConfirmWhiteUnderbase}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding BranchLabel}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConfirmedWhiteUnderbase}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding MaximumBoundsHeading}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConfirmedMaximumBounds}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        Review panel (§9). Metadata and a decision, nothing else: preview,
                        comparison, zoom and crop are Epic 11200.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsReviewRequired, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReviewHeading}" FontSize="15" FontWeight="SemiBold" />

                            <!--
                                What was established about the production TIFF, and the limit of
                                that claim (Epic 11400 Part C2B §22, §23). Collapsed for every
                                other artefact: the sentence is about a CMYK + W1 TIFF, and there
                                is no second review screen — these two lines and the button
                                wording are the whole of what a TIFF changes.
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding IsProductionTiffReview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding TiffReviewSummary}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding TiffReviewCaveat}"
                                           TextWrapping="Wrap"
                                           Opacity="0.65"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!--
                                The production metadata block (SCRUM-11104 §25–§28). Facts only,
                                and only the ones actually recorded: a row a payload could not
                                answer is absent rather than blank, because a blank line beside
                                "Effective source resolution" reads as a measurement of zero.

                                Every row carries the same stable English key as its
                                AutomationId, so a test and a screen reader address it by
                                identity while the operator reads localised wording (§29, §32).
                            -->
                            <ItemsControl ItemsSource="{Binding TiffMetadata}"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="Session.TiffProductionMetadata"
                                          AutomationProperties.Name="{Binding TiffProductionHeading}"
                                          Visibility="{Binding HasTiffReview, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="{Binding Key,
                                                           StringFormat=Session.TiffMetadata.{0}}"
                                                       AutomationProperties.Name="{Binding Label}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                The full managed path, in a control an operator can select and
                                copy with the keyboard (§23, §24). Read-only rather than a label
                                so Ctrl+C works without this screen adding a clipboard action of
                                its own, and so UIA exposes the path as a value a test can read.
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasTiffReview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding TiffOutputPathLabel}" Opacity="0.7" />
                                <TextBox Text="{Binding TiffOutputPath, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextWrapping="Wrap"
                                         Margin="0,2,0,0"
                                         AutomationProperties.AutomationId="Session.TiffOutputPath"
                                         AutomationProperties.Name="{Binding TiffOutputPathLabel}" />
                            </StackPanel>

                            <!--
                                How the result being reviewed was produced (Part C3 §18). Comes
                                from the attempt that produced this exact Revision, so it stays
                                correct after a reject-and-re-run at a different margin; empty,
                                and therefore collapsed, for anything that is not a
                                deterministic trim.
                            -->
                            <TextBlock Text="{Binding TrimParametersSummary}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasTrimParameters, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Margin="0,8,0,0" AutomationProperties.AutomationId="Session.ManualCropReviewMetadata"
                                        Visibility="{Binding HasManualCropGeometry, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ManualCropHeading}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ManualCropReviewSelected}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding ManualCropReviewApplied}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ManualCropReviewMargin}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TrimBoundsCaption}" TextWrapping="Wrap" Opacity="0.65" Margin="0,4,0,0" />
                            </StackPanel>

                            <!--
                                Where the artwork was found, and where the crop was actually
                                taken (SCRUM-11081 §13). Two columns so the operator can read
                                straight across and see what the margin added; both come from
                                the attempt that produced this exact Revision, so a
                                reject-and-re-run at a different margin shows the new rectangle
                                while the superseded attempt keeps its own. Collapsed entirely
                                for anything that established no geometry (a manual crop, a
                                non-trim artefact, or a trim recorded before the geometry was
                                persisted) rather than showing zeroes nobody measured.
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasTrimBounds, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TrimBoundsDetectedHeading}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TrimContentBoundsOrigin}"
                                                   Opacity="0.8"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding TrimContentBoundsExtent}"
                                                   Opacity="0.8" />
                                        <TextBlock Text="{Binding TrimContentBoundsSize}"
                                                   Opacity="0.8" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TrimBoundsAppliedHeading}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TrimAppliedBoundsOrigin}"
                                                   Opacity="0.8"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding TrimAppliedBoundsExtent}"
                                                   Opacity="0.8" />
                                        <TextBlock Text="{Binding TrimAppliedBoundsSize}"
                                                   Opacity="0.8" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding TrimBoundsCaption}"
                                           TextWrapping="Wrap"
                                           Opacity="0.65"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!--
                                The authority the cutout under review was produced under
                                (Epic 11300 Part C2B2 §14, §15). It comes from the producing
                                attempt, which is written once and never rewritten — so a later
                                change to the session's pending authority cannot relabel this
                                result. Empty, and therefore collapsed, for anything that is not
                                an authorised background removal.
                            -->
                            <TextBlock Text="{Binding BackgroundRemovalAttemptAudit}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasBackgroundRemovalAttemptAudit, Converter={StaticResource BoolToVisibility}}" />

                            <!--
                                The preparation plan the output under review was produced under
                                (Epic 11400 Part B1A.2B §19). Same arrangement as the line above:
                                it comes from the producing attempt's immutable snapshot, so the
                                session's *pending* plan moving — after a reject, a different set
                                of limits, an Add Another Size — cannot relabel this result.

                                The projection notice says plainly that no Photoshop run produced
                                these figures. Nothing here claims an actual read-back; that is
                                B1A.3's to record.
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasPreparationAttemptAudit,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PreparationAttemptHeading}"
                                           Opacity="0.6"
                                           FontSize="11" />
                                <TextBlock Text="{Binding PreparationAttemptSelection}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptPresetContext}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptRecommendation}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptBounds}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptPresetOverride}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptResize}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptEnlargementConfirmation}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptProjected}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptProjectionNotice}"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"
                                           FontStyle="Italic"
                                           Visibility="{Binding HasPreparationAttemptProjectionNotice,
                                                        Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding RejectReasonLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding RejectionReasons}"
                                      SelectedItem="{Binding SelectedRejectionReason}"
                                      DisplayMemberPath="Label" />

                            <TextBlock Text="{Binding RejectNotesLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <TextBox Text="{Binding RejectionNotes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="52"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>

                    <!--
                        Return to an earlier step (Epic 11200 Part C3 §3–§5). Visible exactly
                        while the workflow layer offered at least one destination, and the list
                        contains exactly the steps the real ReturnToStep would accept — this
                        file states no legality rule of its own, which is what §4's "do not
                        duplicate ReturnToStep legality in WPF" asks for.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanReturnToStep, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReturnHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ReturnHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <TextBlock Text="{Binding ReturnTargetLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding ReturnTargets}"
                                      SelectedItem="{Binding SelectedReturnTarget}"
                                      DisplayMemberPath="DisplayName" />

                            <Button Content="{Binding BeginReturnLabel}"
                                    Command="{Binding BeginReturnCommand}"
                                    IsEnabled="{Binding CanBeginReturn}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <!--
                                The confirmation (§5). It stands between the selector and the
                                command: nothing is invalidated until Confirm is pressed, and
                                Cancel reaches no service at all. It says results become invalid
                                and history is kept — and says nothing about files, because
                                ReturnToStep deletes none (§6).
                            -->
                            <Border Background="#FFF4CE"
                                    BorderBrush="#E0B000"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsConfirmingReturn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReturnConfirmQuestion}"
                                               TextWrapping="Wrap"
                                               Foreground="#5A4500" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding ConfirmReturnLabel}"
                                                Command="{Binding ConfirmReturnCommand}"
                                                Padding="14,6"
                                                Margin="0,0,8,0" />

                                        <Button Content="{Binding CancelReturnLabel}"
                                                Command="{Binding CancelReturnCommand}"
                                                Padding="14,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
            Actions (§4). Every button's visibility comes from AvailableCommands, which is the
            engine's own answer — the screen states no workflow rule of its own.
        -->
        <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource RecommendedAction}">
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </WrapPanel.Resources>

                <Button Content="{Binding ConfirmOriginalLabel}"
                        Command="{Binding ConfirmOriginalCommand}"
                        AutomationProperties.AutomationId="Session.ConfirmOriginal"
                        AutomationProperties.Name="{Binding ConfirmOriginalLabel}"
                        Visibility="{Binding CanConfirmOriginal, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RunStepLabel}"
                        Command="{Binding RunStepCommand}"
                        AutomationProperties.AutomationId="Session.RunStep"
                        AutomationProperties.Name="{Binding RunStepLabel}"
                        Visibility="{Binding CanRunStep, Converter={StaticResource BoolToVisibility}}" />

                <local:ReviewApprovalButton Content="{Binding ApproveLabel}"
                        Style="{StaticResource {x:Type Button}}"
                        TargetIdentity="{Binding ReviewTargetIdentity}"
                        Command="{Binding ApproveCommand}"
                        AutomationProperties.AutomationId="Session.Approve"
                        AutomationProperties.Name="{Binding ApproveLabel}"
                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" />

                <!--
                    The same Session.Reject everywhere. On background-removal review it is bound to
                    the exact result and guarded against a gesture begun elsewhere (SCRUM-11148);
                    every other step keeps a plain button.
                -->
                <local:ReviewApprovalButton Content="{Binding RejectLabel}"
                        Style="{StaticResource {x:Type Button}}"
                        IsGestureGuarded="{Binding IsRejectGestureGuarded}"
                        TargetIdentity="{Binding RejectTargetIdentity}"
                        Command="{Binding RejectCommand}"
                        AutomationProperties.AutomationId="Session.Reject"
                        AutomationProperties.Name="{Binding RejectLabel}"
                        Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibility}}" />

                <!-- Opens the Ask panel beside the review; writes nothing (SCRUM-11148, D4). -->
                <Button x:Name="AskColleagueButton"
                        Content="{Binding AskColleagueLabel}"
                        ToolTip="{Binding AskColleagueHint}"
                        Command="{Binding BeginAskColleagueCommand}"
                        AutomationProperties.AutomationId="Session.AskColleague"
                        AutomationProperties.Name="{Binding AskColleagueLabel}"
                        AutomationProperties.HelpText="{Binding AskColleagueHint}"
                        Visibility="{Binding CanAskColleague, Converter={StaticResource BoolToVisibility}}" />

                <!-- Opens the trim editor over the pre-trim source; sends nothing (SCRUM-11147). -->
                <Button x:Name="BeginTrimAdjustButton"
                        Content="{Binding TrimAdjustBeginLabel}"
                        Command="{Binding BeginTrimAdjustCommand}"
                        AutomationProperties.AutomationId="Session.TrimAdjust.Begin"
                        AutomationProperties.Name="{Binding TrimAdjustBeginLabel}"
                        Visibility="{Binding CanAdjustTrim, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RetryLabel}"
                        Command="{Binding RetryCommand}"
                        AutomationProperties.AutomationId="Session.Retry"
                        AutomationProperties.Name="{Binding RetryLabel}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding ErrorDetailsLabel}"
                        Command="{Binding OpenErrorDetailsCommand}"
                        AutomationProperties.AutomationId="Session.ErrorDetails"
                        AutomationProperties.Name="{Binding ErrorDetailsLabel}"
                        Visibility="{Binding CanOpenErrorDetails, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding SkipLabel}"
                        Command="{Binding SkipCommand}"
                        AutomationProperties.AutomationId="Session.Skip"
                        AutomationProperties.Name="{Binding SkipLabel}"
                        Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding KeepOriginalExtentLabel}"
                        ToolTip="{Binding KeepOriginalExtentHint}"
                        Command="{Binding KeepOriginalExtentCommand}"
                        AutomationProperties.AutomationId="Session.KeepOriginalExtent"
                        AutomationProperties.Name="{Binding KeepOriginalExtentLabel}"
                        Visibility="{Binding CanKeepOriginalExtent, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding SubmitManualResultLabel}"
                        Command="{Binding SubmitManualResultCommand}"
                        AutomationProperties.AutomationId="Session.SubmitManualResult"
                        AutomationProperties.Name="{Binding SubmitManualResultLabel}"
                        Visibility="{Binding CanSubmitManualResult, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding HandOffLabel}"
                        Command="{Binding HandOffCommand}"
                        AutomationProperties.AutomationId="Session.HandOff"
                        AutomationProperties.Name="{Binding HandOffLabel}"
                        Visibility="{Binding CanHandOff, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding CompleteLabel}"
                        Command="{Binding CompleteCommand}"
                        AutomationProperties.AutomationId="Session.Complete"
                        AutomationProperties.Name="{Binding CompleteLabel}"
                        Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding AddAnotherSizeLabel}"
                        Command="{Binding AddAnotherSizeCommand}"
                        AutomationProperties.AutomationId="Session.AddAnotherSize"
                        AutomationProperties.Name="{Binding AddAnotherSizeLabel}"
                        Visibility="{Binding CanAddAnotherSize, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>

            <Button DockPanel.Dock="Right"
                    Content="{Binding BackLabel}"
                    Command="{Binding BackToHomeCommand}"
                    AutomationProperties.AutomationId="Session.BackToHome"
                    AutomationProperties.Name="{Binding BackLabel}"
                    Padding="14,6" />
        </DockPanel>
    </Grid>
</UserControl>
