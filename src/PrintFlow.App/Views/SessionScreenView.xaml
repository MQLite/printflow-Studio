<UserControl x:Class="PrintFlow.App.Views.SessionScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
             xmlns:local="clr-namespace:PrintFlow.App.Views"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:PreviewPayloadConverter x:Key="PreviewPayload" />

        <Style x:Key="MetadataLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,0,8,2" />
        </Style>

        <Style x:Key="MetadataValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            The transparency checkerboard (§8). Display only: it is a brush painted behind the
            image, so the bytes are never flattened, never composited and never written. Two
            8×8 squares tiled at 16×16, in the conventional light grey pair.
        -->
        <DrawingBrush x:Key="TransparencyCheckerboard"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--
            One preview pane (§7, §11). Used for the single-image state and for both halves of
            a Before/After comparison, so the two can never drift apart in appearance and the
            heading is the only thing that differs.
        -->
        <DataTemplate DataType="{x:Type vm:ArtefactPreviewPane}">
            <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FileName}"
                                   Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!--
                        A preview that could not be produced is a sentence, never a blank box and
                        never a reason for anything else on this screen to stop (§21).
                    -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Unavailable}"
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               FontStyle="Italic"
                               Margin="10,0,10,10"
                               Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}" />

                    <ScrollViewer Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <!--
                                    Panning is scrolling (§13): once the image is larger than the
                                    viewport the ordinary scrollbars appear. While it is fitted
                                    there is nothing off-screen, so they are disabled and the
                                    Image's Uniform stretch has the whole viewport to fit into
                                    (§15).
                                -->
                                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsFitToViewport,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="True">
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <Grid Background="{StaticResource TransparencyCheckerboard}">
                            <Image Source="{Binding Payload, Converter={StaticResource PreviewPayload}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <Image.LayoutTransform>
                                    <!--
                                        The magnification, shared by both panes (§14). Applied to
                                        the displayed element only — no Revision is resampled,
                                        rewritten or re-hashed by zooming (§12).
                                    -->
                                    <ScaleTransform
                                        ScaleX="{Binding DataContext.ZoomScale,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ScaleY="{Binding DataContext.ZoomScale,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Image.LayoutTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <!--
                                            The preview payload is a 96-dpi PNG, so None means one
                                            image pixel per device-independent pixel and "100%"
                                            reads as 100% whatever dpi the artefact records.
                                        -->
                                        <Setter Property="Stretch" Value="None" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsFitToViewport,
                                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Value="True">
                                                <Setter Property="Stretch" Value="Uniform" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Session identity (§3). -->
        <TextBlock Grid.Row="0" Text="{Binding SessionName}" FontSize="24" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0" Opacity="0.85">
            <TextBlock Text="{Binding Workflow}" />
            <TextBlock Text="  ·  " />
            <TextBlock Text="{Binding State}" />
            <TextBlock Text="  ·  " />
            <TextBlock Text="{Binding CurrentStep}" />
        </StackPanel>

        <!--
            The fake-adapter warning (§8). Deliberately loud: an operator must never mistake a
            generated test file for production output.
        -->
        <Border Grid.Row="2"
                Background="#FFF4CE"
                BorderBrush="#E0B000"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,12,0,0"
                Visibility="{Binding IsFakeProcessing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding FakeModeNotice}"
                           TextWrapping="Wrap"
                           Foreground="#5A4500"
                           FontWeight="SemiBold" />

                <!--
                    A synthetic TIFF is the dangerous one: it is named and shaped like
                    something that could be printed, so it says plainly what it is not (§10).
                -->
                <TextBlock Text="{Binding FakeTiffNotice}"
                           TextWrapping="Wrap"
                           Foreground="#5A4500"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsFakeTiffOutput, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- Automation has ended for this session; nothing here restarts it (§14). -->
            <TextBlock Text="{Binding HandedOffNotice}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsHandedOff, Converter={StaticResource BoolToVisibility}}" />

            <!-- The error surface: a localised sentence and a stable code, never a trace (§15). -->
            <TextBlock Text="{Binding Notice}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <!--
                A trim that cannot honestly decide (Epic 11200 Part C1 §17). Shown in addition
                to the failure line above, never instead of it, and offering no crop control:
                the tool arrives in the next slice, and there is no fabricated "after" beside
                this message because no Revision was produced.
            -->
            <TextBlock Text="{Binding ManualCropNotice}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsManualCropRequired, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding PlaceholderNotice}"
                       TextWrapping="Wrap"
                       Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Step list (§3). -->
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding StepsHeading}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Ordinal}" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Opacity="0.8" />

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!--
                Image review (Epic 11200 Part C1 §7–§16). One pane when there is a single
                artefact, two — Before then After — when the Revision on screen was derived
                from one that still exists. The pairing is decided in the workflow layer from
                Revision.SourceRevisionId; this file only lays out what it was given (§9).
            -->
            <DockPanel Grid.Row="1" Margin="0,14,0,0"
                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding PreviewHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <!-- Zoom (§12) and, through the panes' scrollbars, pan (§13). -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding ZoomLabel}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   MinWidth="52"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />
                        <Button Content="{Binding ZoomOutLabel}"
                                Command="{Binding ZoomOutCommand}"
                                IsEnabled="{Binding CanZoomOut}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ZoomInLabel}"
                                Command="{Binding ZoomInCommand}"
                                IsEnabled="{Binding CanZoomIn}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ResetZoomLabel}"
                                Command="{Binding ResetZoomCommand}"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding PreviewPanes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--
                                One row, and as many equal columns as there are panes: a single
                                preview fills the width, and a comparison splits it evenly
                                side by side (§11).
                            -->
                            <primitives:UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>

            <!--
                Outputs already produced (§15). Present so an operator adding size B can see
                size A is still there, still approved and still valid. Concise metadata only,
                with no path and no way in — this is not a history browser.
            -->
            <Border Grid.Row="2"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding OutputsHeading}" FontSize="15" FontWeight="SemiBold" />

                    <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Validity}"
                                               Margin="12,0,0,0"
                                               Opacity="0.8" />

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Opacity="0.8">
                                        <TextBlock Text="{Binding Size}" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding Branch}" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding Review}" />
                                    </StackPanel>

                                    <!-- An invalidated output is dimmed, and still says so in words. -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Current artefact metadata (§3): a file name, never a source path. -->
                    <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding ArtefactHeading}" FontSize="15" FontWeight="SemiBold" />

                            <TextBlock Text="{Binding ArtefactNoneText}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasArtefact}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding ArtefactIsInputText}"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding ArtefactIsInput, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding HasArtefact, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding FileNameLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactFileName}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding FormatLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactFormat}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding PixelsLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactPixels}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding DpiLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactDpi}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding HashLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetadataValue}" FontFamily="Consolas" Text="{Binding ArtefactHash}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding RevisionLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MetadataValue}" FontFamily="Consolas" Text="{Binding ArtefactRevision}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--
                        Print dimensions (§3–§5). Visible exactly while the engine would accept
                        the command, so it appears on the PrintDimensions step and reappears
                        after Add Another Size without this file knowing either rule.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanSetDimensions, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DimensionsHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DimensionsHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <TextBlock Text="{Binding PresetsLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding SizePresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.ApplyPresetCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Padding="10,4"
                                                Margin="0,0,6,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PresetHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.6"
                                       FontStyle="Italic" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding WidthMmLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding WidthMmText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding HeightMmLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding HeightMmText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!-- The pixels the domain derives at 300 dpi; nothing computed here. -->
                            <TextBlock Text="{Binding PendingDimensions}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,8,0,0" />

                            <Button Content="{Binding ConfirmDimensionsLabel}"
                                    Command="{Binding SetDimensionsCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!--
                        White underbase (§6, §7). Nothing is pre-selected and nothing is marked
                        recommended: the operator classifies the design and PrintFlow records
                        what they chose.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanSelectWhiteUnderbase, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding WhiteUnderbaseHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WhiteUnderbaseHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <ListBox ItemsSource="{Binding WhiteUnderbaseChoices}"
                                     SelectedItem="{Binding SelectedWhiteUnderbaseChoice}"
                                     DisplayMemberPath="Label"
                                     BorderThickness="0"
                                     Margin="0,8,0,0" />

                            <Button Content="{Binding ConfirmWhiteUnderbaseLabel}"
                                    Command="{Binding SelectWhiteUnderbaseCommand}"
                                    IsEnabled="{Binding CanConfirmWhiteUnderbase}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding BranchLabel}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConfirmedWhiteUnderbase}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding DimensionsHeading}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConfirmedDimensions}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        Review panel (§9). Metadata and a decision, nothing else: preview,
                        comparison, zoom and crop are Epic 11200.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsReviewRequired, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReviewHeading}" FontSize="15" FontWeight="SemiBold" />

                            <TextBlock Text="{Binding RejectReasonLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding RejectionReasons}"
                                      SelectedItem="{Binding SelectedRejectionReason}"
                                      DisplayMemberPath="Label" />

                            <TextBlock Text="{Binding RejectNotesLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <TextBox Text="{Binding RejectionNotes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="52"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
            Actions (§4). Every button's visibility comes from AvailableCommands, which is the
            engine's own answer — the screen states no workflow rule of its own.
        -->
        <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </WrapPanel.Resources>

                <Button Content="{Binding ConfirmOriginalLabel}"
                        Command="{Binding ConfirmOriginalCommand}"
                        Visibility="{Binding CanConfirmOriginal, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RunStepLabel}"
                        Command="{Binding RunStepCommand}"
                        Visibility="{Binding CanRunStep, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding ApproveLabel}"
                        Command="{Binding ApproveCommand}"
                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RejectLabel}"
                        Command="{Binding RejectCommand}"
                        Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RetryLabel}"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding SkipLabel}"
                        Command="{Binding SkipCommand}"
                        Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding HandOffLabel}"
                        Command="{Binding HandOffCommand}"
                        Visibility="{Binding CanHandOff, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding CompleteLabel}"
                        Command="{Binding CompleteCommand}"
                        Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding AddAnotherSizeLabel}"
                        Command="{Binding AddAnotherSizeCommand}"
                        Visibility="{Binding CanAddAnotherSize, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>

            <Button DockPanel.Dock="Right"
                    Content="{Binding BackLabel}"
                    Command="{Binding BackToHomeCommand}"
                    Padding="14,6" />
        </DockPanel>
    </Grid>
</UserControl>
