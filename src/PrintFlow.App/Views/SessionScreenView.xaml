<UserControl x:Class="PrintFlow.App.Views.SessionScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
             xmlns:local="clr-namespace:PrintFlow.App.Views"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionViewModel}"
             AutomationProperties.AutomationId="Screen.Session"
             AutomationProperties.Name="{Binding SessionName}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:PreviewPayloadConverter x:Key="PreviewPayload" />

        <Style x:Key="MetadataLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,0,8,2" />
        </Style>

        <Style x:Key="MetadataValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            The transparency checkerboard (§8). Display only: it is a brush painted behind the
            image, so the bytes are never flattened, never composited and never written. Two
            8×8 squares tiled at 16×16, in the conventional light grey pair.
        -->
        <DrawingBrush x:Key="TransparencyCheckerboard"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>


    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Session identity (§3). -->
        <TextBlock Grid.Row="0" Text="{Binding SessionName}" FontSize="24" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0" Opacity="0.85">
            <TextBlock Text="{Binding Workflow}" />
            <TextBlock Text="  ·  " />
            <TextBlock Text="{Binding State}" />
            <TextBlock Text="  ·  " />
            <TextBlock Text="{Binding CurrentStep}" />
        </StackPanel>

        <!--
            The fake-adapter warning (§8). Deliberately loud: an operator must never mistake a
            generated test file for production output.
        -->
        <Border Grid.Row="2"
                Background="#FFF4CE"
                BorderBrush="#E0B000"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,12,0,0"
                Visibility="{Binding IsFakeProcessing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding FakeModeNotice}"
                           TextWrapping="Wrap"
                           Foreground="#5A4500"
                           FontWeight="SemiBold" />

                <!--
                    A synthetic TIFF is the dangerous one: it is named and shaped like
                    something that could be printed, so it says plainly what it is not (§10).
                -->
                <TextBlock Text="{Binding FakeTiffNotice}"
                           TextWrapping="Wrap"
                           Foreground="#5A4500"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsFakeTiffOutput, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- Automation has ended for this session; nothing here restarts it (§14). -->
            <TextBlock Text="{Binding HandedOffNotice}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsHandedOff, Converter={StaticResource BoolToVisibility}}" />

            <!-- The error surface: a localised sentence and a stable code, never a trace (§15). -->
            <TextBlock Text="{Binding PdfSourceNotice}" TextWrapping="Wrap" Margin="0,8,0,8"
                       Visibility="{Binding HasPdfSource, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding PsdSourceNotice}" TextWrapping="Wrap" Margin="0,8,0,8"
                       Visibility="{Binding HasPsdSource, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Notice}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <!--
                Stop and Take Over (Epic 11300 Part D2A §24, §25, §27). Both are bound to the
                workflow layer's own answers — CanStopAutomation and CanTakeOverAutomation —
                and this file states no condition of its own. In particular it does NOT bind to
                IsBusy: that is true for every command the screen issues, including an approval,
                and a Stop offered beside a review decision would offer to stop nothing.

                They are two buttons rather than one because they mean different things and
                §27 requires the operator to be able to tell them apart: Stop tries to cancel
                the operation, Take Over leaves Meitu alone. Neither closes Meitu.
            -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8"
                        Visibility="{Binding CanStopAutomation, Converter={StaticResource BoolToVisibility}}">
                <Button Content="{Binding StopLabel}"
                        Command="{Binding StopAutomationCommand}"
                        AutomationProperties.AutomationId="Session.Stop"
                        AutomationProperties.Name="{Binding StopLabel}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="{Binding TakeOverLabel}"
                        Command="{Binding BeginTakeOverCommand}"
                        AutomationProperties.AutomationId="Session.TakeOver"
                        AutomationProperties.Name="{Binding TakeOverLabel}"
                        Padding="14,6"
                        Margin="0,0,12,0"
                        Visibility="{Binding CanTakeOverAutomation,
                                     Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StopHint}"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Opacity="0.7"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- What PrintFlow is doing while a stop unwinds. Nothing here is a promise (§21). -->
            <TextBlock Text="{Binding StoppingNotice}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Visibility="{Binding IsStopping, Converter={StaticResource BoolToVisibility}}" />

            <!--
                The Take Over confirmation (§26). It states all four things the operator has to
                know before agreeing: automation stops, Meitu is left as it is, this attempt
                produces no Revision, and coming back needs an explicit return. It deliberately
                does not claim Meitu is safe or finished.
            -->
            <Border BorderThickness="1"
                    BorderBrush="#B0B0B0"
                    Padding="12"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsConfirmingTakeOver, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding TakeOverConfirmQuestion}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding TakeOverConfirmLabel}"
                                Command="{Binding ConfirmTakeOverCommand}"
                                AutomationProperties.AutomationId="Session.TakeOverConfirm"
                                AutomationProperties.Name="{Binding TakeOverConfirmLabel}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding TakeOverCancelLabel}"
                                Command="{Binding CancelTakeOverCommand}"
                                AutomationProperties.AutomationId="Session.TakeOverCancel"
                                AutomationProperties.Name="{Binding TakeOverCancelLabel}"
                                Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                What Meitu may still be holding after a stop (§21, §29). Read from the closed
                attempt row, so it survives the run ending and a restart, and it is absent after
                a stop whose signed cancel positively took effect.
            -->
            <TextBlock Text="{Binding RetainedExternalStateNotice}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasRetainedExternalState,
                                    Converter={StaticResource BoolToVisibility}}" />

            <!--
                Explicit automation re-entry after takeover. SCRUM-11092 / SCRUM-11112 adds
                a separate local manual-result submission; restart never resumes automation.
            -->
            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding CanReenterAutomation,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ReenterAutomationHint}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Opacity="0.75" />
                <Button Content="{Binding ReenterAutomationLabel}"
                        Command="{Binding ReenterAutomationCommand}"
                        AutomationProperties.AutomationId="Session.ReenterAutomation"
                        AutomationProperties.Name="{Binding ReenterAutomationLabel}"
                        HorizontalAlignment="Left"
                        Padding="14,6" />
            </StackPanel>

            <!--
                A trim that cannot honestly decide (Epic 11200 Part C1 §17). Shown in addition
                to the failure line above, never instead of it. There is still no fabricated
                "after" beside this message, because no Revision was produced — what Part C2
                adds is the way forward: the button below.
            -->
            <TextBlock Text="{Binding ManualCropNotice}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsManualCropRequired, Converter={StaticResource BoolToVisibility}}" />

            <!--
                Manual Crop (Part C2 §3). Its visibility is CanManualCrop, which the workflow
                layer answers from the session state, the step state and the attempt history —
                this file states no condition of its own, which is what "do not infer eligibility
                in XAML" asks for. It is deliberately not bound to IsManualCropRequired: that
                notice covers only the first of the two openings, and the second — offering
                another crop after one was rejected — has no failure code to show (§21).
            -->
            <Button Content="{Binding BeginManualCropLabel}"
                    Command="{Binding BeginManualCropCommand}"
                    AutomationProperties.AutomationId="Session.BeginManualCrop"
                    AutomationProperties.Name="{Binding BeginManualCropLabel}"
                    HorizontalAlignment="Left"
                    Padding="14,6"
                    Margin="0,0,0,8"
                    Visibility="{Binding CanManualCrop, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding PlaceholderNotice}"
                       TextWrapping="Wrap"
                       Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Step list (§3). -->
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding StepsHeading}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <ItemsControl ItemsSource="{Binding Steps}"
                                  IsTabStop="False"
                                  AutomationProperties.AutomationId="Session.StepList"
                                  AutomationProperties.Name="{Binding StepsHeading}">
                        <!--
                            A row announces the step it is, not the class that produced it: an
                            item's accessible name is read from its generated container, so
                            leaving this unset makes a screen reader say "SessionStepRow".
                        -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Ordinal}" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Opacity="0.8" />

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!--
                Image review (Epic 11200 Part C1 §7–§16). One pane when there is a single
                artefact, two — Before then After — when the Revision on screen was derived
                from one that still exists. The pairing is decided in the workflow layer from
                Revision.SourceRevisionId; this file only lays out what it was given (§9).
            -->
            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <!--
                            The review panes and the crop surface share this row, and exactly one
                            of them is up at a time: while a rectangle is being drawn, the drawing
                            is the task, and leaving the read-only panes beside it would invite a
                            drag on the wrong image.
                        -->
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasPreview}" Value="True" />
                                    <Condition Binding="{Binding IsCropping}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding PreviewHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <!-- Zoom (§12) and, through the panes' scrollbars, pan (§13). -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding ZoomLabel}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   MinWidth="52"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />
                        <Button Content="{Binding ZoomOutLabel}"
                                AutomationProperties.AutomationId="Session.ReviewZoomOut"
                                AutomationProperties.Name="{Binding ZoomOutLabel}"
                                Command="{Binding ZoomOutCommand}"
                                IsEnabled="{Binding CanZoomOut}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ZoomInLabel}"
                                AutomationProperties.AutomationId="Session.ReviewZoomIn"
                                AutomationProperties.Name="{Binding ZoomInLabel}"
                                Command="{Binding ZoomInCommand}"
                                IsEnabled="{Binding CanZoomIn}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ResetZoomLabel}"
                                AutomationProperties.AutomationId="Session.ReviewResetZoom"
                                AutomationProperties.Name="{Binding ResetZoomLabel}"
                                Command="{Binding ResetZoomCommand}"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>

                <local:SharedReviewSurface />
            </DockPanel>

            <!--
                The manual crop surface (Epic 11200 Part C2 §5, §7, §8).

                Same row as the review panes, and shown instead of them. The image is the pane
                the C1 preview seam already produced, drawn exactly as a review pane is — same
                checkerboard, same Uniform/None stretch pair, same zoom transform — so the
                rectangle the operator draws sits over the artwork they were just looking at.

                §8, the interaction, stated: dragging draws a crop rectangle and nothing else.
                There is no drag-to-pan to disable, because panning has always been the
                scrollbars (Part C1 §13); a magnified image is navigated with them, and the
                selection stays on the same artwork because it is stored in source pixels and
                re-projected. There is no spacebar modifier and no transform handle — drawing a
                new rectangle replaces the old one, which is the whole of the MVP interaction.

                CropOverlay sits inside the scrolled content rather than over the ScrollViewer,
                which is what keeps the scrollbars usable and what removes scroll offset from
                the coordinate mapping entirely: a mouse position on this canvas is already a
                position in the scrolled content (see CropSurfaceLayout).
            -->
            <DockPanel Grid.Row="1" Margin="0,14,0,0"
                       Visibility="{Binding IsCropping, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding ManualCropHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding ZoomLabel}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   MinWidth="52"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />
                        <Button Content="{Binding ZoomOutLabel}"
                                Command="{Binding ZoomOutCommand}"
                                IsEnabled="{Binding CanZoomOut}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ZoomInLabel}"
                                Command="{Binding ZoomInCommand}"
                                IsEnabled="{Binding CanZoomIn}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Content="{Binding ResetZoomLabel}"
                                Command="{Binding ResetZoomCommand}"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ManualCropInstructions}"
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding CropSelectionSummary}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <!-- A refused selection says so and stops there; nothing else changes (§23). -->
                    <TextBlock Text="{Binding ManualCropInvalidNotice}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Margin="0,0,0,6"
                               Visibility="{Binding IsCropSelectionInvalid,
                                            Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal">
                        <!--
                            Apply is the only control on this surface that reaches the service.
                            Cancel calls a command that touches nothing at all (§22).
                        -->
                        <Button Content="{Binding ApplyManualCropLabel}"
                                Command="{Binding ApplyManualCropCommand}"
                                IsEnabled="{Binding CanApplyManualCrop}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding CancelManualCropLabel}"
                                Command="{Binding CancelManualCropCommand}"
                                Padding="14,6" />
                    </StackPanel>
                </StackPanel>

                <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6"
                        DataContext="{Binding CropPane}">
                    <ScrollViewer>
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsFitToViewport,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="True">
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <Grid Background="{StaticResource TransparencyCheckerboard}">
                            <Image Source="{Binding Payload, Converter={StaticResource PreviewPayload}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <Image.LayoutTransform>
                                    <ScaleTransform
                                        ScaleX="{Binding DataContext.ZoomScale,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ScaleY="{Binding DataContext.ZoomScale,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Image.LayoutTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Stretch" Value="None" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsFitToViewport,
                                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Value="True">
                                                <Setter Property="Stretch" Value="Uniform" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!--
                                Transparent so it is hit-testable across the whole surface,
                                including the letterboxed margins — a drag that begins beside the
                                image and ends on it is still a drag the operator made, and the
                                geometry clamps it to the part that overlaps (§23).
                            -->
                            <Canvas x:Name="CropOverlay"
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    Cursor="Cross">
                                <Rectangle x:Name="CropSelectionOutline"
                                           Visibility="Collapsed"
                                           Stroke="#FF1E88E5"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="4 3"
                                           Fill="#221E88E5"
                                           IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!--
                Outputs already produced (§15). Present so an operator adding size B can see
                size A is still there, still approved and still valid. Concise metadata only,
                with no path and no way in — this is not a history browser.
            -->
            <Border Grid.Row="2"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding OutputsHeading}" FontSize="15" FontWeight="SemiBold" />

                    <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,8,0,0"
                                  IsTabStop="False"
                                  AutomationProperties.AutomationId="Session.OutputList"
                                  AutomationProperties.Name="{Binding OutputsHeading}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Validity}"
                                               Margin="12,0,0,0"
                                               Opacity="0.8" />

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Opacity="0.8">
                                        <TextBlock Text="{Binding Size}" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding Branch}" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding Review}" />
                                        <TextBlock Text="  ·  " />

                                        <!--
                                            Where the file actually is (Epic 11400 Part C2B §24,
                                            §25). Working until it is approved, Approved once it
                                            has been, and the Recycle Bin once a rejection has
                                            disposed of it — so the list never offers bytes that
                                            are not there.
                                        -->
                                        <TextBlock Text="{Binding Location}" />
                                    </StackPanel>

                                    <!-- An invalidated output is dimmed, and still says so in words. -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Current artefact metadata (§3): a file name, never a source path. -->
                    <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding ArtefactHeading}" FontSize="15" FontWeight="SemiBold" />

                            <TextBlock Text="{Binding ArtefactNoneText}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasArtefact}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding ArtefactIsInputText}"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding ArtefactIsInput, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding HasArtefact, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding FileNameLabel}" />
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Style="{StaticResource MetadataValue}" Text="{Binding ArtefactFileName}" />
                                    <TextBlock Text="{Binding ManualProcessingResultLabel}" FontWeight="SemiBold"
                                               Visibility="{Binding IsManualProcessingResult, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding FormatLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactFormat}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding PixelsLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactPixels}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding DpiLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetadataValue}" Text="{Binding ArtefactDpi}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding HashLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetadataValue}" FontFamily="Consolas" Text="{Binding ArtefactHash}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource MetadataLabel}" Text="{Binding RevisionLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MetadataValue}" FontFamily="Consolas" Text="{Binding ArtefactRevision}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--
                        Background removal, reviewed-content authority (Epic 11300 Part C2B2
                        §3–§9). Visible exactly while CanAuthoriseAutomaticSelection is true,
                        which is the engine's own answer to whether
                        SetBackgroundRemovalDecision would be accepted — this file states no
                        condition of its own, and in particular re-derives no staleness rule
                        (§7).
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanAuthoriseAutomaticSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding BackgroundRemovalHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BackgroundRemovalHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <!--
                                The unauthorised half (§9). An explicit action about the image on
                                screen, not a settings checkbox: nothing here is ticked, and
                                nothing carries over to the next artefact (§4).
                            -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsAutomaticSelectionPending, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding AutomaticSelectionNotAuthorisedNotice}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />

                                <Button Content="{Binding AuthoriseAutomaticSelectionLabel}"
                                        Command="{Binding BeginAutomaticSelectionCommand}"
                                        IsEnabled="{Binding CanBeginAutomaticSelection}"
                                        HorizontalAlignment="Left"
                                        Padding="14,6"
                                        Margin="0,10,0,0" />

                                <!--
                                    The confirmation (§11). It says Meitu decides the subject on
                                    its own and that the result still needs checking; it promises
                                    nothing about quality and claims nothing about later versions
                                    of the image.
                                -->
                                <Border BorderBrush="#33000000"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding IsConfirmingAutomaticSelection, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AutomaticSelectionConfirmQuestion}"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{Binding ConfirmAutomaticSelectionLabel}"
                                                    Command="{Binding ConfirmAutomaticSelectionCommand}"
                                                    Padding="14,6"
                                                    Margin="0,0,8,0" />

                                            <Button Content="{Binding CancelAutomaticSelectionLabel}"
                                                    Command="{Binding CancelAutomaticSelectionCommand}"
                                                    Padding="14,6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--
                                The authorised half (§9). It names the Revision the authority
                                covers, and it disappears of its own accord once the upstream
                                changes — because the read model stops reporting a usable
                                authority, not because this file checks anything.
                            -->
                            <TextBlock Text="{Binding AutomaticSelectionAuthorisedNotice}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"
                                       Visibility="{Binding IsAutomaticSelectionAuthorised, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Readiness, from CanRunBackgroundRemoval and nothing else (§8). -->
                            <TextBlock Text="{Binding BackgroundRemovalRunnableNotice}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding CanRunBackgroundRemoval, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        Trim margin (Epic 11200 Part C3 §9–§12). Visible exactly while
                        CanSetTrimParameters is true, which the workflow layer answers from the
                        engine's legality plus the attempt history — so this panel disappears on
                        a ManualCropRequired outcome without this file stating that rule, and
                        cannot mislead an operator into thinking margin could fix missing alpha
                        (§17).
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanSetTrimParameters, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding TrimHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TrimHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <!--
                                Tight is pre-selected, unlike the W1 selector below. That is the
                                §10 distinction made visible: a trim margin is an operational
                                parameter whose zero is meaningful, and no non-zero safety margin
                                is ever added on the operator's behalf.
                            -->
                            <ListBox ItemsSource="{Binding TrimModes}"
                                     SelectedItem="{Binding SelectedTrimMode}"
                                     DisplayMemberPath="Label"
                                     BorderThickness="0"
                                     Margin="0,8,0,0"
                                     AutomationProperties.AutomationId="Session.TrimModes"
                                     AutomationProperties.Name="{Binding TrimHeading}">
                                <!--
                                    DisplayMemberPath decides what is drawn, not what is read
                                    out: an item announces its own label rather than the class
                                    the label came from.
                                -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Uniform: one non-negative pixel count (§11). -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding IsUniformMargin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding TrimMarginLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Text="{Binding UniformMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Left"
                                         MinWidth="80" />
                            </StackPanel>

                            <!-- Edge-specific: four non-negative pixel counts, kept compact (§12). -->
                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding IsEdgeSpecificMargin, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding TrimTopLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding TopMarginText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding TrimRightLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding RightMarginText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="4"
                                           Text="{Binding TrimBottomLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="4"
                                         Text="{Binding BottomMarginText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="6"
                                           Text="{Binding TrimLeftLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="6"
                                         Text="{Binding LeftMarginText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Button Content="{Binding ApplyTrimMarginLabel}"
                                    Command="{Binding ApplyTrimMarginCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <!-- The persisted decision, so it says what Run Step would do (§18). -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding TrimCurrentLabel}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding PendingTrimSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanChooseFlexibleSize, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SizeHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UsePresetLabel}" Opacity="0.6" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding SizePresets}"
                                          IsTabStop="False"
                                          AutomationProperties.AutomationId="Session.SizePresetList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button CommandParameter="{Binding}"
                                                Command="{Binding DataContext.UsePresetCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Padding="12,7"
                                                Margin="0,0,6,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RecommendationLabel}"
                                                           FontSize="11"
                                                           Opacity="0.7" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding CustomSizeLabel}"
                                    Command="{Binding ChooseCustomSizeCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,4,0,0" />

                            <Border BorderBrush="#22000000"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsChoosingCustomSize, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CustomPresetContext}"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding HasCustomPresetContext, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding CustomPresetRecommendation}"
                                               Opacity="0.7"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding HasCustomPresetContext, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding TargetEdgeLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                        <ComboBox Grid.Row="1" Grid.Column="0"
                                                  ItemsSource="{Binding TargetEdgeChoices}"
                                                  SelectedItem="{Binding SelectedTargetEdgeChoice}"
                                                  DisplayMemberPath="Label" />
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding TargetSizeMmLabel}" Opacity="0.6" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="1" Grid.Column="2"
                                                 Text="{Binding CustomMillimetresText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Button Content="{Binding ConfirmCustomSizeLabel}"
                                            Command="{Binding ConfirmCustomSizeCommand}"
                                            HorizontalAlignment="Left"
                                            Padding="14,6"
                                            Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--
                        The projected preparation plan (Part B1A.2B §8). Read-only, and shown only
                        while a plan is actually in force — SessionView reports the *usable* plan,
                        so a stale one simply never appears here (§16).
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasPreparationPlan, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PreparationHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentSizeSummary}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CurrentPresetContext}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasCurrentPresetContext, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CurrentRecommendation}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasCurrentRecommendation, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding AdjustSizeLabel}"
                                    Command="{Binding AdjustSizeCommand}"
                                    IsEnabled="{Binding CanAdjustSelectedPreset}"
                                    HorizontalAlignment="Left"
                                    Padding="10,4"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding HasPresetSizeSelection, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding PreparationModeText}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasPreparationModeText, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding PreparationLimitingEdge}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasPreparationLimitingEdge,
                                                    Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding PreparationProjectedSize}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding PreparationResolution}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,4,0,0" />

                            <TextBlock Text="{Binding PresetLimitNotice}"
                                       TextWrapping="Wrap"
                                       Foreground="#8A5600"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasPresetLimitNotice, Converter={StaticResource BoolToVisibility}}" />

                            <Border BorderBrush="#88B36B00"
                                    Background="#18B36B00"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding NeedsEnlargementAuthority, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EnlargementWarning}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding ChangeSizeLabel}"
                                                Command="{Binding ChangeSizeCommand}"
                                                Padding="12,5"
                                                Margin="0,0,8,0" />
                                        <Button Content="{Binding ContinueWithSizeLabel}"
                                                Command="{Binding ContinueWithSizeCommand}"
                                                IsEnabled="{Binding CanAuthoriseEnlargement}"
                                                Padding="12,5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding EnlargementConfirmedNotice}"
                                       TextWrapping="Wrap"
                                       Foreground="#2F6B3A"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasUsableEnlargementAuthority, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Readiness from CanRunPhotoshopOutput, never from "a size exists". -->
                            <TextBlock Text="{Binding RunReadinessNotice}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasRunReadinessNotice,
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        Dimensions that cannot be executed (Part B1A.2B §11–§15). A size decision
                        to redo, not a Photoshop failure: nothing was attempted and nothing was
                        lost. The way back is the ordinary ReturnToStep confirmation below, aimed
                        at the step that owns the decision — there is no second SetPrintDimensions
                        route from here (§12).
                    -->
                    <Border BorderBrush="#55B36B00"
                            Background="#14B36B00"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding NeedsDimensionReview, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DimensionReviewWarning}"
                                       TextWrapping="Wrap" />

                            <!-- Retained millimetres, labelled as history and never as limits. -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasHistoricalBounds,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding HistoricalBoundsLabel}"
                                           TextWrapping="Wrap"
                                           Opacity="0.6"
                                           FontSize="11" />
                                <TextBlock Text="{Binding HistoricalBounds}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                            </StackPanel>

                            <Button Content="{Binding ReviewMaximumBoundsLabel}"
                                    Command="{Binding ReviewMaximumBoundsCommand}"
                                    IsEnabled="{Binding CanReviewMaximumBounds}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <TextBlock Text="{Binding RunReadinessNotice}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasRunReadinessNotice,
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        White underbase (§6, §7). Nothing is pre-selected and nothing is marked
                        recommended: the operator classifies the design and PrintFlow records
                        what they chose.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanSelectWhiteUnderbase, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding WhiteUnderbaseHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WhiteUnderbaseHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <ListBox ItemsSource="{Binding WhiteUnderbaseChoices}"
                                     SelectedItem="{Binding SelectedWhiteUnderbaseChoice}"
                                     DisplayMemberPath="Label"
                                     BorderThickness="0"
                                     Margin="0,8,0,0"
                                     AutomationProperties.AutomationId="Session.WhiteUnderbaseChoices"
                                     AutomationProperties.Name="{Binding WhiteUnderbaseHeading}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Button Content="{Binding ConfirmWhiteUnderbaseLabel}"
                                    Command="{Binding SelectWhiteUnderbaseCommand}"
                                    IsEnabled="{Binding CanConfirmWhiteUnderbase}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding BranchLabel}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConfirmedWhiteUnderbase}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.8">
                                <TextBlock Text="{Binding MaximumBoundsHeading}" Opacity="0.75" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConfirmedMaximumBounds}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        Review panel (§9). Metadata and a decision, nothing else: preview,
                        comparison, zoom and crop are Epic 11200.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsReviewRequired, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReviewHeading}" FontSize="15" FontWeight="SemiBold" />

                            <!--
                                What was established about the production TIFF, and the limit of
                                that claim (Epic 11400 Part C2B §22, §23). Collapsed for every
                                other artefact: the sentence is about a CMYK + W1 TIFF, and there
                                is no second review screen — these two lines and the button
                                wording are the whole of what a TIFF changes.
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding IsProductionTiffReview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding TiffReviewSummary}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding TiffReviewCaveat}"
                                           TextWrapping="Wrap"
                                           Opacity="0.65"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!--
                                How the result being reviewed was produced (Part C3 §18). Comes
                                from the attempt that produced this exact Revision, so it stays
                                correct after a reject-and-re-run at a different margin; empty,
                                and therefore collapsed, for anything that is not a
                                deterministic trim.
                            -->
                            <TextBlock Text="{Binding TrimParametersSummary}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasTrimParameters, Converter={StaticResource BoolToVisibility}}" />

                            <!--
                                Where the artwork was found, and where the crop was actually
                                taken (SCRUM-11081 §13). Two columns so the operator can read
                                straight across and see what the margin added; both come from
                                the attempt that produced this exact Revision, so a
                                reject-and-re-run at a different margin shows the new rectangle
                                while the superseded attempt keeps its own. Collapsed entirely
                                for anything that established no geometry (a manual crop, a
                                non-trim artefact, or a trim recorded before the geometry was
                                persisted) rather than showing zeroes nobody measured.
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasTrimBounds, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TrimBoundsDetectedHeading}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TrimContentBoundsOrigin}"
                                                   Opacity="0.8"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding TrimContentBoundsExtent}"
                                                   Opacity="0.8" />
                                        <TextBlock Text="{Binding TrimContentBoundsSize}"
                                                   Opacity="0.8" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TrimBoundsAppliedHeading}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TrimAppliedBoundsOrigin}"
                                                   Opacity="0.8"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding TrimAppliedBoundsExtent}"
                                                   Opacity="0.8" />
                                        <TextBlock Text="{Binding TrimAppliedBoundsSize}"
                                                   Opacity="0.8" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding TrimBoundsCaption}"
                                           TextWrapping="Wrap"
                                           Opacity="0.65"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!--
                                The authority the cutout under review was produced under
                                (Epic 11300 Part C2B2 §14, §15). It comes from the producing
                                attempt, which is written once and never rewritten — so a later
                                change to the session's pending authority cannot relabel this
                                result. Empty, and therefore collapsed, for anything that is not
                                an authorised background removal.
                            -->
                            <TextBlock Text="{Binding BackgroundRemovalAttemptAudit}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasBackgroundRemovalAttemptAudit, Converter={StaticResource BoolToVisibility}}" />

                            <!--
                                The preparation plan the output under review was produced under
                                (Epic 11400 Part B1A.2B §19). Same arrangement as the line above:
                                it comes from the producing attempt's immutable snapshot, so the
                                session's *pending* plan moving — after a reject, a different set
                                of limits, an Add Another Size — cannot relabel this result.

                                The projection notice says plainly that no Photoshop run produced
                                these figures. Nothing here claims an actual read-back; that is
                                B1A.3's to record.
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasPreparationAttemptAudit,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PreparationAttemptHeading}"
                                           Opacity="0.6"
                                           FontSize="11" />
                                <TextBlock Text="{Binding PreparationAttemptSelection}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptPresetContext}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptRecommendation}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptBounds}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptPresetOverride}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptResize}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptEnlargementConfirmation}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptProjected}"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <TextBlock Text="{Binding PreparationAttemptProjectionNotice}"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"
                                           FontStyle="Italic"
                                           Visibility="{Binding HasPreparationAttemptProjectionNotice,
                                                        Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding RejectReasonLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding RejectionReasons}"
                                      SelectedItem="{Binding SelectedRejectionReason}"
                                      DisplayMemberPath="Label" />

                            <TextBlock Text="{Binding RejectNotesLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <TextBox Text="{Binding RejectionNotes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="52"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>

                    <!--
                        Return to an earlier step (Epic 11200 Part C3 §3–§5). Visible exactly
                        while the workflow layer offered at least one destination, and the list
                        contains exactly the steps the real ReturnToStep would accept — this
                        file states no legality rule of its own, which is what §4's "do not
                        duplicate ReturnToStep legality in WPF" asks for.
                    -->
                    <Border BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanReturnToStep, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReturnHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ReturnHint}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,6,0,0" />

                            <TextBlock Text="{Binding ReturnTargetLabel}" Opacity="0.6" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding ReturnTargets}"
                                      SelectedItem="{Binding SelectedReturnTarget}"
                                      DisplayMemberPath="DisplayName" />

                            <Button Content="{Binding BeginReturnLabel}"
                                    Command="{Binding BeginReturnCommand}"
                                    IsEnabled="{Binding CanBeginReturn}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,10,0,0" />

                            <!--
                                The confirmation (§5). It stands between the selector and the
                                command: nothing is invalidated until Confirm is pressed, and
                                Cancel reaches no service at all. It says results become invalid
                                and history is kept — and says nothing about files, because
                                ReturnToStep deletes none (§6).
                            -->
                            <Border Background="#FFF4CE"
                                    BorderBrush="#E0B000"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsConfirmingReturn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReturnConfirmQuestion}"
                                               TextWrapping="Wrap"
                                               Foreground="#5A4500" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding ConfirmReturnLabel}"
                                                Command="{Binding ConfirmReturnCommand}"
                                                Padding="14,6"
                                                Margin="0,0,8,0" />

                                        <Button Content="{Binding CancelReturnLabel}"
                                                Command="{Binding CancelReturnCommand}"
                                                Padding="14,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
            Actions (§4). Every button's visibility comes from AvailableCommands, which is the
            engine's own answer — the screen states no workflow rule of its own.
        -->
        <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </WrapPanel.Resources>

                <Button Content="{Binding ConfirmOriginalLabel}"
                        Command="{Binding ConfirmOriginalCommand}"
                        AutomationProperties.AutomationId="Session.ConfirmOriginal"
                        AutomationProperties.Name="{Binding ConfirmOriginalLabel}"
                        Visibility="{Binding CanConfirmOriginal, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RunStepLabel}"
                        Command="{Binding RunStepCommand}"
                        AutomationProperties.AutomationId="Session.RunStep"
                        AutomationProperties.Name="{Binding RunStepLabel}"
                        Visibility="{Binding CanRunStep, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding ApproveLabel}"
                        Command="{Binding ApproveCommand}"
                        AutomationProperties.AutomationId="Session.Approve"
                        AutomationProperties.Name="{Binding ApproveLabel}"
                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RejectLabel}"
                        Command="{Binding RejectCommand}"
                        AutomationProperties.AutomationId="Session.Reject"
                        AutomationProperties.Name="{Binding RejectLabel}"
                        Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding RetryLabel}"
                        Command="{Binding RetryCommand}"
                        AutomationProperties.AutomationId="Session.Retry"
                        AutomationProperties.Name="{Binding RetryLabel}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding SkipLabel}"
                        Command="{Binding SkipCommand}"
                        AutomationProperties.AutomationId="Session.Skip"
                        AutomationProperties.Name="{Binding SkipLabel}"
                        Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding KeepOriginalExtentLabel}"
                        ToolTip="{Binding KeepOriginalExtentHint}"
                        Command="{Binding KeepOriginalExtentCommand}"
                        AutomationProperties.AutomationId="Session.KeepOriginalExtent"
                        AutomationProperties.Name="{Binding KeepOriginalExtentLabel}"
                        Visibility="{Binding CanKeepOriginalExtent, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding SubmitManualResultLabel}"
                        Command="{Binding SubmitManualResultCommand}"
                        AutomationProperties.AutomationId="Session.SubmitManualResult"
                        AutomationProperties.Name="{Binding SubmitManualResultLabel}"
                        Visibility="{Binding CanSubmitManualResult, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding HandOffLabel}"
                        Command="{Binding HandOffCommand}"
                        AutomationProperties.AutomationId="Session.HandOff"
                        AutomationProperties.Name="{Binding HandOffLabel}"
                        Visibility="{Binding CanHandOff, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding CompleteLabel}"
                        Command="{Binding CompleteCommand}"
                        AutomationProperties.AutomationId="Session.Complete"
                        AutomationProperties.Name="{Binding CompleteLabel}"
                        Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="{Binding AddAnotherSizeLabel}"
                        Command="{Binding AddAnotherSizeCommand}"
                        AutomationProperties.AutomationId="Session.AddAnotherSize"
                        AutomationProperties.Name="{Binding AddAnotherSizeLabel}"
                        Visibility="{Binding CanAddAnotherSize, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>

            <Button DockPanel.Dock="Right"
                    Content="{Binding BackLabel}"
                    Command="{Binding BackToHomeCommand}"
                    AutomationProperties.AutomationId="Session.BackToHome"
                    AutomationProperties.Name="{Binding BackLabel}"
                    Padding="14,6" />
        </DockPanel>
    </Grid>
</UserControl>
