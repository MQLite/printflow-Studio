<UserControl x:Class="PrintFlow.App.Views.WorkflowSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PrintFlow.App.Views"
             xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
             mc:Ignorable="d"
             AutomationProperties.AutomationId="Screen.WorkflowSelection"
             AutomationProperties.Name="{Binding Heading}"
             d:DataContext="{d:DesignInstance Type=vm:WorkflowSelectionViewModel}">

    <UserControl.Resources>
        <local:PreviewPayloadConverter x:Key="PreviewPayload" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            The same transparency checkerboard the review surface paints (Part C1 §8), for the
            same reason: it is a brush behind the image, so transparent artwork is shown as
            transparent and the bytes are never flattened, composited or written.
        -->
        <DrawingBrush x:Key="TransparencyCheckerboard"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" />

        <!--
            The source context: what was imported, what it looks like, and what the produced
            files will be called (SCRUM-11078 §11, §12; SCRUM-11075). The preview is
            informational — it issues no command and creates nothing (§13).
        -->
        <Grid Grid.Row="1" Margin="0,10,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="180"
                    Height="140"
                    Margin="0,0,16,0"
                    AutomationProperties.AutomationId="WorkflowSelection.Preview"
                    AutomationProperties.Name="{Binding PreviewHeading}">
                <Grid>
                    <Grid Background="{StaticResource TransparencyCheckerboard}"
                          Visibility="{Binding Preview.HasImage, Converter={StaticResource BoolToVisibility},
                                               FallbackValue=Collapsed}">
                        <Image Source="{Binding Preview.Payload, Converter={StaticResource PreviewPayload}}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform"
                               Margin="6"
                               AutomationProperties.Name="{Binding PreviewHeading}" />
                    </Grid>

                    <TextBlock Text="{Binding Preview.Unavailable}"
                               Visibility="{Binding Preview.IsUnavailable, Converter={StaticResource BoolToVisibility},
                                                    FallbackValue=Collapsed}"
                               TextWrapping="Wrap"
                               Margin="10"
                               Opacity="0.75"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding SourceFileLabel}" Opacity="0.7" />
                <TextBlock Text="{Binding SourceFileName}"
                           AutomationProperties.AutomationId="WorkflowSelection.SourceFile"
                           AutomationProperties.Name="{Binding SourceFileName}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,2" />

                <!-- The pixel figures the preview seam reported, reduced-for-display note included. -->
                <TextBlock Text="{Binding Preview.Detail}"
                           AutomationProperties.AutomationId="WorkflowSelection.PreviewDetail"
                           Opacity="0.7"
                           Margin="0,0,0,10" />

                <TextBlock Text="{Binding OutputNameLabel}" Opacity="0.7" />
                <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditOutputName}"
                         AutomationProperties.AutomationId="WorkflowSelection.OutputName"
                         AutomationProperties.Name="{Binding OutputNameLabel}"
                         AutomationProperties.HelpText="{Binding OutputNameHint}"
                         MaxWidth="420"
                         HorizontalAlignment="Left"
                         Padding="6,4"
                         Margin="0,2,0,4" />

                <TextBlock Text="{Binding OutputNameHint}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           MaxWidth="480"
                           HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.7" />

                <ItemsControl ItemsSource="{Binding Workflows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#33000000"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Margin="8,1,0,1" Opacity="0.8" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Enabled by the engine's own AvailableCommands, so the button
                                         is offered on exactly the rule that would accept it (§7).
                                         The identity comes from the catalogue entry's workflow type
                                         and never from its translated title (§22). -->
                                    <Button Grid.Column="1"
                                            Content="{Binding DataContext.SelectLabel,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Command="{Binding DataContext.SelectCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.CanSelect,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}"
                                            AutomationProperties.Name="{Binding Title}"
                                            VerticalAlignment="Center"
                                            Padding="16,6" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding Notice}"
                       AutomationProperties.AutomationId="WorkflowSelection.Notice"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Button Content="{Binding BackLabel}"
                    Command="{Binding BackToHomeCommand}"
                    AutomationProperties.AutomationId="WorkflowSelection.Back"
                    AutomationProperties.Name="{Binding BackLabel}"
                    Padding="14,6"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
