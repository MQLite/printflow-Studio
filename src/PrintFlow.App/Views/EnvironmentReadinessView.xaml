<UserControl x:Class="PrintFlow.App.Views.EnvironmentReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EnvironmentReadinessViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            One row template, used by all three lists. Blocking and advisory rows are told apart
            by the report's own IsBlocking flag rather than by anything decided here (§5).
        -->
        <DataTemplate x:Key="CheckRowTemplate">
            <Border BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="6,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <!-- Stable English beside the localised name, never instead of it. -->
                            <TextBlock Text="{Binding SupportKey}" Opacity="0.45" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding Explanation}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,12,0"
                                   Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding Detail}"
                                   TextWrapping="Wrap"
                                   Opacity="0.65"
                                   Margin="0,2,12,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Classification}"
                               Opacity="0.7"
                               Margin="0,0,14,0"
                               VerticalAlignment="Top" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Status}"
                               FontWeight="SemiBold"
                               MinWidth="70"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" />
            <!-- The only thing this screen can do: ask the gate to look again (§4). -->
            <Button DockPanel.Dock="Right"
                    Content="{Binding RefreshLabel}"
                    Command="{Binding RefreshCommand}"
                    Padding="14,6" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,12" />

        <!-- Overall state, then advisories beside it rather than mixed into it (§5). -->
        <Border Grid.Row="2"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AdvisorySummary}" Margin="0,4,0,0" Opacity="0.8" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.85">
                    <TextBlock Text="{Binding PresetLabel}" />
                    <TextBlock Text=": " />
                    <TextBlock Text="{Binding PresetIdentity}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Opacity="0.85">
                    <TextBlock Text="{Binding ObservedAtLabel}" />
                    <TextBlock Text=": " />
                    <TextBlock Text="{Binding ObservedAt}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding BlockingHeading}" FontSize="16" FontWeight="SemiBold" />

                <TextBlock Text="{Binding NoBlockingFailuresText}"
                           Opacity="0.7"
                           Margin="0,4,0,0"
                           Visibility="{Binding HasNoBlockingFailures, Converter={StaticResource BoolToVisibility}}" />

                <!-- Every failed blocking check, not only the first: an operator repairing the
                     workstation needs the whole list (§3). -->
                <ItemsControl ItemsSource="{Binding BlockingFailures}"
                              ItemTemplate="{StaticResource CheckRowTemplate}"
                              Margin="0,4,0,0" />

                <TextBlock Text="{Binding AdvisoriesHeading}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,18,0,0"
                           Visibility="{Binding HasAdvisories, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Advisories}"
                              ItemTemplate="{StaticResource CheckRowTemplate}"
                              Margin="0,4,0,0" />

                <TextBlock Text="{Binding ChecksHeading}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,18,0,0" />

                <ItemsControl ItemsSource="{Binding Checks}"
                              ItemTemplate="{StaticResource CheckRowTemplate}"
                              Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <!-- What Refresh does, and what it does not do. The two are deliberately separate
                 sentences: dynamic facts are re-observed, accepted files are not (§8). -->
            <TextBlock Text="{Binding RefreshScope}" TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="{Binding RestartRequirement}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,6,0,10" />

            <Button Content="{Binding BackLabel}"
                    Command="{Binding BackToHomeCommand}"
                    Padding="14,6"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
