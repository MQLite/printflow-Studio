<UserControl x:Class="PrintFlow.App.Views.EnvironmentReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrintFlow.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EnvironmentReadinessViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            One row template, used by all three lists. Blocking and advisory rows are told apart
            by the report's own IsBlocking flag rather than by anything decided here (§5).
        -->
        <DataTemplate x:Key="CheckRowTemplate">
            <Border BorderBrush="#22000000"
                    BorderThickness="0,0,0,1"
                    Padding="6,8"
                    AutomationProperties.AutomationId="{Binding AutomationId}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Explanation}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,12,0"
                                   Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}" />

                        <Expander Header="{Binding DetailsLabel}" IsExpanded="False"
                                  AutomationProperties.AutomationId="{Binding DetailsAutomationId}"
                                  Margin="0,4,12,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SupportKey}" Opacity="0.65" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}"
                                           TextWrapping="Wrap"
                                           Opacity="0.65"
                                           Margin="0,2,12,0" />

                                <TextBlock Text="{Binding ExpectedDisplay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,2,12,0"
                                           Visibility="{Binding HasExpected, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding CurrentDisplay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,2,12,0"
                                           Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Classification}"
                               Opacity="0.7"
                               Margin="0,0,14,0"
                               VerticalAlignment="Top" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Status}"
                               FontWeight="SemiBold"
                               MinWidth="70"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="{Binding RunLiveChecksLabel}"
                        Command="{Binding RunLiveChecksCommand}"
                        AutomationProperties.AutomationId="Environment.RunLiveChecks"
                        ToolTip="{Binding RunLiveChecksHint}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="{Binding CancelLiveChecksLabel}"
                        Command="{Binding CancelLiveChecksCommand}"
                        AutomationProperties.AutomationId="Environment.CancelLiveChecks"
                        Visibility="{Binding IsRunningLiveChecks, Converter={StaticResource BoolToVisibility}}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="{Binding RefreshLabel}"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.AutomationId="Environment.Refresh"
                        Padding="14,6" />
            </WrapPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,12" />

        <!-- Overall state, then advisories beside it rather than mixed into it (§5). -->
        <Border Grid.Row="2"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Environment.Status" />
                <TextBlock Text="{Binding CheckActivityText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           AutomationProperties.AutomationId="Environment.Activity" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,4"
                             AutomationProperties.AutomationId="Environment.Progress"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding AdvisorySummary}" Margin="0,4,0,0" Opacity="0.8" />

                <Expander Header="{Binding DetailsLabel}" IsExpanded="False" Margin="0,6,0,0"
                          AutomationProperties.AutomationId="Environment.ReportDetails">
                    <StackPanel>
                        <TextBlock Text="{Binding PresetLabel}" Opacity="0.85" />
                        <TextBlock Text="{Binding PresetIdentity}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Opacity="0.85">
                    <TextBlock Text="{Binding ObservedAtLabel}" />
                    <TextBlock Text=": " />
                    <TextBlock Text="{Binding ObservedAt}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding BlockingHeading}" FontSize="16" FontWeight="SemiBold" />

                <TextBlock Text="{Binding NoBlockingFailuresText}"
                           Opacity="0.7"
                           Margin="0,4,0,0"
                           Visibility="{Binding HasNoBlockingFailures, Converter={StaticResource BoolToVisibility}}" />

                <!-- Every failed blocking check, not only the first: an operator repairing the
                     workstation needs the whole list (§3). -->
                <ItemsControl ItemsSource="{Binding BlockingFailures}"
                              ItemTemplate="{StaticResource CheckRowTemplate}"
                              Margin="0,4,0,0" />

                <TextBlock Text="{Binding AdvisoriesHeading}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,18,0,0"
                           Visibility="{Binding HasAdvisories, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Advisories}"
                              ItemTemplate="{StaticResource CheckRowTemplate}"
                              Margin="0,4,0,0" />

                <Expander Header="{Binding ChecksHeading}" IsExpanded="False" Margin="0,18,0,0"
                          AutomationProperties.AutomationId="Environment.AllChecks">
                    <StackPanel>
                        <TextBlock Text="{Binding AutomaticChecksHeading}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0" />

                        <ItemsControl ItemsSource="{Binding AutomaticChecks}"
                                      AutomationProperties.AutomationId="EnvironmentAutomaticChecks"
                                      ItemTemplate="{StaticResource CheckRowTemplate}"
                                      Margin="0,4,0,0" />

                        <TextBlock Text="{Binding LiveChecksHeading}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,0" />

                        <ItemsControl ItemsSource="{Binding LiveApplicationChecks}"
                                      AutomationProperties.AutomationId="EnvironmentLiveChecks"
                                      ItemTemplate="{StaticResource CheckRowTemplate}"
                                      Margin="0,4,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <!-- What Refresh does, and what it does not do. The two are deliberately separate
                 sentences: dynamic facts are re-observed, accepted files are not (§8). -->
            <TextBlock Text="{Binding RefreshScope}" TextWrapping="Wrap" Opacity="0.75" />
            <Expander Header="{Binding RestartHelpLabel}" IsExpanded="False" Margin="0,6,0,10"
                      AutomationProperties.AutomationId="Environment.RestartHelp">
                <TextBlock Text="{Binding RestartRequirement}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            </Expander>

            <Button Content="{Binding BackLabel}"
                    Command="{Binding BackToHomeCommand}"
                    AutomationProperties.AutomationId="Environment.BackToHome"
                    Padding="14,6"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
