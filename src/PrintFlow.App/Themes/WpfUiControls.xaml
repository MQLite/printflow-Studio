<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Self-contained dependency order; no production Application is required. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="GuidedTheme.xaml" />
    <ui:ThemesDictionary Theme="Light" />
    <ui:ControlsDictionary />
    <ResourceDictionary Source="WpfUiTokens.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- Vendor token adapters mirror the canonical PF values (pinned by contract tests).
       BAML requires concrete Color/CornerRadius entries rather than keyed resource extensions. -->
  <Color x:Key="SystemAccentColorPrimary">#16765D</Color>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{DynamicResource PF.Color.Primary}" />
  <Style x:Key="PF.Button.Secondary" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="{DynamicResource PF.Control.MinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Button}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource PF.Focus}" />
  </Style>
  <Style x:Key="PF.Button.Primary" TargetType="Button" BasedOn="{StaticResource PF.Button.Secondary}">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PF.Brush.PrimaryHover}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PF.Brush.PrimaryPressed}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PF.Button.Danger" TargetType="Button" BasedOn="{StaticResource PF.Button.Secondary}">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Danger}" />
  </Style>
  <Style x:Key="PF.Input.TextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="{DynamicResource PF.Control.MinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Field}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource PF.Focus}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="PF.Input.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="MinHeight" Value="{DynamicResource PF.Control.MinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Field}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource PF.Focus}" />
  </Style>
  <Style x:Key="PF.Input.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
    <Setter Property="MinHeight" Value="{DynamicResource PF.Control.MinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Choice}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource PF.Focus}" />
  </Style>
  <Style x:Key="PF.Input.RadioButton" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
    <Setter Property="MinHeight" Value="{DynamicResource PF.Control.MinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Choice}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource PF.Focus}" />
  </Style>
  <Style x:Key="PF.Disclosure" TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
    <Setter Property="MinHeight" Value="{DynamicResource PF.Control.MinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource PF.Focus}" />
  </Style>

</ResourceDictionary>
