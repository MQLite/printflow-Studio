<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WpfUiControls.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="PF.Card.Fluent" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.FluentCard}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
  </Style>
  <Style x:Key="PF.Icon" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="{DynamicResource PF.Icon.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Primary}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- Inline confirmation. Callers own neutral focus, commands and cancellation. -->
  <Style x:Key="PF.Dialog" TargetType="HeaderedContentControl" BasedOn="{StaticResource PF.TaskCard}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
  </Style>
  <Style x:Key="PF.StepNavigation.Compact" TargetType="ItemsControl" BasedOn="{StaticResource PF.StepNavigation}">
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <Border x:Name="CompactStep" Padding="8,8" Margin="0,0,0,6" CornerRadius="{DynamicResource PF.Corner.Control}"
                  Background="{DynamicResource PF.Brush.Surface}" BorderBrush="{DynamicResource PF.Brush.Border}" BorderThickness="1"
                  ToolTip="{Binding Detail}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="CompactStepNumber" Text="{Binding Number}" FontWeight="SemiBold" Foreground="{DynamicResource PF.Brush.Muted}" />
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="CompactStepTitle" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="{DynamicResource PF.Font.Auxiliary}"
                           Foreground="{DynamicResource PF.Brush.Muted}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Number}" Value="0"><Setter TargetName="CompactStepNumber" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Current">
              <Setter TargetName="CompactStep" Property="Background" Value="{DynamicResource PF.Brush.Selection}" />
              <Setter TargetName="CompactStep" Property="BorderBrush" Value="{DynamicResource PF.Brush.Primary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="CompactStep" Property="BorderThickness" Value="2" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Attention">
              <Setter TargetName="CompactStep" Property="Background" Value="{DynamicResource PF.Brush.Warning}" />
              <Setter TargetName="CompactStep" Property="BorderBrush" Value="{DynamicResource PF.Brush.WarningInk}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- PF.PageHeader, Card, Notice.*, Progress and ActionBar preserve GuidedTheme contracts. Notices remain persistent content, with no timer or automatic dismissal. -->

</ResourceDictionary>
