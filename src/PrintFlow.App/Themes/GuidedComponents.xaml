<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:PrintFlow.App.Controls">
  <Style x:Key="PF.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PF.Corner.Card}" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Card}" />
  </Style>

  <Style x:Key="PF.PageHeader" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <ControlTemplate.Resources>
            <DataTemplate DataType="{x:Type sys:String}"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
          </ControlTemplate.Resources>
          <StackPanel>
            <TextBlock Text="{TemplateBinding Header}" FontSize="{DynamicResource PF.Font.Title}"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <ContentPresenter x:Name="Description" ContentSource="Content" Margin="0,8,0,0"
                              TextElement.Foreground="{DynamicResource PF.Brush.Muted}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Description" Property="Visibility" Value="Collapsed" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PF.TaskCard" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Card}" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <ControlTemplate.Resources>
            <DataTemplate DataType="{x:Type sys:String}"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
          </ControlTemplate.Resources>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource PF.Corner.Card}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel>
              <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
              <ContentPresenter ContentSource="Content" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PF.FormSection" TargetType="HeaderedContentControl" BasedOn="{StaticResource PF.TaskCard}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="PF.Notice.Info" TargetType="HeaderedContentControl" BasedOn="{StaticResource PF.TaskCard}">
    <Style.Resources>
      <Geometry x:Key="PF.Notice.Geometry">M10,1 A9,9 0 1 1 9.99,1 M10,5 L10,6 M10,9 L10,15</Geometry>
    </Style.Resources>
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Selection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Primary}" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Field}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <ControlTemplate.Resources>
            <DataTemplate DataType="{x:Type sys:String}"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
          </ControlTemplate.Resources>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource PF.Corner.Control}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Path Data="{DynamicResource PF.Notice.Geometry}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"
                    Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0"
                    IsHitTestVisible="False" Focusable="False" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ContentPresenter x:Name="Explanation" ContentSource="Content" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Explanation" Property="Visibility" Value="Collapsed" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PF.Notice.Warning" TargetType="HeaderedContentControl" BasedOn="{StaticResource PF.Notice.Info}">
    <Style.Resources><Geometry x:Key="PF.Notice.Geometry">M10,1 L19,18 L1,18 Z M10,6 L10,11 M10,14 L10,15</Geometry></Style.Resources>
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Warning}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.WarningInk}" />
  </Style>
  <Style x:Key="PF.Notice.Error" TargetType="HeaderedContentControl" BasedOn="{StaticResource PF.Notice.Info}">
    <Style.Resources><Geometry x:Key="PF.Notice.Geometry">M6,1 L14,1 L19,6 L19,14 L14,19 L6,19 L1,14 L1,6 Z M6,6 L14,14 M6,14 L14,6</Geometry></Style.Resources>
    <Setter Property="Background" Value="{DynamicResource PF.Brush.ErrorSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Danger}" />
  </Style>
  <Style x:Key="PF.Notice.Success" TargetType="HeaderedContentControl" BasedOn="{StaticResource PF.Notice.Info}">
    <Style.Resources><Geometry x:Key="PF.Notice.Geometry">M10,1 A9,9 0 1 1 9.99,1 M5,10 L9,14 L15,6</Geometry></Style.Resources>
  </Style>

  <!-- The page owns the Auto grid row; the component never chooses an action or takes focus. -->
  <Style x:Key="PF.ActionBar" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="{DynamicResource PF.Padding.Field}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Content" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A read-only projection. No selector, button, input binding or command lives here. -->
  <Style x:Key="PF.StepNavigation" TargetType="ItemsControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource PF.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource PF.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Ink}" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value><Style TargetType="ContentPresenter"><Setter Property="Focusable" Value="False" /></Style></Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate DataType="{x:Type controls:GuidedStepItem}">
          <Border x:Name="StepSurface" Background="{DynamicResource PF.Brush.Surface}"
                  BorderBrush="{DynamicResource PF.Brush.Border}" BorderThickness="1"
                  CornerRadius="{DynamicResource PF.Corner.Control}" Padding="12" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="StepMarker" Text="○" Foreground="{DynamicResource PF.Brush.Muted}"
                         FontWeight="Bold" Margin="0,0,8,0" />
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="StepTitle" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="StepDetail" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource PF.Brush.Muted}" FontSize="{DynamicResource PF.Font.Auxiliary}" />
                <TextBlock x:Name="StepStatus" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           FontSize="{DynamicResource PF.Font.Auxiliary}" />
              </StackPanel>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:GuidedStepState.Current}">
              <Setter TargetName="StepMarker" Property="Text" Value="●" />
              <Setter TargetName="StepMarker" Property="Foreground" Value="{DynamicResource PF.Brush.Primary}" />
              <Setter TargetName="StepSurface" Property="Background" Value="{DynamicResource PF.Brush.Selection}" />
              <Setter TargetName="StepSurface" Property="BorderBrush" Value="{DynamicResource PF.Brush.Primary}" />
              <Setter TargetName="StepSurface" Property="BorderThickness" Value="2" />
              <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource PF.Brush.Primary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:GuidedStepState.Completed}">
              <Setter TargetName="StepMarker" Property="Text" Value="✓" />
              <Setter TargetName="StepMarker" Property="Foreground" Value="{DynamicResource PF.Brush.Primary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:GuidedStepState.Attention}">
              <Setter TargetName="StepMarker" Property="Text" Value="!" />
              <Setter TargetName="StepMarker" Property="Foreground" Value="{DynamicResource PF.Brush.WarningInk}" />
              <Setter TargetName="StepSurface" Property="Background" Value="{DynamicResource PF.Brush.Warning}" />
              <Setter TargetName="StepSurface" Property="BorderBrush" Value="{DynamicResource PF.Brush.WarningInk}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:GuidedStepState.Skipped}">
              <Setter TargetName="StepMarker" Property="Text" Value="—" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
