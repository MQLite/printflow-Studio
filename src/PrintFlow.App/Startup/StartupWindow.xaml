<Window x:Class="PrintFlow.App.Startup.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="340"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PF.Brush.Canvas}" Foreground="{DynamicResource PF.Brush.Ink}"
        FontFamily="{DynamicResource PF.Font.Family}"
        AutomationProperties.AutomationId="PrintFlow.StartupWindow"
        AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource Self}}">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Resources/PrintFlowMark.png" Width="48" Height="48" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProductName" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="Status" FontSize="14" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>
        <ProgressBar Height="4" Margin="0,18,0,0" IsIndeterminate="True"
                     Foreground="{DynamicResource PF.Brush.Primary}"
                     AutomationProperties.Name="{Binding Text, ElementName=Status}" />
    </StackPanel>
</Window>
